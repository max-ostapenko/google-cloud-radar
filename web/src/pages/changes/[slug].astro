---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReactionsBar from "../../components/ReactionsBar.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getAllFeedEntries, isIndexableChange, slugify, type FeedEntry } from "../../lib/feed";

export async function getStaticPaths() {
  const entries = await getAllFeedEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: FeedEntry;
}

const { entry } = Astro.props;

const formattedDate = new Date(entry.date + "T00:00:00Z").toLocaleDateString(
  "en-US",
  {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  },
);

// JSON-LD TechArticle schema for rich SEO
const permalinkUrl = `https://google-cloud-radar.com/changes/${entry.slug}`;
const ogImageUrl = `https://google-cloud-radar.com/changes/${entry.slug}/og.png`;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.title,
  description: entry.summary,
  datePublished: `${entry.date}T00:00:00Z`,
  dateModified: `${entry.date}T00:00:00Z`,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": permalinkUrl,
  },
  url: permalinkUrl,
  image: ogImageUrl,
  author: {
    "@type": "Organization",
    name: "Google Cloud Radar",
    url: "https://github.com/max-ostapenko/google-cloud-radar",
  },
  publisher: {
    "@type": "Organization",
    name: "Google Cloud Radar",
    url: "https://google-cloud-radar.com",
    logo: {
      "@type": "ImageObject",
      url: "https://google-cloud-radar.com/favicon.svg",
    },
  },
  keywords: [
    entry.service,
    entry.api,
    ...(entry.tags || []),
    entry.breaking ? "Breaking Change" : "",
  ]
    .filter(Boolean)
    .join(", "),
  articleSection: entry.category,
};

const serviceSlug = slugify(entry.service);

const serviceParts = [
  entry.ecosystem,
  entry.category && entry.category !== entry.ecosystem ? entry.category : null,
  entry.service,
].filter(Boolean);

const breadcrumbItems = [
  { label: "Radar Feed", href: "/" },
  { label: serviceParts.join(" / "), href: `/services/${serviceSlug}` },
  { label: entry.api, isCode: true },
];

const hasBadges = Boolean(
  entry.status === "released" ||
  entry.breaking ||
  entry.impact === "high" ||
  entry.impact === "medium"
);

const hasSiblings = Boolean(entry.siblingVersions && entry.siblingVersions.length > 1);
const orderedSiblings = hasSiblings
  ? [
      ...entry.siblingVersions!.filter((s) => s.slug === entry.slug),
      ...entry.siblingVersions!.filter((s) => s.slug !== entry.slug),
    ]
  : [];

const siblingMethodSets = orderedSiblings.map((s) => new Set(s.extractedMethods));
const sharedMethods = hasSiblings
  ? (orderedSiblings[0]?.extractedMethods || []).filter((method) =>
      siblingMethodSets.every((set) => set.has(method))
    )
  : [];
const sharedMethodSet = new Set(sharedMethods);

const versionMethodGroups = orderedSiblings.map((sib) => ({
  sib,
  uniqueMethods: sib.extractedMethods.filter((method) => !sharedMethodSet.has(method)),
}));
const sharedVersionNames = orderedSiblings.map((s) => s.version).join(', ');
const hasAnySiblingMethods =
  versionMethodGroups.some((g) => g.uniqueMethods.length > 0) || sharedMethods.length > 0;
const totalUniqueMethods = hasSiblings
  ? new Set(orderedSiblings.flatMap((s) => s.extractedMethods)).size
  : entry.extractedMethods?.length || 0;

const shouldIndex = isIndexableChange(entry);
const canonicalOverride = entry.primarySiblingSlug
  ? `https://google-cloud-radar.com/changes/${entry.primarySiblingSlug}`
  : undefined;
---

<BaseLayout
  title={`${entry.title} — Google Cloud Radar`}
  description={entry.summary}
  activeServiceSlug={serviceSlug}
  activeCategory={entry.category}
  ogImage={`/changes/${entry.slug}/og.png`}
  ogType="article"
  schemaData={schemaData}
  noindex={!shouldIndex}
  robots={!shouldIndex ? "noindex, follow" : undefined}
  canonicalUrl={canonicalOverride}
>
  <div class="change-detail-container">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Change Hero Banner (matching Service Page Hero quality) -->
    <header class="change-hero">
      <div class="change-hero-top">
        <div class="change-meta-row">
          <div class="meta-item">
            <svg
              class="meta-icon"
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <time datetime={entry.date} class="meta-value">{formattedDate}</time>
          </div>

          <span class="meta-dot">•</span>

          <div class="meta-item">
            <span class="meta-label">Discovery API:</span>
            {
              entry.discoveryRestUrl ? (
                <a
                  href={entry.discoveryRestUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="meta-api-link"
                  title="View Raw Google Discovery JSON"
                >
                  <code>{entry.api}</code>
                  <span class="api-ext">↗</span>
                </a>
              ) : (
                <code class="meta-code">{entry.api}</code>
              )
            }
          </div>

          {
            entry.status === "released" && entry.lead_time_days != null && (
              <>
                <span class="meta-dot">•</span>
                <div class="meta-item lead-time-highlight">
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                  <span>
                    Caught <strong>{entry.lead_time_days} days</strong> ahead of
                    release
                  </span>
                </div>
              </>
            )
          }
        </div>

        <div class="change-hero-actions">
          {
            hasBadges && (
              <div class="change-badge-group">
                {entry.status === "released" && (
                  <span
                    class="badge badge-released"
                    title={`Confirmed in official release notes${entry.lead_time_days ? ` (Caught ${entry.lead_time_days} days earlier in Canary)` : ""}`}
                  >
                    <span class="status-dot-green" /> Released{" "}
                    {entry.lead_time_days ? `(${entry.lead_time_days}d lead)` : ""}
                  </span>
                )}

                {entry.breaking ? (
                  <span class="badge badge-breaking" title="Breaking API change">
                    <svg
                      viewBox="0 0 24 24"
                      width="12"
                      height="12"
                      fill="currentColor"
                    >
                      <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                    </svg>
                    Breaking Change
                  </span>
                ) : entry.impact === "high" ? (
                  <span class="badge badge-impact-high">High Impact</span>
                ) : entry.impact === "medium" ? (
                  <span class="badge badge-impact-medium">Medium Impact</span>
                ) : null}
              </div>
            )
          }

          {
            entry.documentationLink && (
              <a
                href={entry.documentationLink}
                class="hero-action-btn doc-btn"
                target="_blank"
                rel="noopener noreferrer"
                title={`Official documentation for ${entry.service}`}
              >
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
                <span>Docs</span>
              </a>
            )
          }
        </div>
      </div>

      <h1 class="change-title">{entry.title}</h1>

      {
        entry.siblingVersions && entry.siblingVersions.length > 1 && (
          <nav class="sibling-versions-bar" aria-label="Same-day API versions">
            <span class="sibling-versions-label">API Versions ({formattedDate}):</span>
            <div class="sibling-versions-list">
              {entry.siblingVersions.map((sib) => {
                const isActive = sib.slug === entry.slug;
                return (
                  <a
                    href={`/changes/${sib.slug}`}
                    class={`sibling-version-pill ${isActive ? 'is-active' : ''} ${sib.breaking ? 'is-breaking' : ''}`}
                    aria-current={isActive ? 'page' : undefined}
                    title={`View ${sib.api} impact: ${sib.title}`}
                  >
                    <code>{sib.version}</code>
                    {sib.breaking && <span class="sibling-breaking-mark" title="Breaking change in this version">⚠️</span>}
                  </a>
                );
              })}
            </div>
          </nav>
        )
      }

      {
        hasSiblings ? (
          hasAnySiblingMethods && (
            <div class="methods-strip">
              <div class="methods-strip-header">
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                >
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
                <span class="methods-strip-title">
                  Modified API Methods Across Versions ({totalUniqueMethods} unique):
                </span>
              </div>

              <div class="methods-version-groups">
                {versionMethodGroups.map(({ sib, uniqueMethods }) => (
                  <div class="methods-version-block">
                    <div class="methods-version-header">
                      <span class="methods-version-label">
                        Specific to <code>{sib.api}</code> ({uniqueMethods.length})
                      </span>
                      {sib.breaking && (
                        <span class="methods-version-flag is-breaking">⚠️ Breaking</span>
                      )}
                      {sib.slug !== entry.slug && (
                        <a href={`/changes/${sib.slug}`} class="methods-version-link">
                          View {sib.version} →
                        </a>
                      )}
                    </div>
                    {uniqueMethods.length > 0 ? (
                      <div class="methods-strip-list">
                        {uniqueMethods.map((method) => (
                          <button
                            class="method-chip copy-method-btn"
                            data-copy={method}
                            aria-label="Copy method identifier"
                            title="Click to copy method"
                            type="button"
                          >
                            <span class="method-rpc-tag">RPC</span>
                            <code class="method-name">{method}</code>
                          </button>
                        ))}
                      </div>
                    ) : (
                      <p class="methods-none-note">
                        No {sib.version}-exclusive methods — all {sib.extractedMethods.length} modified methods are shared across versions below.
                      </p>
                    )}
                  </div>
                ))}

                {sharedMethods.length > 0 && (
                  <div class="methods-version-block is-shared">
                    <div class="methods-version-header">
                      <span class="methods-version-label">
                        Shared across {sharedVersionNames} ({sharedMethods.length} methods)
                      </span>
                    </div>
                    <div class="methods-strip-list">
                      {sharedMethods.slice(0, 12).map((method) => (
                        <button
                          class="method-chip copy-method-btn"
                          data-copy={method}
                          aria-label="Copy method identifier"
                          title="Click to copy method"
                          type="button"
                        >
                          <span class="method-rpc-tag">RPC</span>
                          <code class="method-name">{method}</code>
                        </button>
                      ))}
                    </div>
                    {sharedMethods.length > 12 && (
                      <details class="shared-methods-details">
                        <summary>
                          Show all {sharedMethods.length} shared methods (+{sharedMethods.length - 12} more)
                        </summary>
                        <div class="methods-strip-list shared-methods-overflow">
                          {sharedMethods.slice(12).map((method) => (
                            <button
                              class="method-chip copy-method-btn"
                              data-copy={method}
                              aria-label="Copy method identifier"
                              title="Click to copy method"
                              type="button"
                            >
                              <span class="method-rpc-tag">RPC</span>
                              <code class="method-name">{method}</code>
                            </button>
                          ))}
                        </div>
                      </details>
                    )}
                  </div>
                )}
              </div>
            </div>
          )
        ) : (
          entry.extractedMethods && entry.extractedMethods.length > 0 && (
            <div class="methods-strip">
              <div class="methods-strip-header">
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                >
                  <polyline points="16 18 22 12 16 6" />
                  <polyline points="8 6 2 12 8 18" />
                </svg>
                <span class="methods-strip-title">
                  Modified API Methods ({entry.extractedMethods.length}):
                </span>
              </div>
              <div class="methods-strip-list">
                {entry.extractedMethods.map((method) => (
                  <button
                    class="method-chip copy-method-btn"
                    data-copy={method}
                    aria-label="Copy method identifier"
                    title="Click to copy method"
                    type="button"
                  >
                    <span class="method-rpc-tag">RPC</span>
                    <code class="method-name">{method}</code>
                  </button>
                ))}
              </div>
            </div>
          )
        )
      }
    </header>

    <!-- Main Content Card -->
    <article class="content-card">
      {
        hasSiblings ? (
          <div class="multi-version-sections">
            {orderedSiblings.map((sib) => (
              <section
                class={`version-detail-section ${sib.slug === entry.slug ? "is-current" : ""}`}
                id={`version-${sib.version}`}
              >
                <header class="version-section-header">
                  <div class="version-section-meta">
                    <code class="version-section-api">{sib.api}</code>
                    {sib.slug === entry.slug ? (
                      <span class="version-current-pill">Current view</span>
                    ) : (
                      <a href={`/changes/${sib.slug}`} class="version-switch-pill">
                        View standalone {sib.version} page →
                      </a>
                    )}
                    {sib.breaking ? (
                      <span class="version-risk-badge is-breaking">⚠️ Breaking</span>
                    ) : sib.impact !== "low" ? (
                      <span class={`version-risk-badge is-${sib.impact}`}>
                        {sib.impact} impact
                      </span>
                    ) : (
                      <span class="version-risk-badge is-low">Non-breaking</span>
                    )}
                    {sib.discoveryRestUrl && (
                      <a
                        href={sib.discoveryRestUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="version-disco-link"
                      >
                        Discovery JSON ↗
                      </a>
                    )}
                  </div>
                  <h2 class="version-section-title">{sib.title}</h2>
                </header>
                <div class="markdown-body" set:html={sib.detailsHtml} />
              </section>
            ))}
          </div>
        ) : (
          <div class="markdown-body" set:html={entry.htmlContent} />
        )
      }

      <footer class="content-footer">
        <div class="footer-left">
          <ReactionsBar
            slug={entry.slug}
            helpfulCount={entry.reaction_counts?.like_change ?? 0}
            notHelpfulCount={entry.reaction_counts?.false_positive_or_duplicate ?? 0}
          />
          {
            entry.tags && entry.tags.length > 0 && (
              <div class="tags-section">
                {entry.tags.map((tag) => <span class="tag-chip">#{tag}</span>)}
              </div>
            )
          }
        </div>

        <div class="footer-right">
          <button
            type="button"
            class="card-share-trigger-btn"
            data-share-slug={entry.slug}
            data-share-title={entry.title}
            data-share-service={entry.service}
            data-share-api={entry.api}
            data-share-summary={entry.summary}
            data-share-methods={JSON.stringify(entry.extractedMethods || [])}
            data-share-breaking={entry.breaking ? "true" : "false"}
            title="Share"
            aria-label="Share API Update"
          >
            <svg
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span>Share</span>
          </button>
        </div>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .change-detail-container {
    width: 100%;
  }

  /* ==========================================================================
     Change Hero Banner (Aligned with Service Hero quality)
     ========================================================================== */
  .change-hero {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .change-hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .change-badge-group {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .change-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 0;
    letter-spacing: -0.3px;
  }

  .change-hero-actions {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .change-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .hero-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    height: 28px;
    box-sizing: border-box;
    font-family: inherit;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0 10px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .hero-action-btn:hover {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue);
    color: var(--google-blue);
    text-decoration: none;
  }

  .doc-btn {
    color: var(--google-blue);
    border-color: var(--google-blue-border);
    background-color: var(--google-blue-subtle);
  }

  .doc-btn:hover {
    background-color: #d2e3fc;
    border-color: var(--google-blue);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .meta-icon {
    color: var(--text-tertiary);
  }

  .meta-label {
    color: var(--text-tertiary);
  }

  .meta-value {
    font-weight: 500;
    color: var(--text-primary);
  }

  .meta-code {
    font-family: var(--font-mono);
    background-color: var(--bg-surface-hover);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .meta-api-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .meta-api-link code {
    font-family: var(--font-mono);
    background-color: var(--bg-surface-hover);
    color: var(--google-blue);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    font-size: 12px;
    transition: all 0.15s ease;
  }

  .meta-api-link:hover code {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue-border);
  }

  .api-ext {
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .meta-dot {
    color: var(--border-strong);
    user-select: none;
  }

  .lead-time-highlight {
    color: var(--google-yellow);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .lead-time-highlight strong {
    color: var(--google-yellow);
  }

  /* Same-Day API Version Switcher inside Hero */
  .sibling-versions-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 14px;
    margin-bottom: 4px;
  }

  .sibling-versions-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    color: var(--text-tertiary);
  }

  .sibling-versions-list {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .sibling-version-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 9px;
    border-radius: 999px;
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface-hover);
    color: var(--text-secondary);
    font-size: 12px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .sibling-version-pill code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
  }

  .sibling-version-pill:hover {
    border-color: var(--google-blue-border);
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    text-decoration: none;
  }

  .sibling-version-pill.is-active {
    background-color: var(--google-blue);
    border-color: var(--google-blue);
    color: #ffffff;
  }

  .sibling-version-pill.is-breaking:not(.is-active) {
    border-color: var(--google-red-border);
    background-color: var(--google-red-subtle);
    color: var(--google-red);
  }

  .sibling-breaking-mark {
    font-size: 11px;
    line-height: 1;
  }

  /* Methods Strip inside Hero */
  .methods-strip {
    margin-top: 20px;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }

  .methods-strip-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    color: var(--text-tertiary);
  }

  .methods-strip-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .methods-strip-list {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .methods-version-groups {
