---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReactionsBar from '../../components/ReactionsBar.astro';
import DiscussionsSection from '../../components/DiscussionsSection.astro';
import ShareScoopModal from '../../components/ShareScoopModal.astro';
import { getAllFeedEntries, type FeedEntry } from '../../lib/feed';

export async function getStaticPaths() {
  const entries = await getAllFeedEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: FeedEntry;
}

const { entry } = Astro.props;

const formattedDate = new Date(entry.date + 'T00:00:00Z').toLocaleDateString('en-US', {
  weekday: 'long',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});

// JSON-LD TechArticle schema for rich SEO
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: entry.title,
  description: entry.summary,
  datePublished: entry.date,
  author: {
    '@type': 'Organization',
    name: 'Google Cloud Radar',
    url: 'https://github.com/max-ostapenko/discovery-artifact-manager',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Google Cloud Radar',
    url: 'https://gcp-cloud-radar.web.app',
  },
  keywords: [entry.service, entry.api, ...(entry.tags || []), entry.breaking ? 'Breaking Change' : ''].filter(Boolean).join(', '),
  articleSection: entry.category,
};

const serviceSlug = entry.service.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<BaseLayout
  title={`${entry.title} — Google Cloud Radar`}
  description={entry.summary}
  activeServiceSlug={serviceSlug}
  activeCategory={entry.category}
  ogImage={`/changes/${entry.slug}/og.png`}
  ogType="article"
  schemaData={schemaData}
>
  <div class="change-detail-container">
    <!-- APIs Explorer Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Radar</a></li>
        <li class="separator">/</li>
        <li><a href={`/services/${serviceSlug}`}>{entry.service}</a></li>
        <li class="separator">/</li>
        <li class="current"><code>{entry.api}</code></li>
      </ol>
    </nav>

    <!-- Main Detail Header -->
    <header class="detail-header">
      <div class="header-badges">
        <a href={`/services/${serviceSlug}`} class="badge badge-service">
          {entry.service}
        </a>

        {entry.breaking && (
          <span class="badge badge-breaking">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
            </svg>
            ⚠️ Breaking Change
          </span>
        )}

        <span class={`badge badge-impact-${entry.impact}`}>
          Impact: {entry.impact.toUpperCase()}
        </span>

        <span class="badge badge-score">
          Analysis Score: {entry.interesting_score}/10
        </span>
      </div>

      <h1 class="detail-title">{entry.title}</h1>

      <div class="meta-row">
        <div class="meta-item">
          <span class="meta-label">Detection Date:</span>
          <time datetime={entry.date} class="meta-value">{formattedDate}</time>
        </div>
        <div class="meta-separator">•</div>
        <div class="meta-item">
          <span class="meta-label">Discovery API:</span>
          <code class="meta-code">{entry.api}</code>
        </div>
        <div class="meta-separator">•</div>
        <div class="meta-item">
          <span class="meta-label">Category:</span>
          <span class="meta-value">{entry.category}</span>
        </div>
      </div>
    </header>

    <!-- APIs Explorer Action Box -->
    <div class="apis-explorer-box">
      <div class="box-header">
        <div class="box-title">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#4285F4" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8" fill="#4285F4"/>
          </svg>
          <span>Discovery Control Plane Metadata</span>
        </div>
        <div class="box-actions">
          <ShareScoopModal
            slug={entry.slug}
            title={entry.title}
            service={entry.service}
            api={entry.api}
            summary={entry.summary}
            methods={entry.extractedMethods}
            isBreaking={entry.breaking}
            leadTimeDays={entry.lead_time_days}
          />
          {entry.discoveryRestUrl && (
            <a 
              href={entry.discoveryRestUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="action-btn"
              title={`View official Discovery REST specification for ${entry.api}`}
            >
              <span>Raw Discovery JSON</span>
              <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          )}
          {entry.documentationLink && (
            <a 
              href={entry.documentationLink} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="action-btn"
              title={`Official documentation for ${entry.service}`}
            >
              <span>Official Docs</span>
              <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      {entry.extractedMethods && entry.extractedMethods.length > 0 && (
        <div class="methods-panel">
          <div class="methods-title">Targeted Endpoints / Methods:</div>
          <div class="methods-grid">
            {entry.extractedMethods.map((method) => (
              <div class="method-row">
                <span class="method-tag">RPC</span>
                <code class="method-identifier">{method}</code>
                <button class="copy-method-btn" data-copy={method} aria-label="Copy method identifier" title="Copy method">
                  <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                  </svg>
                </button>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Community Reactions Bar -->
    <ReactionsBar slug={entry.slug} title={entry.title} />

    <!-- Rendered Markdown Content -->
    <article class="markdown-body" set:html={entry.htmlContent}></article>

    <!-- Bottom Tags & Share Section -->
    <div class="detail-footer">
      <div class="tags-section">
        <span class="tags-label">Tags:</span>
        <div class="tags-pills">
          {entry.tags.map((tag) => (
            <span class="tag-badge">#{tag}</span>
          ))}
        </div>
      </div>

      <div class="share-actions">
        <a href="/" class="back-link">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>Back to Feed</span>
        </a>
      </div>
    </div>

    <!-- Developer Discussion & Comments -->
    <DiscussionsSection slug={entry.slug} />
  </div>
</BaseLayout>

<style>
  .change-detail-container {
    max-width: 920px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    margin-bottom: 20px;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: var(--text-tertiary);
  }

  .breadcrumb-list a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .breadcrumb-list a:hover {
    color: var(--google-blue);
    text-decoration: underline;
  }

  .breadcrumb-list .separator {
    color: var(--border-strong);
  }

  .breadcrumb-list .current code {
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 12px;
  }

  .detail-header {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .header-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .detail-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.3px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .meta-label {
    color: var(--text-tertiary);
  }

  .meta-value {
    font-weight: 500;
    color: var(--text-primary);
  }

  .meta-code {
    font-family: var(--font-mono);
    background-color: var(--bg-surface-hover);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .meta-separator {
    color: var(--border-strong);
  }

  /* APIs Explorer Box */
  .apis-explorer-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-sm);
  }

  .box-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 14px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .box-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    color: var(--google-blue);
    text-decoration: none;
  }

  .action-btn:hover {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue-border);
    text-decoration: none;
  }

  .methods-panel {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .methods-title {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .methods-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .method-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 6px 12px;
    gap: 10px;
  }

  .method-tag {
    font-size: 10px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-purple);
    background-color: var(--google-purple-subtle);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .method-identifier {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-primary);
    flex: 1;
    word-break: break-all;
  }

  .copy-method-btn {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    border-radius: 4px;
  }

  .copy-method-btn:hover {
    color: var(--google-blue);
    background-color: var(--bg-surface);
  }

  /* Rendered Markdown Styling */
  .markdown-body {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 36px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-sm);
    color: var(--text-primary);
    line-height: 1.7;
    font-size: 15px;
  }

  .markdown-body :global(h1) {
    display: none; /* Already in header */
  }

  .markdown-body :global(h2) {
    font-size: 18px;
    font-weight: 700;
    margin-top: 28px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .markdown-body :global(h2:first-of-type) {
    margin-top: 0;
  }

  .markdown-body :global(h3) {
    font-size: 16px;
    font-weight: 600;
    margin-top: 20px;
    margin-bottom: 8px;
  }

  .markdown-body :global(p) {
    margin-bottom: 16px;
    color: var(--text-secondary);
  }

  .markdown-body :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .markdown-body :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    background-color: var(--bg-surface-hover);
    color: var(--google-blue);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .markdown-body :global(pre) {
    background-color: #1a1b1e;
    color: #e8eaed;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 16px 0;
    border: 1px solid #3c4043;
  }

  .markdown-body :global(pre code) {
    background-color: transparent;
    color: inherit;
    padding: 0;
    border: none;
  }

  .markdown-body :global(ul), .markdown-body :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
    color: var(--text-secondary);
  }

  .markdown-body :global(li) {
    margin-bottom: 6px;
  }

  .detail-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0;
    flex-wrap: wrap;
    gap: 16px;
  }

  .tags-section {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tags-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-tertiary);
  }

  .tags-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag-badge {
    font-size: 12px;
    background-color: var(--bg-surface-hover);
    color: var(--text-secondary);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--google-blue);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    background-color: var(--google-blue-subtle);
  }

  .back-link:hover {
    background-color: var(--google-blue);
    color: #ffffff;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .detail-header {
      padding: 20px;
    }
    .markdown-body {
      padding: 20px;
    }
  }
</style>
