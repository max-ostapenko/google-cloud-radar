---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReactionsBar from "../../components/ReactionsBar.astro";
import DiscussionsSection from "../../components/DiscussionsSection.astro";
import { getAllFeedEntries, type FeedEntry } from "../../lib/feed";

export async function getStaticPaths() {
  const entries = await getAllFeedEntries();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: FeedEntry;
}

const { entry } = Astro.props;

const formattedDate = new Date(entry.date + "T00:00:00Z").toLocaleDateString(
  "en-US",
  {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  },
);

// JSON-LD TechArticle schema for rich SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: entry.title,
  description: entry.summary,
  datePublished: entry.date,
  author: {
    "@type": "Organization",
    name: "Google Cloud Radar",
    url: "https://github.com/max-ostapenko/google-cloud-radar",
  },
  publisher: {
    "@type": "Organization",
    name: "Google Cloud Radar",
    url: "https://google-cloud-radar.com",
  },
  keywords: [
    entry.service,
    entry.api,
    ...(entry.tags || []),
    entry.breaking ? "Breaking Change" : "",
  ]
    .filter(Boolean)
    .join(", "),
  articleSection: entry.category,
};

const serviceSlug = entry.service.toLowerCase().replace(/[^a-z0-9]+/g, "-");
---

<BaseLayout
  title={`${entry.title} — Google Cloud Radar`}
  description={entry.summary}
  activeServiceSlug={serviceSlug}
  activeCategory={entry.category}
  ogImage={`/changes/${entry.slug}/og.png`}
  ogType="article"
  schemaData={schemaData}
>
  <div class="change-detail-container">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Radar Feed</a></li>
        <li class="separator">/</li>
        <li><a href={`/services/${serviceSlug}`}>{entry.service}</a></li>
        <li class="separator">/</li>
        <li class="current"><code>{entry.api}</code></li>
      </ol>
    </nav>

    <!-- Change Hero Banner (matching Service Page Hero quality) -->
    <header class="change-hero">
      <div class="change-hero-top">
        <div class="change-badge-group">
          <span class="category-badge">{entry.category}</span>
          <a
            href={`/services/${serviceSlug}`}
            class="service-pill"
            title={`View all ${entry.service} updates`}
          >
            <span class="service-icon-dot"></span>
            <span class="service-name">{entry.service}</span>
          </a>

          {
            entry.status === "released" && (
              <span
                class="badge badge-released"
                title={`Confirmed in official release notes${entry.lead_time_days ? ` (Caught ${entry.lead_time_days} days earlier in Canary)` : ""}`}
              >
                <span class="status-dot-green" /> Released{" "}
                {entry.lead_time_days ? `(${entry.lead_time_days}d lead)` : ""}
              </span>
            )
          }

          {
            entry.breaking ? (
              <span class="badge badge-breaking" title="Breaking API change">
                <svg
                  viewBox="0 0 24 24"
                  width="12"
                  height="12"
                  fill="currentColor"
                >
                  <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" />
                </svg>
                Breaking Change
              </span>
            ) : entry.impact === "high" ? (
              <span class="badge badge-impact-high">High Impact</span>
            ) : entry.impact === "medium" ? (
              <span class="badge badge-impact-medium">Medium Impact</span>
            ) : null
          }
        </div>

        <div class="change-hero-actions">
          <button
            type="button"
            class="card-share-trigger-btn hero-action-btn share-btn"
            data-share-slug={entry.slug}
            data-share-title={entry.title}
            data-share-service={entry.service}
            data-share-api={entry.api}
            data-share-summary={entry.summary}
            data-share-methods={JSON.stringify(entry.extractedMethods || [])}
            data-share-breaking={entry.breaking ? "true" : "false"}
            title="Share this API update on Twitter/X, LinkedIn, Slack, or Reddit"
            aria-label="Share API Update"
          >
            <svg
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
            <span>Share</span>
          </button>

          {
            entry.documentationLink && (
              <a
                href={entry.documentationLink}
                class="hero-action-btn doc-btn"
                target="_blank"
                rel="noopener noreferrer"
                title={`Official documentation for ${entry.service}`}
              >
                <svg
                  viewBox="0 0 24 24"
                  width="13"
                  height="13"
                  stroke="currentColor"
                  stroke-width="2"
                  fill="none"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
                <span>Docs</span>
              </a>
            )
          }

          <a
            href={`/services/${serviceSlug}`}
            class="hero-action-btn service-btn"
            title={`View all ${entry.service} updates`}
          >
            <span>{entry.service} feed →</span>
          </a>
        </div>
      </div>

      <h1 class="change-title">{entry.title}</h1>

      <div class="change-meta-row">
        <div class="meta-item">
          <svg
            class="meta-icon"
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <time datetime={entry.date} class="meta-value">{formattedDate}</time>
        </div>

        <span class="meta-dot">•</span>

        <div class="meta-item">
          <span class="meta-label">Discovery API:</span>
          {
            entry.discoveryRestUrl ? (
              <a
                href={entry.discoveryRestUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="meta-api-link"
                title="View Raw Google Discovery JSON"
              >
                <code>{entry.api}</code>
                <span class="api-ext">↗</span>
              </a>
            ) : (
              <code class="meta-code">{entry.api}</code>
            )
          }
        </div>

        {
          entry.status === "released" && entry.lead_time_days != null && (
            <>
              <span class="meta-dot">•</span>
              <div class="meta-item lead-time-highlight">
                <svg
                  viewBox="0 0 24 24"
                  width="14"
                  height="14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
                <span>
                  Caught <strong>{entry.lead_time_days} days</strong> ahead of
                  release
                </span>
              </div>
            </>
          )
        }
      </div>

      {
        entry.extractedMethods && entry.extractedMethods.length > 0 && (
          <div class="methods-strip">
            <div class="methods-strip-header">
              <svg
                viewBox="0 0 24 24"
                width="13"
                height="13"
                stroke="currentColor"
                stroke-width="2"
                fill="none"
              >
                <polyline points="16 18 22 12 16 6" />
                <polyline points="8 6 2 12 8 18" />
              </svg>
              <span class="methods-strip-title">
                Modified API Methods ({entry.extractedMethods.length}):
              </span>
            </div>
            <div class="methods-strip-list">
              {entry.extractedMethods.map((method) => (
                <div class="method-chip">
                  <span class="method-rpc-tag">RPC</span>
                  <code class="method-name">{method}</code>
                  <button
                    class="copy-method-btn"
                    data-copy={method}
                    aria-label="Copy method identifier"
                    title="Copy method"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      width="12"
                      height="12"
                      stroke="currentColor"
                      stroke-width="2"
                      fill="none"
                    >
                      <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                  </button>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </header>

    <!-- Main Content Card -->
    <article class="content-card">
      <div class="markdown-body" set:html={entry.htmlContent} />

      <footer class="content-footer">
        <div class="tags-section">
          {
            entry.tags &&
              entry.tags.map((tag) => <span class="tag-chip">#{tag}</span>)
          }
        </div>

        <div class="footer-actions">
          <a href="#comments" class="jump-comments-btn">
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
              ></path>
            </svg>
            <span>Jump to Comments</span>
          </a>
        </div>
      </footer>
    </article>

    <!-- Community Signals & Impact Telemetry -->
    <ReactionsBar slug={entry.slug} title={entry.title} />

    <!-- Developer Discussion & Comments Section -->
    <DiscussionsSection slug={entry.slug} />
  </div>
</BaseLayout>

<style>
  .change-detail-container {
    max-width: 920px;
    margin: 0 auto;
    padding-bottom: 60px;
  }

  .breadcrumb-nav {
    margin-bottom: 16px;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 13px;
    color: var(--text-tertiary);
  }

  .breadcrumb-list a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb-list a:hover {
    color: var(--google-blue);
    text-decoration: underline;
  }

  .breadcrumb-list .separator {
    color: var(--border-strong);
  }

  .breadcrumb-list .current code {
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 12px;
  }

  /* ==========================================================================
     Change Hero Banner (Aligned with Service Hero quality)
     ========================================================================== */
  .change-hero {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 24px;
    box-shadow: var(--shadow-sm);
  }

  .change-hero-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .change-badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .category-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    border: 1px solid var(--google-blue-border);
    padding: 3px 10px;
    border-radius: var(--radius-full);
  }

  .service-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    border: 1px solid var(--google-blue-border);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .service-pill:hover {
    background-color: #d2e3fc;
    text-decoration: none;
  }

  .service-icon-dot {
    width: 6px;
    height: 6px;
    background-color: var(--google-blue);
    border-radius: 50%;
  }

  .change-hero-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hero-action-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .hero-action-btn:hover {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue);
    color: var(--google-blue);
    text-decoration: none;
  }

  .doc-btn {
    color: var(--google-blue);
    border-color: var(--google-blue-border);
    background-color: var(--google-blue-subtle);
  }

  .doc-btn:hover {
    background-color: #d2e3fc;
    border-color: var(--google-blue);
  }

  .change-title {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
    margin-bottom: 16px;
    letter-spacing: -0.3px;
  }

  .change-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .meta-icon {
    color: var(--text-tertiary);
  }

  .meta-label {
    color: var(--text-tertiary);
  }

  .meta-value {
    font-weight: 500;
    color: var(--text-primary);
  }

  .meta-code {
    font-family: var(--font-mono);
    background-color: var(--bg-surface-hover);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .meta-api-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }

  .meta-api-link code {
    font-family: var(--font-mono);
    background-color: var(--bg-surface-hover);
    color: var(--google-blue);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    font-size: 12px;
    transition: all 0.15s ease;
  }

  .meta-api-link:hover code {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue-border);
  }

  .api-ext {
    font-size: 10px;
    color: var(--text-tertiary);
  }

  .meta-dot {
    color: var(--border-strong);
    user-select: none;
  }

  .lead-time-highlight {
    color: var(--google-yellow);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .lead-time-highlight strong {
    color: var(--google-yellow);
  }

  /* Methods Strip inside Hero */
  .methods-strip {
    margin-top: 20px;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }

  .methods-strip-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
    color: var(--text-tertiary);
  }

  .methods-strip-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .methods-strip-list {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .method-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 12px;
  }

  .method-rpc-tag {
    font-size: 9px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-purple);
    background-color: var(--google-purple-subtle);
    padding: 1px 4px;
    border-radius: 2px;
  }

  .method-name {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .copy-method-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-tertiary);
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
  }

  .copy-method-btn:hover {
    color: var(--google-blue);
    background-color: var(--bg-surface-hover);
  }

  /* ==========================================================================
     Main Content Card
     ========================================================================== */
  .content-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .markdown-body {
    padding: 32px;
    color: var(--text-primary);
    line-height: 1.7;
    font-size: 15px;
  }

  .markdown-body :global(h1) {
    display: none;
  }

  .markdown-body :global(h2) {
    font-size: 18px;
    font-weight: 700;
    margin-top: 28px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .markdown-body :global(h2:first-of-type) {
    margin-top: 0;
  }

  .markdown-body :global(h3) {
    font-size: 16px;
    font-weight: 600;
    margin-top: 20px;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .markdown-body :global(p) {
    margin-bottom: 16px;
    color: var(--text-secondary);
  }

  .markdown-body :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .markdown-body :global(code) {
    font-family: var(--font-mono);
    font-size: 13px;
    background-color: var(--bg-surface-hover);
    color: var(--google-blue);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .markdown-body :global(pre) {
    background-color: #1a1b1e;
    color: #e8eaed;
    padding: 16px 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 18px 0;
    border: 1px solid #3c4043;
    font-size: 13px;
    line-height: 1.5;
  }

  .markdown-body :global(pre code) {
    background-color: transparent;
    color: inherit;
    padding: 0;
    border: none;
  }

  .markdown-body :global(ul),
  .markdown-body :global(ol) {
    margin-bottom: 16px;
    padding-left: 24px;
    color: var(--text-secondary);
  }

  .markdown-body :global(li) {
    margin-bottom: 6px;
  }

  .content-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 32px;
    background-color: var(--bg-surface-hover);
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 16px;
  }

  .tags-section {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .tag-chip {
    font-size: 11px;
    color: var(--text-tertiary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .jump-comments-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--google-blue);
    text-decoration: none;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .jump-comments-btn:hover {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue-border);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .change-hero {
      padding: 20px;
    }
    .markdown-body {
      padding: 20px;
    }
    .content-footer {
      padding: 16px 20px;
    }
  }
</style>
