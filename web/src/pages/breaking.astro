---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangeCard from '../components/ChangeCard.astro';
import { getAllFeedEntries, groupEntriesByMonth } from '../lib/feed';

const allEntries = await getAllFeedEntries();
const breakingEntries = allEntries.filter((e) => e.breaking);
const impactedServices = Array.from(new Set(breakingEntries.map((e) => e.service)));
const monthGroups = groupEntriesByMonth(breakingEntries);
---

<BaseLayout
  title="⚠️ Breaking Changes Radar — Google Cloud APIs"
  description="Early warning feed for breaking changes across Google Cloud APIs. Enum modifications, parameter deletions, and deprecated control-plane methods."
  activeCategory="breaking"
>
  <div class="breaking-page-container">
    <!-- Breaking Hero Banner -->
    <div class="breaking-hero">
      <div class="breaking-hero-content">
        <div class="alert-badge">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
            <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
          </svg>
          <span>Breaking Change Watchdog</span>
        </div>
        <h1 class="breaking-title">Google Cloud Breaking API Changes</h1>
        <p class="breaking-subtitle">
          Critical alert feed tracking backwards-incompatible enum modifications, field removals, type shifts, and RPC signature adjustments caught during Discovery deployment cycles.
        </p>
      </div>

      <div class="breaking-summary-stats">
        <div class="breaking-stat-box">
          <span class="stat-num">{breakingEntries.length}</span>
          <span class="stat-lbl">Active Breaking Alerts</span>
        </div>
        <div class="breaking-stat-box">
          <span class="stat-num">{impactedServices.length}</span>
          <span class="stat-lbl">Services Impacted</span>
        </div>
      </div>
    </div>

    <!-- Email Alert Callout Card -->
    <div class="breaking-email-card">
      <div class="email-card-content">
        <div class="email-card-icon">⚡</div>
        <div class="email-card-text">
          <strong>Get Instant Email Alerts on Breaking Changes</strong>
          <p>Never get caught off-guard by silent schema deletions. Enable email alerts to protect your production pipelines.</p>
        </div>
      </div>
      <button class="enable-alerts-btn" id="openBreakingAlertsBtn" type="button">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <span>Enable Free Alerts</span>
      </button>
    </div>

    <!-- Month Switcher for Breaking Alerts -->
    <div class="breaking-month-nav" id="breakingMonthNav">
      <div class="month-nav-label">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Month</span>
      </div>
      <div class="month-chips-list">
        {monthGroups.map((g, idx) => (
          <a
            href={`/timeline/${g.key}/?filter=breaking`}
            class={`month-chip ${idx === 0 ? 'active' : ''}`}
            data-month={g.key}
          >
            <span>{g.monthName} '{String(g.year).slice(2)}</span>
            <span class="month-chip-count">{g.entries.length}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Timeline of Breaking Changes Grouped by Month -->
    <div class="timeline-container">
      {monthGroups.map((group, index) => (
        <section class={`month-breaking-section ${index === 0 ? 'is-latest' : ''}`} data-month={group.key}>
          <header class="month-breaking-header">
            <div class="month-header-left">
              <div class="month-calendar-badge">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <h2 class="month-title">{group.label}</h2>
              </div>
              {index === 0 && <span class="current-month-badge">Latest Wave</span>}
            </div>

            <div class="month-header-stats">
              <span class="month-breaking-count-pill">⚠️ <strong>{group.entries.length}</strong> Breaking Alerts</span>
            </div>
          </header>

          <div class="month-cards-list">
            {group.entries.map((entry) => (
              <ChangeCard entry={entry} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { onAuthChange, getUserAlertPreferences } from '../lib/firebase';

  const monthChips = document.querySelectorAll('.month-chip');
  const monthSections = document.querySelectorAll('.month-breaking-section') as NodeListOf<HTMLElement>;
  const defaultMonth = monthChips.length > 0 ? (monthChips[0].getAttribute('data-month') || '') : '';
  let activeMonth = defaultMonth;

  // Read URL search params
  const urlParams = new URLSearchParams(window.location.search);
  const initialMonth = urlParams.get('month');
  if (initialMonth && Array.from(monthChips).some((c) => c.getAttribute('data-month') === initialMonth)) {
    activeMonth = initialMonth;
    monthChips.forEach((c) => {
      if (c.getAttribute('data-month') === initialMonth) c.classList.add('active');
      else c.classList.remove('active');
    });
  }

  function updateMonthView() {
    monthSections.forEach((section) => {
      const sectionMonth = section.getAttribute('data-month') || '';
      section.style.display = sectionMonth === activeMonth ? 'flex' : 'none';
    });
    const params = new URLSearchParams();
    if (activeMonth !== defaultMonth) params.set('month', activeMonth);
    const queryString = params.toString();
    const newUrl = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
    history.replaceState(null, '', newUrl);
  }

  updateMonthView();

  monthChips.forEach((chip) => {
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      monthChips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      activeMonth = chip.getAttribute('data-month') || defaultMonth;
      updateMonthView();
    });
  });

  const breakingAlertsBtn = document.getElementById('openBreakingAlertsBtn');
  const breakingCard = document.querySelector('.breaking-email-card') as HTMLElement;
  const emailCardText = document.querySelector('.email-card-text') as HTMLElement;

  breakingAlertsBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open_alerts_modal'));
  });

  async function syncBreakingBanner(user: any) {
    if (!breakingCard) return;
    if (user) {
      const prefs = await getUserAlertPreferences(user);
      if (prefs.breakingAlerts) {
        breakingCard.classList.add('is-active-subscriber');
        if (emailCardText) {
          emailCardText.innerHTML = `<strong>✓ Breaking Change Alerts Active for ${user.email || 'your account'}</strong><p>You will be notified immediately when Google Cloud APIs detect breaking changes.</p>`;
        }
        if (breakingAlertsBtn) {
          breakingAlertsBtn.innerHTML = `<span>⚙️ Manage Preferences</span>`;
        }
      } else {
        breakingCard.classList.remove('is-active-subscriber');
        if (emailCardText) {
          emailCardText.innerHTML = `<strong>Get Instant Email Alerts on Breaking Changes</strong><p>Never get caught off-guard by silent schema deletions. Enable email alerts to protect your production pipelines.</p>`;
        }
        if (breakingAlertsBtn) {
          breakingAlertsBtn.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><span>Enable Free Alerts</span>`;
        }
      }
    } else {
      breakingCard.classList.remove('is-active-subscriber');
      if (emailCardText) {
        emailCardText.innerHTML = `<strong>Get Instant Email Alerts on Breaking Changes</strong><p>Never get caught off-guard by silent schema deletions. Enable email alerts to protect your production pipelines.</p>`;
      }
      if (breakingAlertsBtn) {
        breakingAlertsBtn.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><span>Enable Free Alerts</span>`;
      }
    }
  }

  onAuthChange(syncBreakingBanner);
  window.addEventListener('radar_alert_prefs_update', (e: any) => {
    if (breakingCard && e.detail) {
      if (e.detail.breakingAlerts) {
        breakingCard.classList.add('is-active-subscriber');
        if (emailCardText) {
          emailCardText.innerHTML = `<strong>✓ Breaking Change Alerts Active</strong><p>You will be notified immediately when Google Cloud APIs detect breaking changes.</p>`;
        }
        if (breakingAlertsBtn) {
          breakingAlertsBtn.innerHTML = `<span>⚙️ Manage Preferences</span>`;
        }
      } else {
        breakingCard.classList.remove('is-active-subscriber');
        if (emailCardText) {
          emailCardText.innerHTML = `<strong>Get Instant Email Alerts on Breaking Changes</strong><p>Never get caught off-guard by silent schema deletions. Enable email alerts to protect your production pipelines.</p>`;
        }
        if (breakingAlertsBtn) {
          breakingAlertsBtn.innerHTML = `<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><span>Enable Free Alerts</span>`;
        }
      }
    }
  });
</script>

<style>
  .breaking-page-container {
    width: 100%;
    max-width: 960px;
    min-width: 0;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .breaking-hero {
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--google-red-subtle) 100%);
    border: 1px solid var(--google-red-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    box-shadow: var(--shadow-sm);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Email Alert Callout Card */
  .breaking-email-card {
    background: linear-gradient(135deg, var(--bg-surface) 0%, rgba(26, 115, 232, 0.05) 100%);
    border: 1px solid var(--google-blue-border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .email-card-content {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 280px;
  }

  .email-card-icon {
    font-size: 24px;
    line-height: 1;
  }

  .email-card-text strong {
    font-size: 14px;
    color: var(--text-primary);
    display: block;
    margin-bottom: 2px;
  }

  .email-card-text p {
    font-size: 12.5px;
    color: var(--text-secondary);
    margin: 0;
  }

  .enable-alerts-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--google-blue);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-sm);
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
    white-space: nowrap;
  }

  .enable-alerts-btn:hover {
    background-color: #1557b0;
  }

  .breaking-email-card.is-active-subscriber {
    background: linear-gradient(135deg, var(--bg-surface) 0%, rgba(52, 168, 83, 0.06) 100%);
    border-color: rgba(52, 168, 83, 0.35);
  }

  .breaking-email-card.is-active-subscriber .enable-alerts-btn {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .breaking-email-card.is-active-subscriber .enable-alerts-btn:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-strong);
    color: var(--google-blue);
  }

  .breaking-hero-content {
    max-width: 600px;
  }

  .alert-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--google-red);
    background-color: var(--bg-surface);
    border: 1px solid var(--google-red-border);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  .breaking-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 10px;
    letter-spacing: -0.3px;
  }

  .breaking-subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .breaking-summary-stats {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .breaking-stat-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--google-red-border);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 120px;
    text-align: center;
  }

  .stat-num {
    font-size: 26px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-red);
    margin-bottom: 4px;
  }

  .stat-lbl {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-tertiary);
    letter-spacing: 0.5px;
  }

  /* Month Navigation Bar for Breaking Alerts */
  .breaking-month-nav {
    display: flex;
    align-items: center;
    gap: 12px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 14px;
    margin-bottom: 24px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .month-nav-label {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-tertiary);
    flex-shrink: 0;
    padding-right: 8px;
    border-right: 1px solid var(--border-subtle);
  }

  .month-chips-list {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .month-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    cursor: pointer;
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .month-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
    text-decoration: none;
  }

  .month-chip.active {
    background-color: var(--google-red-subtle);
    border-color: var(--google-red-border);
    color: var(--google-red);
    font-weight: 600;
  }

  .month-chip-count {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    background-color: var(--bg-surface);
    padding: 1px 5px;
    border-radius: var(--radius-full);
  }

  .month-chip.active .month-chip-count {
    background-color: rgba(234, 67, 53, 0.15);
    color: var(--google-red);
  }

  .timeline-container {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .month-breaking-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .month-breaking-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 10px;
  }

  .month-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .month-calendar-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--google-red);
  }

  .month-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    letter-spacing: -0.2px;
  }

  .current-month-badge {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    background-color: var(--google-red-subtle);
    color: var(--google-red);
    border: 1px solid var(--google-red-border);
    padding: 2px 8px;
    border-radius: var(--radius-full);
  }

  .month-breaking-count-pill {
    font-size: 11.5px;
    color: var(--google-red);
    background-color: var(--google-red-subtle);
    border: 1px solid var(--google-red-border);
    padding: 2px 10px;
    border-radius: var(--radius-full);
  }

  .month-cards-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @media (max-width: 768px) {
    .breaking-hero {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
    .breaking-summary-stats {
      width: 100%;
      justify-content: space-between;
    }
    .breaking-stat-box {
      flex: 1;
      min-width: 0;
    }
    .month-breaking-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
