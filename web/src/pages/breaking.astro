---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangeCard from '../components/ChangeCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { deduplicateFeedSiblingVersions, getAllFeedEntries, groupEntriesByMonth } from '../lib/feed';

const allEntries = deduplicateFeedSiblingVersions(await getAllFeedEntries());
const breakingEntries = allEntries.filter((entry) => entry.breaking);
const monthGroups = groupEntriesByMonth(breakingEntries);
const totalBreakingCount = breakingEntries.length;
const affectedServicesCount = new Set(breakingEntries.map((e) => e.service)).size;

const pageTitle = 'Google Cloud Breaking Changes — Real-Time Alert Tracker';
const pageDescription = 'Index of breaking schema changes, parameter removals, and backward-incompatible Google Cloud API updates caught directly from Discovery Service diffs.';

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://google-cloud-radar.com').replace(/\/+$/, '');
const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: `${siteOrigin}/breaking`,
  isPartOf: {
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    name: 'Google Cloud Radar',
    url: siteOrigin,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: totalBreakingCount,
    itemListElement: breakingEntries.slice(0, 50).map((entry, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `${siteOrigin}/changes/${entry.slug}`,
      name: `${entry.service}: ${entry.title}`,
    })),
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schemaData={schemaData}
>
  <div class="breaking-page-container">
    <Breadcrumbs items={[
      { label: 'Radar Feed', href: '/' },
      { label: 'Breaking Changes' },
    ]} />

    <div class="breaking-hero-card">
      <div class="hero-main">
        <div class="hero-badge">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <span>Breaking Changes Feed</span>
        </div>
        <h1 class="hero-title">Google Cloud Breaking Changes</h1>
        <p class="hero-subtitle">
          Real-time intelligence on backward-incompatible API changes, removed methods or resources, and parameter type mutations across all monitored Google Cloud Platform services.
        </p>
      </div>

      <div class="hero-stats">
        <div class="stat-box breaking">
          <span class="stat-number">{totalBreakingCount}</span>
          <span class="stat-label">Breaking Alerts</span>
        </div>
        <div class="stat-box services">
          <span class="stat-number">{affectedServicesCount}</span>
          <span class="stat-label">Affected Services</span>
        </div>
      </div>
    </div>

    <div class="breaking-timeline">
      {breakingEntries.length > 0 ? (
        monthGroups.map((group) => (
          <section class="month-group-section">
            <div class="month-group-header">
              <h2>{group.label}</h2>
              <span class="month-count-badge">
                {group.totalCount} {group.totalCount === 1 ? 'breaking change' : 'breaking changes'}
              </span>
            </div>
            <div class="cards-list">
              {group.entries.map((entry) => (
                <ChangeCard entry={entry} />
              ))}
            </div>
          </section>
        ))
      ) : (
        <div class="no-changes-card">
          <div class="no-changes-icon">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <h3>No Breaking Changes Detected</h3>
          <p>
            Google Cloud Radar continuously monitors Google Discovery Services for schema mutations and breaking changes.
          </p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .breaking-page-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .breaking-hero-card {
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-surface-hover) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-sm);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  @media (max-width: 768px) {
    .breaking-hero-card {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .hero-main {
    flex: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: var(--google-red-subtle);
    color: var(--google-red-text);
    border: 1px solid var(--google-red-border);
    border-radius: var(--radius-full);
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .hero-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .hero-stats {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .stat-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 100px;
  }

  .stat-box.breaking {
    border-color: var(--google-red-border);
    background: var(--google-red-subtle);
  }

  .stat-number {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .stat-box.breaking .stat-number {
    color: var(--google-red-text);
  }

  .stat-label {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 4px;
    text-align: center;
    white-space: nowrap;
  }

  .month-group-section {
    margin-bottom: 32px;
  }

  .month-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .month-group-header h2 {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .month-count-badge {
    font-size: 13px;
    color: var(--google-red-text);
    background: var(--google-red-subtle);
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-weight: 500;
  }

  .cards-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .no-changes-card {
    background: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 48px 24px;
    text-align: center;
  }

  .no-changes-icon {
    color: var(--text-tertiary);
    margin-bottom: 16px;
  }

  .no-changes-card h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 8px 0;
  }

  .no-changes-card p {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
  }
</style>
