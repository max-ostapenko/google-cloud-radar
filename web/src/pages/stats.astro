---
import BaseLayout from "../layouts/BaseLayout.astro";
import { computeRadarStats } from "../lib/stats";

const stats = await computeRadarStats();

// Dataset & TechArticle JSON-LD for rich SEO and citations
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "Google Cloud Platform API Velocity & Canary Lead-Time Benchmark (Trailing 3 Months)",
  description:
    "Rolling 90-day empirical benchmark analyzing pre-release Canary lead times, breaking change ratios, and shipping velocity across Google Cloud APIs.",
  url: "https://google-cloud-radar.com/stats",
  creator: {
    "@type": "Organization",
    name: "Google Cloud Radar",
    url: "https://github.com/max-ostapenko/google-cloud-radar",
  },
  variableMeasured: [
    "Canary to GA Lead Time in Days",
    "GCP API Revision Frequency",
    "Breaking Change Incompatibility Ratio",
  ],
};
---

<BaseLayout
  title="Google Cloud API Velocity & Canary Lead-Time Benchmark (Last 3 Months) — Google Cloud Radar"
  description="Rolling 90-day empirical benchmark analyzing Google Cloud pre-release Canary lead times, breaking change ratios, and service velocity rankings."
  schemaData={schemaData}
  showSidebar={false}
>
  <div class="stats-page-container">
    <!-- Header Hero -->
    <header class="stats-hero">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>Trailing 90 Days · Rolling Benchmark</span>
      </div>
      <h1 class="stats-title">Google Cloud API Velocity & Canary Benchmark</h1>
      <p class="stats-subtitle">
        Empirical analysis of <strong
          >{stats.totalSignals} Google Cloud API revisions</strong
        > across <strong>{stats.totalServicesMonitored} services</strong> over the
        last 3 months. Tracking the time delta between internal API deployment and
        official public release notes.
      </p>
    </header>

    <!-- KPI Metric Cards Grid -->
    <section class="kpi-grid" aria-label="Key Performance Indicators">
      <div class="kpi-card card-blue">
        <div class="kpi-top">
          <div class="kpi-icon-wrap icon-blue">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <span class="kpi-tag">Lead Time</span>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value">{stats.overallAvgLeadTime}</span>
          <span class="kpi-unit">days</span>
        </div>
        <div class="kpi-label">Canary → GA Lead Time</div>
        <div class="kpi-subtext">
          Average advance notice before official release notes
        </div>
      </div>

      <div class="kpi-card card-purple">
        <div class="kpi-top">
          <div class="kpi-icon-wrap icon-purple">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </div>
          <span class="kpi-tag">Revisions</span>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value">{stats.totalSignals}</span>
        </div>
        <div class="kpi-label">Pre-Release Signals</div>
        <div class="kpi-subtext">Diffed from Google Discovery Service</div>
      </div>

      <div class="kpi-card card-red">
        <div class="kpi-top">
          <div class="kpi-icon-wrap icon-red">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
              ></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          </div>
          <span class="kpi-tag">Risk Factor</span>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value"
            >{stats.overallBreakingRate}<span class="kpi-pct">%</span></span
          >
        </div>
        <div class="kpi-label">Breaking Incompatibility Rate</div>
        <div class="kpi-subtext">
          {stats.totalBreaking} breaking modifications detected
        </div>
      </div>

      <div class="kpi-card card-green">
        <div class="kpi-top">
          <div class="kpi-icon-wrap icon-green">
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <span class="kpi-tag">Coverage</span>
        </div>
        <div class="kpi-value-row">
          <span class="kpi-value">{stats.totalMethodsTracked}</span>
        </div>
        <div class="kpi-label">Targeted RPC Endpoints</div>
        <div class="kpi-subtext">
          Across {stats.totalServicesMonitored} monitored Google Cloud services
        </div>
      </div>
    </section>

    <!-- Main Content: Velocity Leaderboard -->
    <section class="stats-section" aria-label="Service Velocity Leaderboard">
      <div class="section-header">
        <div class="section-title-wrap">
          <div class="section-icon-wrap">
            <svg
              viewBox="0 0 24 24"
              width="18"
              height="18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path>
              <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path>
              <path d="M4 22h16"></path>
              <path d="M10 14.66V17c0 .55-.45 1-1 1H7c-.55 0-1-.45-1-1v-2.34"
              ></path>
              <path d="M14 14.66V17c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-2.34"
              ></path>
              <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path>
            </svg>
          </div>
          <div>
            <h2 class="section-title">
              Service Velocity & Lead-Time Leaderboard
            </h2>
            <p class="section-desc">
              Ranked by overall API update activity and new method additions
              over the last 3 months.
            </p>
          </div>
        </div>
      </div>

      <div class="table-responsive">
        <table class="velocity-table">
          <thead>
            <tr>
              <th class="col-rank">Rank</th>
              <th class="col-service">GCP Service</th>
              <th class="col-category">Category</th>
              <th class="col-updates text-right">Revisions</th>
              <th class="col-methods text-right">RPCs Added</th>
              <th class="col-breaking">Breaking Rate</th>
              <th class="col-lead text-center">Avg. Lead Time</th>
            </tr>
          </thead>
          <tbody>
            {
              stats.serviceVelocities.map((svc, idx) => {
                const rankClass =
                  idx === 0
                    ? "rank-gold"
                    : idx === 1
                      ? "rank-silver"
                      : idx === 2
                        ? "rank-bronze"
                        : "rank-normal";
                return (
                  <tr
                    class="clickable-row"
                    onclick={`window.location.href='/services/${svc.slug}'`}
                  >
                    <td class="col-rank">
                      <span class={`rank-pill ${rankClass}`}>{idx + 1}</span>
                    </td>
                    <td class="col-service">
                      <a
                        href={`/services/${svc.slug}`}
                        class="service-link"
                        onclick="event.stopPropagation()"
                      >
                        <span class="service-dot" />
                        <strong class="service-name-text">{svc.service}</strong>
                      </a>
                    </td>
                    <td class="col-category">
                      <span class="category-pill">{svc.category}</span>
                    </td>
                    <td class="col-updates text-right">
                      <span class="mono-num">{svc.count}</span>
                    </td>
                    <td class="col-methods text-right">
                      <span class="mono-num">{svc.methodsCount}</span>
                    </td>
                    <td class="col-breaking">
                      <div class="rate-container">
                        <div class="rate-bar-bg">
                          <div
                            class="rate-bar-fill"
                            style={`width: ${Math.min(svc.breakingRate, 100)}%; background-color: ${svc.breakingRate > 20 ? "var(--google-red)" : "var(--google-blue)"};`}
                          />
                        </div>
                        <span
                          class={`rate-text ${svc.breakingRate > 20 ? "text-red" : ""}`}
                        >
                          {svc.breakingRate}%
                        </span>
                      </div>
                    </td>
                    <td class="col-lead text-center">
                      {
                        svc.avgLeadTime !== null ? (
                          <span class="lead-pill">~{svc.avgLeadTime}d</span>
                        ) : (
                          <span class="lead-pill pending" title="All detected updates are currently in Canary pre-release (awaiting official GA announcement)">
                            Canary
                          </span>
                        )
                      }
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
    </section>

    <!-- Secondary Grid: Lead Time & Category Distribution -->
    <div class="benchmark-grid">
      <!-- Lead Time Distribution Card -->
      <div class="benchmark-card">
        <div class="card-header-row">
          <div class="card-icon-wrap icon-blue">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <div>
            <h3 class="card-title">Canary → GA Lead Time Distribution</h3>
            <p class="card-desc">
              Advance notice window before official documentation publication
            </p>
          </div>
        </div>

        <div class="distribution-list">
          {
            stats.leadTimeBuckets.map((bucket) => (
              <div class="dist-row">
                <div class="dist-header">
                  <span class="dist-label">{bucket.label}</span>
                  <span class="dist-val">
                    <strong class="mono-num">{bucket.count}</strong> changes (
                    {bucket.percentage}%)
                  </span>
                </div>
                <div class="dist-track">
                  <div
                    class="dist-fill fill-blue"
                    style={`width: ${bucket.percentage}%;`}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Category Breakdown Card -->
      <div class="benchmark-card">
        <div class="card-header-row">
          <div class="card-icon-wrap icon-green">
            <svg
              viewBox="0 0 24 24"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
            </svg>
          </div>
          <div>
            <h3 class="card-title">Activity by Cloud Domain</h3>
            <p class="card-desc">
              Share of total API updates across Google Cloud architectural
              domains
            </p>
          </div>
        </div>

        <div class="distribution-list">
          {
            stats.categoryStats.map((cat) => (
              <div class="dist-row">
                <div class="dist-header">
                  <span class="dist-label">{cat.category}</span>
                  <span class="dist-val">
                    <strong class="mono-num">{cat.count}</strong> updates (
                    {cat.percentage}%)
                  </span>
                </div>
                <div class="dist-track">
                  <div
                    class="dist-fill fill-green"
                    style={`width: ${cat.percentage}%;`}
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Editorial Insights for Cloud Engineers -->
    <div class="insights-card">
      <div class="insights-header">
        <div class="insights-icon-wrap">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M9 18h6"></path>
            <path d="M10 22h4"></path>
            <path
              d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z"
            ></path>
          </svg>
        </div>
        <h3 class="insights-title">
          Why Discovery Lead-Time Matters for GCP Architects
        </h3>
      </div>

      <div class="insights-grid">
        <div class="insight-item">
          <div class="insight-number">01</div>
          <div class="insight-content">
            <strong class="insight-heading"
              >Zero-Day Breaking Change Protection</strong
            >
            <p>
              Approximately <strong>{stats.overallBreakingRate}%</strong> of API modifications
              introduce removed parameters or type redefinitions. Tracking changes
              at the Discovery layer gives engineering teams up to <strong
                >{stats.overallAvgLeadTime} days</strong
              > of advance warning to adjust client SDKs and infrastructure pipelines
              before production disruptions.
            </p>
          </div>
        </div>

        <div class="insight-item">
          <div class="insight-number">02</div>
          <div class="insight-content">
            <strong class="insight-heading"
              >Early Architecture Prototyping</strong
            >
            <p>
              New RPC endpoints (e.g. session compaction in Vertex AI or
              table-valued arguments in BigQuery) appear in Google Discovery
              APIs weeks before general availability, enabling teams to
              benchmark and design future workflows ahead of official GA
              releases.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .stats-page-container {
    width: 100%;
    max-width: 1140px;
    min-width: 0;
    margin: 0 auto;
    padding-bottom: 60px;
    box-sizing: border-box;
  }

  /* ==========================================================================
     Hero Header
     ========================================================================== */
  .stats-hero {
    text-align: center;
    padding: 32px 16px 36px;
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    border: 1px solid var(--google-blue-border);
    padding: 4px 14px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 16px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--google-blue);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.3);
    }
  }

  .stats-title {
    font-size: clamp(22px, 4.5vw, 34px);
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.5px;
    line-height: 1.25;
    margin-bottom: 14px;
    word-break: break-word;
  }

  .stats-subtitle {
    font-size: 15px;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 800px;
  }

  .stats-subtitle strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* ==========================================================================
     KPI Cards Grid
     ========================================================================== */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 32px;
  }

  .kpi-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease;
  }

  .kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--border-strong);
  }

  .kpi-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .kpi-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-blue {
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
  }

  .icon-purple {
    background-color: var(--google-purple-subtle);
    color: var(--google-purple);
  }

  .icon-red {
    background-color: var(--google-red-subtle);
    color: var(--google-red);
  }

  .icon-green {
    background-color: var(--google-green-subtle);
    color: var(--google-green);
  }

  .kpi-tag {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
  }

  .kpi-value-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 4px;
  }

  .kpi-value {
    font-size: 32px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.1;
    letter-spacing: -0.5px;
  }

  .kpi-unit {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .kpi-pct {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-left: 2px;
  }

  .kpi-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .kpi-subtext {
    font-size: 11px;
    color: var(--text-tertiary);
    line-height: 1.4;
  }

  /* ==========================================================================
     Leaderboard Table Section
     ========================================================================== */
  .stats-section {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 24px 28px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-sm);
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .section-header {
    margin-bottom: 20px;
  }

  .section-title-wrap {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .section-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--google-yellow-subtle);
    color: var(--google-yellow);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .section-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }

  .section-desc {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    width: 100%;
  }

  .velocity-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  .velocity-table th {
    padding: 10px 14px;
    color: var(--text-tertiary);
    font-weight: 600;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .velocity-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }

  .velocity-table tbody tr {
    transition: background-color 0.1s ease;
  }

  .velocity-table tbody tr:hover {
    background-color: var(--bg-surface-hover);
  }

  .text-right {
    text-align: right;
  }

  .text-center {
    text-align: center;
  }

  .rank-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .rank-gold {
    background-color: #fef7e0;
    color: #b06000;
    border: 1px solid #fdd663;
  }

  [data-theme="dark"] .rank-gold {
    background-color: rgba(253, 214, 99, 0.2);
    color: #fdd663;
    border-color: rgba(253, 214, 99, 0.4);
  }

  .rank-silver {
    background-color: #f1f3f4;
    color: #5f6368;
    border: 1px solid #dadce0;
  }

  [data-theme="dark"] .rank-silver {
    background-color: rgba(232, 234, 237, 0.15);
    color: #e8eaed;
    border-color: rgba(232, 234, 237, 0.3);
  }

  .rank-bronze {
    background-color: #fce8e6;
    color: #c5221f;
    border: 1px solid #f5c2c7;
  }

  [data-theme="dark"] .rank-bronze {
    background-color: rgba(242, 139, 130, 0.2);
    color: #f28b82;
    border-color: rgba(242, 139, 130, 0.4);
  }

  .rank-normal {
    color: var(--text-tertiary);
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .service-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--google-blue);
    flex-shrink: 0;
  }

  .service-name-text {
    font-weight: 600;
  }

  .service-link:hover .service-name-text {
    color: var(--google-blue);
    text-decoration: underline;
  }

  .category-pill {
    font-size: 11px;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    color: var(--text-secondary);
  }

  .mono-num {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .rate-container {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rate-bar-bg {
    width: 60px;
    height: 6px;
    background-color: var(--border-subtle);
    border-radius: 3px;
    overflow: hidden;
  }

  .rate-bar-fill {
    height: 100%;
    border-radius: 3px;
  }

  .rate-text {
    font-size: 12px;
    font-family: var(--font-mono);
