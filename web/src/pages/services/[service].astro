---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChangeCard from '../../components/ChangeCard.astro';
import SubscriptionCard from '../../components/SubscriptionCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getAllFeedEntries,
  getServicesList,
  slugify,
  type FeedEntry,
} from '../../lib/feed';

export async function getStaticPaths() {
  const allEntries = await getAllFeedEntries();
  const services = await getServicesList();

  return services.map((s) => {
    const serviceEntries = allEntries.filter(
      (e) => slugify(e.service) === s.slug,
    );
    return {
      params: { service: s.slug },
      props: {
        serviceInfo: s,
        entries: serviceEntries,
      },
    };
  });
}

interface Props {
  serviceInfo: {
    service: string;
    slug: string;
    count: number;
    category: string;
    ecosystem?: string;
  };
  entries: FeedEntry[];
}

const { serviceInfo, entries } = Astro.props;

const breakingCount = entries.filter((e) => e.breaking).length;
const highImpactCount = entries.filter((e) => e.impact === "high").length;

const apisUsed = Array.from(new Set(entries.map((e) => e.api)));
const apisWithMeta = apisUsed.map((api) => {
  return {
    api,
    discoveryRestUrl: `https://www.googleapis.com/discovery/v1/apis/${api.replace(":", "/")}/rest`,
  };
});

const primaryDocLink = `https://cloud.google.com/products`;

const breadcrumbItems = [
  { label: "Radar Feed", href: "/" },
  ...(serviceInfo.ecosystem ? [{ label: serviceInfo.ecosystem }] : []),
  ...(serviceInfo.category && serviceInfo.category !== serviceInfo.ecosystem
    ? [{ label: serviceInfo.category }]
    : []),
  { label: serviceInfo.service },
];
---

<BaseLayout
  title={`${serviceInfo.service} API Changelog & Signals — Google Cloud Radar`}
  description={`Track real-time unreleased API changes, breaking changes, and method updates for Google Cloud ${serviceInfo.service}.`}
  activeServiceSlug={serviceInfo.slug}
  activeCategory={serviceInfo.category}
>
  <div class="service-hub-container">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Service Header Banner -->
    <div class="service-hero">
      <div class="service-hero-top">
        <div class="service-title-group">
          <span class="category-badge">{serviceInfo.category}</span>
          <h1 class="service-title">{serviceInfo.service}</h1>
          <p class="service-desc">
            Discovery API monitoring and real-time diff analysis for <strong>{serviceInfo.service}</strong>.
          </p>
        </div>

        <div class="service-actions">
          {primaryDocLink && (
            <a 
              href={primaryDocLink} 
              class="service-action-btn primary-doc-btn" 
              target="_blank" 
              rel="noopener noreferrer" 
              title={`Official documentation for ${serviceInfo.service}`}
            >
              <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              <span>Official Docs</span>
            </a>
          )}

          <a href={`/services/${serviceInfo.slug}/feed.json`} class="service-json-btn" target="_blank" title={`View ${serviceInfo.service} JSON API`}>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>JSON Feed</span>
          </a>
        </div>
      </div>

      <div class="service-stats-grid">
        <div class="stat-card">
          <div class="stat-val-group">
            <span class="stat-val">{entries.length}</span>
            {breakingCount > 0 && (
              <span class="stat-breaking-pill" title={`${breakingCount} breaking changes`}>
                <svg viewBox="0 0 24 24" width="11" height="11" fill="currentColor" aria-hidden="true">
                  <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                </svg>
                <span>{breakingCount}</span>
              </span>
            )}
          </div>
          <span class="stat-lbl">Detected Changes</span>
        </div>
        <div class="stat-card">
          <span class="stat-val">{highImpactCount}</span>
          <span class="stat-lbl">High Impact</span>
        </div>
        <div class="stat-card apis-stat">
          <span class="stat-apis-title">Tracked Discovery APIs (Raw JSON):</span>
          <div class="apis-pills">
            {apisWithMeta.map((item) => (
              <a 
                href={item.discoveryRestUrl} 
                class="api-pill-link" 
                target="_blank" 
                rel="noopener noreferrer" 
                title={`View Raw Google Discovery REST specification for ${item.api}`}
              >
                <code class="api-pill-name">{item.api}</code>
                <span class="api-pill-ext">JSON ↗</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Service Specific Subscription Card -->
    <SubscriptionCard 
      variant="service" 
      serviceName={serviceInfo.service} 
      serviceSlug={serviceInfo.slug} 
    />

    <!-- Timeline of Changes -->
    <div class="timeline-header">
      <h2>Change History ({entries.length}{breakingCount > 0 ? ` · ${breakingCount} breaking` : ''})</h2>
      <a href="/" class="back-home-link">← All Services</a>
    </div>

    <div class="service-timeline">
      {entries.length > 0 ? (
        entries.map((entry) => (
          <ChangeCard entry={entry} />
        ))
      ) : (
        <div class="no-changes-card">
          <div class="no-changes-icon">
            <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4.93 19.07a10 10 0 0 1 0-14.14M2 12h.01M12 2v.01M12 22v.01M22 12h.01M19.07 4.93a10 10 0 0 1 0 14.14M7.76 16.24a6 6 0 0 1 0-8.48M16.24 7.76a6 6 0 0 1 0 8.48M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
            </svg>
          </div>
          <h3>Continuous Monitoring Active</h3>
          <p>
            No method additions or breaking changes have been detected for <strong>{serviceInfo.service}</strong> yet.
          </p>
          <p class="no-changes-sub">
            Google Cloud Radar tracks the Google Discovery Service continuously. Any API changes will automatically appear here.
          </p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .service-hub-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .service-hero {
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-surface-hover) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 32px;
    box-shadow: var(--shadow-sm);
  }

  .service-hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .category-badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    padding: 3px 10px;
    border-radius: var(--radius-full);
    display: inline-block;
    margin-bottom: 8px;
  }

  .service-title {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 8px;
    letter-spacing: -0.4px;
  }

  .service-desc {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .service-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .service-action-btn,
  .service-rss-btn,
  .service-json-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .service-action-btn:hover,
  .service-rss-btn:hover,
  .service-json-btn:hover {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue);
    color: var(--google-blue);
    text-decoration: none;
  }

  .primary-doc-btn {
    color: var(--google-blue);
    border-color: var(--google-blue-border);
    background-color: var(--google-blue-subtle);
  }

  .primary-doc-btn:hover {
    background-color: #d2e3fc;
    border-color: var(--google-blue);
  }

  .service-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 140px) 1fr;
    gap: 16px;
  }

  .stat-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .stat-val-group {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 4px;
  }

  .stat-val {
    font-size: 22px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-blue);
    line-height: 1;
  }

  .stat-breaking-pill {
    font-size: 10px;
    font-weight: 700;
    color: var(--google-red);
    background-color: var(--google-red-subtle);
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .stat-lbl {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-tertiary);
    letter-spacing: 0.5px;
  }

  .apis-stat {
    flex-direction: column;
  }

  .stat-apis-title {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 6px;
  }

  .apis-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .api-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background-color: var(--bg-surface-hover);
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .api-pill-link:hover {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue);
    text-decoration: none;
  }

  .api-pill-name {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-primary);
  }

  .api-pill-link:hover .api-pill-name {
    color: var(--google-blue);
  }

  .api-pill-ext {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 700;
    color: var(--google-blue);
    background: var(--google-blue-subtle);
    padding: 1px 4px;
    border-radius: 2px;
  }

  .timeline-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .timeline-header h2 {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .back-home-link {
    font-size: 13px;
    font-weight: 500;
    color: var(--google-blue);
    text-decoration: none;
  }

  .back-home-link:hover {
    text-decoration: underline;
  }

  .no-changes-card {
    text-align: center;
    padding: 64px 24px;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-lg);
    margin-top: 12px;
  }

  .no-changes-icon {
    font-size: 36px;
    margin-bottom: 12px;
  }

  .no-changes-card h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .no-changes-card p {
    font-size: 14px;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 auto 12px;
    line-height: 1.5;
  }

  .no-changes-sub {
    font-size: 12.5px !important;
    color: var(--text-tertiary) !important;
  }

  @media (max-width: 768px) {
    .service-stats-grid {
      grid-template-columns: 1fr 1fr;
    }
    .apis-stat {
      grid-column: 1 / -1;
    }
  }
</style>
