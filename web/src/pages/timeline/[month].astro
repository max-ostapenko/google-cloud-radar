  }

  .month-chip-count {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    background-color: var(--bg-surface);
    padding: 1px 5px;
    border-radius: var(--radius-full);
  }

  .month-chip-breaking {
    font-size: 9.5px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-red);
    background-color: var(--google-red-subtle);
    padding: 1px 4px;
    border-radius: 3px;
  }

  .month-cards-stream {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cards-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .in-month-empty-state {
    text-align: center;
    padding: 36px 20px;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .in-month-empty-state p {
    font-size: 13.5px;
    color: var(--text-secondary);
    margin: 0;
  }

  .in-month-reset-btn {
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    color: var(--google-blue);
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .in-month-reset-btn:hover {
    background-color: var(--border-subtle);
  }

  @media (max-width: 768px) {
    .month-hero-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
    .month-hero-stats {
      width: 100%;
      justify-content: space-between;
    }
    .month-stat-box {
      flex: 1;
      min-width: 0;
    }
    .timeline-action-bar {
