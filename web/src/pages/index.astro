---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangeCard from '../components/ChangeCard.astro';
import { getAllFeedEntries, getServicesList, groupEntriesByMonth } from '../lib/feed';

const entries = await getAllFeedEntries();
const services = await getServicesList();
const monthGroups = groupEntriesByMonth(entries);

const breakingCount = entries.filter((e) => e.breaking).length;
const highImpactCount = entries.filter((e) => e.impact === 'high').length;
const aiCount = entries.filter((e) => e.category === 'AI & ML' || e.category.toLowerCase().includes('ai')).length;
const dataCount = entries.filter((e) => e.category === 'Data Analytics' || e.category.toLowerCase().includes('data')).length;
---

<BaseLayout 
  title="Google Cloud Radar — Real-Time Google API & Breaking Change Tracker"
  description="Live pre-release intelligence for Google Cloud and Google APIs. Track silent method additions, schema changes, and breaking changes before official documentation catches up."
>
  <div class="feed-header">
    <div class="hero-banner">
      <div class="hero-content">
        <h1 class="hero-title">Google Cloud Radar</h1>
        <p class="hero-subtitle">
          Real-time intelligence on unreleased Google Cloud API updates, breaking schema evolutions, and method additions caught directly from Discovery Service.
        </p>
      </div>
      <div class="hero-stats">
        <div class="stat-box">
          <div class="stat-main-row">
            <span class="stat-number">{entries.length}</span>
            {breakingCount > 0 && (
              <span class="stat-breaking-sub" title={`${breakingCount} breaking changes`}>⚠️ {breakingCount}</span>
            )}
          </div>
          <span class="stat-label">Total Insights</span>
        </div>
        <div class="stat-box">
          <span class="stat-number">{services.length}</span>
          <span class="stat-label">APIs Monitored</span>
          <a
            class="request-api-link"
            href={`https://github.com/max-ostapenko/google-cloud-radar/issues/new?title=Request%3A+Monitor+%5BAPI+Name%5D&labels=monitoring-request&body=%23%23+API+Monitoring+Request%0A%0A**API+Name**%3A+%0A**Discovery+Service+URL**+%28optional%29%3A+%0A**Why+it+matters**%3A+%0A`}
            target="_blank"
            rel="noopener noreferrer"
            title="Open a GitHub issue to request a new API"
          >+ Request</a>
        </div>
      </div>
    </div>

    <!-- Filters & Action Bar -->
    <div class="filters-bar">
      <div class="filter-pills" id="filter-pills-container">
        <button class="pill-btn active" data-filter="all">
          <span>All Updates</span>
          <span class="pill-count">{entries.length}</span>
          {breakingCount > 0 && (
            <span class="pill-breaking-sub" title={`${breakingCount} breaking changes`}>⚠️ {breakingCount}</span>
          )}
        </button>
        <button class="pill-btn pill-breaking" data-filter="breaking">
          <span>⚠️ Breaking Only</span>
          <span class="pill-count">{breakingCount}</span>
        </button>
        <button class="pill-btn" data-filter="high-impact">
          <span>🔥 High Impact</span>
          <span class="pill-count">{highImpactCount}</span>
        </button>
        <button class="pill-btn" data-filter="category-ai">
          <span>🧠 AI & ML</span>
          <span class="pill-count">{aiCount}</span>
        </button>
        <button class="pill-btn" data-filter="category-data">
          <span>📊 Data Analytics</span>
          <span class="pill-count">{dataCount}</span>
        </button>
      </div>

      <div class="feed-actions-group">
        <button class="feed-alerts-cta-btn" id="feed-alerts-cta-btn" type="button" title="Email Alerts for Breaking Changes">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <span id="feed-alerts-cta-text">⚡ Get Alerts</span>
        </button>
        <button class="share-view-btn" id="share-view-btn" title="Copy shareable link to this view">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="share-view-btn-text">Share View</span>
        </button>
      </div>
    </div>

    <!-- Month Timeline Switcher -->
    <div class="month-nav-bar" id="monthNavBar">
      <div class="month-nav-label">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        <span>Timeline</span>
      </div>
      <div class="month-chips-list">
        {monthGroups.map((g, idx) => {
          const aiMonthCount = g.entries.filter((e) => e.category === 'AI & ML' || e.category?.toLowerCase().includes('ai')).length;
          const dataMonthCount = g.entries.filter((e) => e.category === 'Data Analytics' || e.category?.toLowerCase().includes('data')).length;
          return (
            <a
              href={`/timeline/${g.key}/`}
              class={`month-chip ${idx === 0 ? 'active' : ''}`}
              data-month={g.key}
              data-month-label={g.label}
              data-count-all={g.totalCount}
              data-count-breaking={g.breakingCount}
              data-count-high-impact={g.highImpactCount}
              data-count-category-ai={aiMonthCount}
              data-count-category-data={dataMonthCount}
            >
              <span>{g.monthName} '{String(g.year).slice(2)}</span>
              <span class="month-chip-count">{g.totalCount}</span>
            </a>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Grouped Monthly Feed Stream -->
  <div class="feed-timeline" id="cards-container">
    {monthGroups.map((group, index) => (
      <section
        class={`month-section ${index === 0 ? 'is-latest' : ''}`}
        data-month={group.key}
        id={`month-${group.key}`}
      >
        <div class="in-month-empty-state" style="display: none;">
          <p>No <strong>{group.label}</strong> updates match the active category filter.</p>
          <button class="in-month-reset-btn" type="button">Reset Category Filter</button>
        </div>

        <div class="month-cards-list">
          {group.entries.map((entry) => (
            <ChangeCard entry={entry} />
          ))}
        </div>
      </section>
    ))}
  </div>

  <div id="no-results" class="no-results-state" style="display: none;">
    <div class="no-results-icon">🔍</div>
    <h3>No API updates match your query</h3>
    <p>Try searching for a different service name, method identifier, or clear your filters.</p>
    <button id="clear-search-btn" class="clear-btn">Reset All Filters</button>
  </div>
</BaseLayout>

<script>
  import MiniSearch from 'minisearch';
  import { onAuthChange, getUserAlertPreferences } from '../lib/firebase';

  // Client-side instant filtering & search logic with MiniSearch
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement;
  const pillButtons = document.querySelectorAll('.pill-btn');
  const monthChips = document.querySelectorAll('.month-chip');
  const monthSections = document.querySelectorAll('.month-section') as NodeListOf<HTMLElement>;
  const cards = document.querySelectorAll('.change-card') as NodeListOf<HTMLElement>;
  const resultsCountText = document.getElementById('results-count-text');
  const noResults = document.getElementById('no-results');
  const clearBtn = document.getElementById('clear-search-btn');

  const defaultMonth = monthChips.length > 0 ? (monthChips[0].getAttribute('data-month') || '') : '';
  let activeFilter = 'all';
  let activeMonth = defaultMonth;
  let searchQuery = '';

  const shareViewBtn = document.getElementById('share-view-btn');
  const shareViewText = document.getElementById('share-view-btn-text');

  // Read initial state from URL search params
  const urlParams = new URLSearchParams(window.location.search);
  const initialMonth = urlParams.get('month');
  const initialFilter = urlParams.get('filter');
  const initialQ = urlParams.get('q');

  if (initialMonth && Array.from(monthChips).some((c) => c.getAttribute('data-month') === initialMonth)) {
    activeMonth = initialMonth;
    monthChips.forEach((c) => {
      if (c.getAttribute('data-month') === initialMonth) c.classList.add('active');
      else c.classList.remove('active');
    });
  }

  if (initialFilter && ['breaking', 'high-impact', 'category-ai', 'category-data'].includes(initialFilter)) {
    activeFilter = initialFilter;
    pillButtons.forEach((b) => {
      if (b.getAttribute('data-filter') === initialFilter) b.classList.add('active');
      else b.classList.remove('active');
    });
  }

  if (initialQ && searchInput) {
    searchInput.value = initialQ;
    searchQuery = initialQ;
  }

  const filterLabels: Record<string, string> = {
    all: 'updates',
    breaking: 'breaking alerts',
    'high-impact': 'high-impact updates',
    'category-ai': 'AI & ML updates',
    'category-data': 'Data Analytics updates',
  };

  // Initialize MiniSearch Index with all rendered cards
  const documents: any[] = [];
  cards.forEach((card) => {
    const slug = card.getAttribute('data-slug') || '';
    const title = card.querySelector('.change-title')?.textContent || '';
    const service = card.querySelector('.service-name')?.textContent || '';
    const summary = card.querySelector('.change-summary')?.textContent || '';
    const category = card.getAttribute('data-category') || '';
    const text = card.getAttribute('data-text') || '';
    const breaking = card.getAttribute('data-breaking') === 'true';
    const impact = card.getAttribute('data-impact') || 'medium';

    documents.push({
      id: slug,
      slug,
      title,
      service,
      summary,
      category,
      text,
      breaking,
      impact,
    });
  });

  const miniSearch = new MiniSearch({
    fields: ['text', 'title', 'service', 'summary', 'category', 'slug'],
    storeFields: ['id'],
    searchOptions: {
      boost: {
        service: 3.0,
        title: 2.5,
        text: 1.8,
        summary: 1.0,
      },
      fuzzy: 0.25,
      prefix: true,
      combineWith: 'AND',
    },
  });

  miniSearch.addAll(documents);

  function updateUrlState() {
    const params = new URLSearchParams();
    if (activeMonth !== defaultMonth) params.set('month', activeMonth);
    if (activeFilter !== 'all') params.set('filter', activeFilter);
    if (searchQuery.trim()) params.set('q', searchQuery.trim());
    const queryString = params.toString();
    const newUrl = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
    history.replaceState(null, '', newUrl);
  }

  function applyFilters() {
    let matchedIds: Set<string> | null = null;
    const isSearching = searchQuery.trim().length > 0;

    if (isSearching) {
      const searchResults = miniSearch.search(searchQuery.trim(), {
        fuzzy: 0.25,
        prefix: true,
      });
      matchedIds = new Set(searchResults.map((r) => r.id));
    }

    let totalMatchingCount = 0;

    cards.forEach((card) => {
      const slug = card.getAttribute('data-slug') || '';
      const cardBreaking = card.getAttribute('data-breaking') === 'true';
      const cardImpact = card.getAttribute('data-impact');
      const cardCategory = (card.getAttribute('data-category') || '').toLowerCase();

      // Check Pill Filter
      let matchesPill = true;
      if (activeFilter === 'breaking') {
        matchesPill = cardBreaking;
      } else if (activeFilter === 'high-impact') {
        matchesPill = cardImpact === 'high';
      } else if (activeFilter === 'category-ai') {
        matchesPill = cardCategory.includes('ai') || cardCategory.includes('machine learning');
      } else if (activeFilter === 'category-data') {
        matchesPill = cardCategory.includes('data') || cardCategory.includes('platform') || cardCategory.includes('analytics');
      }

      // Check MiniSearch Match
      let matchesSearch = true;
      if (matchedIds !== null) {
        matchesSearch = matchedIds.has(slug);
      }

      if (matchesPill && matchesSearch) {
        card.style.display = 'block';
        totalMatchingCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Update Month Chip Badge Counts dynamically based on active filter
    monthChips.forEach((chip) => {
      const countForFilter = chip.getAttribute(`data-count-${activeFilter}`) || '0';
      const countEl = chip.querySelector('.month-chip-count');
      if (countEl) {
        countEl.textContent = countForFilter;
      }
      if (parseInt(countForFilter, 10) === 0) {
        chip.classList.add('is-empty');
      } else {
        chip.classList.remove('is-empty');
      }
    });

    let activeMonthVisibleCount = 0;
    const activeChip = document.querySelector('.month-chip.active');
    const activeMonthLabel = activeChip?.getAttribute('data-month-label') || 'Selected Month';

    // Update Month Sections visibility
    monthSections.forEach((section) => {
      const sectionMonth = section.getAttribute('data-month') || '';
      const sectionCards = section.querySelectorAll('.change-card') as NodeListOf<HTMLElement>;
      const inMonthEmpty = section.querySelector('.in-month-empty-state') as HTMLElement;
      let sectionVisibleCount = 0;
      sectionCards.forEach((c) => {
        if (c.style.display !== 'none') sectionVisibleCount++;
      });

      if (sectionMonth === activeMonth) {
        activeMonthVisibleCount = sectionVisibleCount;
      }

      // When searching, show all months with matches.
      // When not searching, show ONLY the active month section.
      if (isSearching) {
        section.style.display = sectionVisibleCount > 0 ? 'flex' : 'none';
        if (inMonthEmpty) inMonthEmpty.style.display = 'none';
      } else {
        if (sectionMonth === activeMonth) {
          section.style.display = 'flex';
          if (inMonthEmpty) {
            inMonthEmpty.style.display = sectionVisibleCount === 0 ? 'flex' : 'none';
          }
        } else {
          section.style.display = 'none';
        }
      }
    });

    if (resultsCountText) {
      const label = filterLabels[activeFilter] || 'updates';
      if (isSearching) {
        resultsCountText.innerHTML = `Found <strong>${totalMatchingCount}</strong> ${label} matching "<strong>${searchQuery}</strong>"`;
      } else {
        resultsCountText.innerHTML = `Showing <strong>${activeMonthVisibleCount}</strong> ${label} in <strong>${activeMonthLabel}</strong>`;
      }
    }

    if (noResults) {
      noResults.style.display = (isSearching && totalMatchingCount === 0) ? 'block' : 'none';
    }

    updateUrlState();
  }

  // Initial filter run
  applyFilters();

  // Pill click handlers
  pillButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      pillButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  // Month chip click handlers (intercept link click for client instant tab switch)
  monthChips.forEach((chip) => {
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      monthChips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      activeMonth = chip.getAttribute('data-month') || defaultMonth;
      applyFilters();
    });
  });

  // In-month reset buttons
  document.querySelectorAll('.in-month-reset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      activeFilter = 'all';
      pillButtons.forEach((b) => b.classList.remove('active'));
      const allPill = document.querySelector('[data-filter="all"]');
      if (allPill) allPill.classList.add('active');
      applyFilters();
    });
  });

  // Search input handler
  if (searchInput) {
    searchInput.addEventListener('input', (e: Event) => {
      searchQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });
  }

  // Clear button
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeFilter = 'all';
      activeMonth = defaultMonth;
      pillButtons.forEach((b) => b.classList.remove('active'));
      monthChips.forEach((c, idx) => {
        if (idx === 0) c.classList.add('active');
        else c.classList.remove('active');
      });
      const allPill = document.querySelector('[data-filter="all"]');
      if (allPill) allPill.classList.add('active');
      applyFilters();
    });
  }

  function getShareableUrl(): string {
    const origin = window.location.origin;
    const isSearching = searchQuery.trim().length > 0;
    if (isSearching) {
      const params = new URLSearchParams();
      if (activeFilter !== 'all') params.set('filter', activeFilter);
      params.set('q', searchQuery.trim());
      return `${origin}/?${params.toString()}`;
    }

    const monthKey = activeMonth || defaultMonth;
    const params = new URLSearchParams();
    if (activeFilter !== 'all') params.set('filter', activeFilter);
    const queryString = params.toString();
    return `${origin}/timeline/${monthKey}/${queryString ? `?${queryString}` : ''}`;
  }

  // Share View Link handler
  if (shareViewBtn) {
    shareViewBtn.addEventListener('click', async () => {
      try {
        const shareUrl = getShareableUrl();
        await navigator.clipboard.writeText(shareUrl);
        if (shareViewText) shareViewText.textContent = 'Link Copied! ✓';
        shareViewBtn.classList.add('copied');
        setTimeout(() => {
          if (shareViewText) shareViewText.textContent = 'Share View';
          shareViewBtn.classList.remove('copied');
        }, 2200);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }

  // In-feed Alerts Button handler & Dynamic subscription status
  const feedAlertsBtn = document.getElementById('feed-alerts-cta-btn');
  const feedAlertsText = document.getElementById('feed-alerts-cta-text');

  feedAlertsBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open_alerts_modal'));
  });

  async function updateAlertsBtnStatus(user: any) {
    if (!feedAlertsBtn || !feedAlertsText) return;
    if (user) {
      const prefs = await getUserAlertPreferences(user);
      if (prefs.breakingAlerts) {
        feedAlertsBtn.classList.add('is-subscribed');
        feedAlertsText.textContent = '✓ Alerts Active';
      } else {
        feedAlertsBtn.classList.remove('is-subscribed');
        feedAlertsText.textContent = '⚡ Enable Alerts';
      }
    } else {
      feedAlertsBtn.classList.remove('is-subscribed');
      feedAlertsText.textContent = '⚡ Get Alerts';
    }
  }

  onAuthChange(updateAlertsBtnStatus);
  window.addEventListener('radar_alert_prefs_update', (e: any) => {
    if (e.detail?.breakingAlerts) {
      feedAlertsBtn?.classList.add('is-subscribed');
      if (feedAlertsText) feedAlertsText.textContent = '✓ Alerts Active';
    } else {
      feedAlertsBtn?.classList.remove('is-subscribed');
      if (feedAlertsText) feedAlertsText.textContent = '⚡ Enable Alerts';
    }
  });
</script>

<style>
  .feed-header {
    margin-bottom: 24px;
  }

  .hero-banner {
    background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-surface-hover) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    box-shadow: var(--shadow-sm);
  }

  .hero-content {
    max-width: 680px;
  }

  .hero-title {
    font-size: 26px;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 10px;
    letter-spacing: -0.3px;
  }

  .hero-subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .hero-stats {
    display: flex;
    gap: 16px;
    flex-shrink: 0;
  }

  .stat-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 115px;
    text-align: center;
  }

  .stat-main-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 4px;
  }

  .stat-number {
    font-size: 24px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-blue);
    line-height: 1;
  }

  .stat-breaking-sub {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--google-red);
    background-color: var(--google-red-subtle);
    padding: 1px 5px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .stat-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
  }

  .request-api-link {
    margin-top: 6px;
    font-size: 10px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-decoration: none;
    border-bottom: 1px dashed var(--border-subtle);
    transition: color 0.15s ease, border-color 0.15s ease;
    letter-spacing: 0.3px;
  }

  .request-api-link:hover {
    color: var(--google-blue);
    border-bottom-color: var(--google-blue);
    text-decoration: none;
  }

  .filters-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .filter-pills {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pill-btn:hover {
    background-color: var(--bg-surface-hover);
    color: var(--text-primary);
  }

  .pill-btn.active {
    background-color: var(--google-blue);
    color: #ffffff;
    border-color: var(--google-blue);
  }

  .pill-btn.active .pill-count {
    background-color: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  .pill-breaking.active {
    background-color: var(--google-red);
    border-color: var(--google-red);
  }

  .pill-count {
    font-size: 11px;
    font-family: var(--font-mono);
    background-color: var(--bg-surface-hover);
    padding: 1px 6px;
    border-radius: var(--radius-full);
    color: var(--text-tertiary);
  }

  .pill-breaking-sub {
    font-size: 10px;
    font-weight: 700;
    color: var(--google-red);
    background-color: var(--google-red-subtle);
    padding: 1px 4px;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .pill-btn.active .pill-breaking-sub {
    background-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
  }

  .feed-actions-group {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .feed-alerts-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
