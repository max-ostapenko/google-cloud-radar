---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChangeCard from '../components/ChangeCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getAllFeedEntries, groupEntriesByMonth } from '../lib/feed';

const entries = await getAllFeedEntries();
const monthGroups = groupEntriesByMonth(entries);

const breakingCount = entries.filter((e) => e.breaking).length;
const highImpactCount = entries.filter((e) => e.impact === 'high').length;

// Initial 30d calculations for SSR facets
const firstDate = entries[0]?.date ? new Date(entries[0].date + 'T00:00:00Z') : new Date('2026-09-16T00:00:00Z');
const min30d = new Date(firstDate.getTime() - 30 * 86400000).toISOString().slice(0, 10);
const entries30d = entries.filter((e) => e.date >= min30d);
const count30d = entries30d.length;
const breaking30d = entries30d.filter((e) => e.breaking).length;
const highImpact30d = entries30d.filter((e) => e.impact === 'high').length;

const min60d = new Date(firstDate.getTime() - 60 * 86400000).toISOString().slice(0, 10);
const count60d = entries.filter((e) => e.date >= min60d).length;

const min90d = new Date(firstDate.getTime() - 90 * 86400000).toISOString().slice(0, 10);
const count90d = entries.filter((e) => e.date >= min90d).length;
---

<BaseLayout
  title="Google Cloud Radar — Real-Time Google API & Breaking Change Tracker"
  description="Live pre-release intelligence for Google Cloud and Google APIs. Track silent method additions, schema changes, and breaking changes before official documentation catches up."
>
  <div class="feed-header">
    <Breadcrumbs items={[{ label: 'Radar Feed' }]} />

    <!-- Merged Hero & Alerts Banner (Auto-hidden if user is already subscribed) -->
    <div class="merged-hero-card" id="feedHeroBanner">
      <div class="hero-main">
        <h1 class="hero-title">Google Cloud Radar</h1>
        <p class="hero-subtitle">
          Real-time intelligence on unreleased Google Cloud API updates, breaking schema evolutions, and method additions caught directly from Discovery Service.
        </p>
      </div>

      <div class="hero-alerts-callout">
        <div class="hero-alerts-info">
          <div class="hero-alerts-badge">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <span>Email Alerts</span>
          </div>
          <p class="hero-alerts-prompt">Breaking changes instantly & Monday digests across monitored GCP services.</p>
        </div>
        <button class="hero-subscribe-btn" id="heroSubscribeBtn" type="button">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"></path>
          </svg>
          <span>Enable Email Alerts</span>
        </button>
      </div>
    </div>

    <!-- Unified Single-Row Filters & Action Bar -->
    <div class="filters-bar">
      <div class="filters-controls-group">
        <!-- Timeline Calendar Dropdown -->
        <div class="filter-dropdown-wrapper" id="timelineDropdownWrapper">
          <button
            class="filter-dropdown-trigger"
            id="timelineDropdownBtn"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            title="Filter by timeline"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="dropdown-leading-icon">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span class="dropdown-label-muted">Timeline:</span>
            <strong id="timelineActiveLabel">Last 30 days</strong>
            <span class="dropdown-count-badge" id="timelineActiveCount">{count30d}</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" class="dropdown-chevron">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <div class="filter-dropdown-menu" id="timelineDropdownMenu" role="menu">
            <div class="menu-section-label">Presets</div>
            <button class="menu-option active" data-timeline-preset="30d" type="button" role="menuitem">
              <span class="option-check-icon">✓</span>
              <span class="option-label">Last 30 days</span>
              <span class="option-badge">{count30d}</span>
            </button>
            <button class="menu-option" data-timeline-preset="60d" type="button" role="menuitem">
              <span class="option-check-icon">✓</span>
              <span class="option-label">Last 60 days</span>
              <span class="option-badge">{count60d}</span>
            </button>
            <button class="menu-option" data-timeline-preset="90d" type="button" role="menuitem">
              <span class="option-check-icon">✓</span>
              <span class="option-label">Last 90 days</span>
              <span class="option-badge">{count90d}</span>
            </button>
            <button class="menu-option" data-timeline-preset="all" type="button" role="menuitem">
              <span class="option-check-icon">✓</span>
              <span class="option-label">All time</span>
              <span class="option-badge">{entries.length}</span>
            </button>

            <div class="menu-divider"></div>

            <div class="custom-range-box">
              <div class="menu-section-label">Custom Date Range</div>
              <div class="custom-inputs-row">
                <div class="custom-input-group">
                  <label for="customDateFrom">From</label>
                  <input type="date" id="customDateFrom" />
                </div>
                <div class="custom-input-group">
                  <label for="customDateTo">To</label>
                  <input type="date" id="customDateTo" />
                </div>
              </div>
              <button type="button" id="applyCustomDateBtn" class="custom-apply-btn">Apply Range</button>
            </div>
          </div>
        </div>

        <!-- Impact Filter Dropdown -->
        <div class="filter-dropdown-wrapper" id="impactDropdownWrapper">
          <button
            class="filter-dropdown-trigger"
            id="impactDropdownBtn"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            title="Filter by change impact"
          >
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" class="dropdown-leading-icon">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <span class="dropdown-label-muted">Impact:</span>
            <strong id="impactActiveLabel">All changes</strong>
            <span class="dropdown-count-badge" id="impactActiveCount">{count30d}</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" class="dropdown-chevron">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <div class="filter-dropdown-menu" id="impactDropdownMenu" role="menu">
            <button class="menu-option active" data-impact="all" type="button" role="menuitem">
              <span class="option-check-icon">✓</span>
              <span class="option-label">All changes</span>
              <span class="option-badge">{count30d}</span>
            </button>
            <button class="menu-option" data-impact="high-impact" type="button" role="menuitem">
              <span class="option-check-icon">✓</span>
              <span class="option-label">High Impact</span>
              <span class="option-badge">{highImpact30d}</span>
            </button>
            <button class="menu-option menu-option-breaking" data-impact="breaking" type="button" role="menuitem">
              <span class="option-check-icon">✓</span>
              <span class="option-label">Breaking Only</span>
              <span class="option-badge breaking-badge">{breaking30d}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="feed-actions-group">
        <span class="feed-results-count" id="feed-results-count">{count30d} updates</span>
        <button class="feed-alerts-cta-btn" id="feed-alerts-cta-btn" type="button" title="Email Alerts for Breaking Changes">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          <span id="feed-alerts-cta-text">Get Alerts</span>
        </button>
        <button class="share-view-btn" id="share-view-btn" title="Copy shareable link to this view">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
          <span id="share-view-btn-text">Share View</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Grouped Monthly Feed Stream -->
  <div class="feed-timeline" id="cards-container">
    {monthGroups.map((group, index) => (
      <section
        class={`month-section ${index === 0 ? 'is-latest' : ''}`}
        data-month={group.key}
        id={`month-${group.key}`}
        aria-label={`${group.label} Updates`}
      >
        <h2 class="sr-only">{group.label} Updates</h2>
        <div class="month-cards-list">
          {group.entries.map((entry) => (
            <ChangeCard entry={entry} />
          ))}
        </div>
      </section>
    ))}
  </div>

  <div id="no-results" class="no-results-state" style="display: none;">
    <div class="no-results-icon">
      <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
    <h3>No API updates match your query</h3>
    <p>Try expanding your timeline, selecting different impact filters, or adjusting your search keywords.</p>
    <button id="clear-search-btn" class="clear-btn">Reset All Filters</button>
  </div>
</BaseLayout>

<script>
  import MiniSearch from 'minisearch';
  import { onAuthChange, getUserAlertPreferences } from '../lib/firebase';

  // DOM Elements
  const searchInput = document.getElementById('global-search-input') as HTMLInputElement;
  const cards = document.querySelectorAll('.change-card') as NodeListOf<HTMLElement>;
  const monthSections = document.querySelectorAll('.month-section') as NodeListOf<HTMLElement>;
  const feedResultsCount = document.getElementById('feed-results-count');
  const noResults = document.getElementById('no-results');
  const clearBtn = document.getElementById('clear-search-btn');

  // Merged Hero Banner Elements
  const heroBanner = document.getElementById('feedHeroBanner');
  const heroSubscribeBtn = document.getElementById('heroSubscribeBtn');
  const feedAlertsBtn = document.getElementById('feed-alerts-cta-btn');
  const feedAlertsText = document.getElementById('feed-alerts-cta-text');

  // Timeline Dropdown Elements
  const timelineDropdownWrapper = document.getElementById('timelineDropdownWrapper');
  const timelineDropdownBtn = document.getElementById('timelineDropdownBtn');
  const timelineActiveLabel = document.getElementById('timelineActiveLabel');
  const timelineActiveCount = document.getElementById('timelineActiveCount');
  const timelinePresetBtns = document.querySelectorAll('[data-timeline-preset]');
  const customDateFrom = document.getElementById('customDateFrom') as HTMLInputElement;
  const customDateTo = document.getElementById('customDateTo') as HTMLInputElement;
  const applyCustomDateBtn = document.getElementById('applyCustomDateBtn');

  // Impact Dropdown Elements
  const impactDropdownWrapper = document.getElementById('impactDropdownWrapper');
  const impactDropdownBtn = document.getElementById('impactDropdownBtn');
  const impactActiveLabel = document.getElementById('impactActiveLabel');
  const impactActiveCount = document.getElementById('impactActiveCount');
  const impactOptionBtns = document.querySelectorAll('[data-impact]');

  // Share View
  const shareViewBtn = document.getElementById('share-view-btn');
  const shareViewText = document.getElementById('share-view-btn-text');

  // Reference date for relative timeline presets (uses latest card date or today)
  let latestDateStr = '2026-09-16';
  if (cards.length > 0) {
    const firstDate = cards[0].getAttribute('data-date');
    if (firstDate) latestDateStr = firstDate;
  }
  const refDate = new Date(latestDateStr + 'T00:00:00Z');

  // Prefill custom date inputs
  const defaultMinDate = new Date(refDate.getTime() - 30 * 86400000);
  if (customDateFrom) customDateFrom.value = defaultMinDate.toISOString().slice(0, 10);
  if (customDateTo) customDateTo.value = latestDateStr;

  // Active filter state - declared at the top before any functions execute
  let activeTimeline = '30d';
  let activeImpact = 'all';
  let searchQuery = '';
  let focusedCardIndex = -1;

  // Read initial state from URL query parameters
  const urlParams = new URLSearchParams(window.location.search);
  const paramTimeline = urlParams.get('timeline');
  const paramImpact = urlParams.get('impact') || urlParams.get('filter'); // backwards compat
  const paramQ = urlParams.get('q');

  if (paramTimeline) {
    if (['30d', '60d', '90d', 'all'].includes(paramTimeline)) {
      activeTimeline = paramTimeline;
    } else if (paramTimeline.includes(':')) {
      activeTimeline = paramTimeline;
      const [f, t] = paramTimeline.split(':');
      if (customDateFrom && f) customDateFrom.value = f;
      if (customDateTo && t) customDateTo.value = t;
    }
  }

  if (paramImpact && ['all', 'high-impact', 'breaking'].includes(paramImpact)) {
    activeImpact = paramImpact;
  }

  if (paramQ && searchInput) {
    searchInput.value = paramQ;
    searchQuery = paramQ;
  }

  // Check subscriber status immediately to prevent CLS
  if (localStorage.getItem('gcr_alerts_subscribed') === 'true') {
    if (heroBanner) heroBanner.style.display = 'none';
    if (feedAlertsBtn) {
      feedAlertsBtn.classList.add('is-subscribed');
      if (feedAlertsText) feedAlertsText.textContent = 'Alerts Active';
    }
  }

  // Initialize MiniSearch
  const documents: any[] = [];
  cards.forEach((card) => {
    const slug = card.getAttribute('data-slug') || '';
    const title = card.querySelector('.change-title')?.textContent || '';
    const service = card.querySelector('.service-name')?.textContent || '';
    const summary = card.querySelector('.change-summary')?.textContent || '';
    const category = card.getAttribute('data-category') || '';
    const text = card.getAttribute('data-text') || '';
    const breaking = card.getAttribute('data-breaking') === 'true';
    const impact = card.getAttribute('data-impact') || 'medium';

    documents.push({
      id: slug,
      slug,
      title,
      service,
      summary,
      category,
      text,
      breaking,
      impact,
    });
  });

  const miniSearch = new MiniSearch({
    fields: ['text', 'title', 'service', 'summary', 'category', 'slug'],
    storeFields: ['id'],
    searchOptions: {
      boost: {
        service: 3.0,
        title: 2.5,
        text: 1.8,
        summary: 1.0,
      },
      fuzzy: 0.25,
      prefix: true,
      combineWith: 'AND',
    },
  });
  miniSearch.addAll(documents);

  function getDateRangeForTimeline(timeline: string): { minDate: string; maxDate: string } {
    if (timeline === 'all') {
      return { minDate: '1970-01-01', maxDate: '9999-12-31' };
    }
    if (timeline === '60d') {
      const minD = new Date(refDate.getTime() - 60 * 86400000);
      return { minDate: minD.toISOString().slice(0, 10), maxDate: '9999-12-31' };
    }
    if (timeline === '90d') {
      const minD = new Date(refDate.getTime() - 90 * 86400000);
      return { minDate: minD.toISOString().slice(0, 10), maxDate: '9999-12-31' };
    }
    if (timeline.includes(':')) {
      const [from, to] = timeline.split(':');
      return { minDate: from || '1970-01-01', maxDate: to || '9999-12-31' };
    }
    // Default 30d
    const minD = new Date(refDate.getTime() - 30 * 86400000);
    return { minDate: minD.toISOString().slice(0, 10), maxDate: '9999-12-31' };
  }

  function updateTimelineUi(timelineCounts: Record<string, number>, totalMatchingCount: number) {
    timelinePresetBtns.forEach((btn) => {
      const preset = btn.getAttribute('data-timeline-preset');
      if (preset === activeTimeline) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }

      if (preset && timelineCounts[preset] !== undefined) {
        const count = timelineCounts[preset];
        const badge = btn.querySelector('.option-badge');
        if (badge) badge.textContent = String(count);
        if (count === 0) btn.classList.add('is-zero-facet');
        else btn.classList.remove('is-zero-facet');
      }
    });

    if (timelineActiveLabel) {
      if (activeTimeline === '30d') timelineActiveLabel.textContent = 'Last 30 days';
      else if (activeTimeline === '60d') timelineActiveLabel.textContent = 'Last 60 days';
      else if (activeTimeline === '90d') timelineActiveLabel.textContent = 'Last 90 days';
      else if (activeTimeline === 'all') timelineActiveLabel.textContent = 'All time';
      else if (activeTimeline.includes(':')) {
        const [from, to] = activeTimeline.split(':');
        timelineActiveLabel.textContent = `${from} – ${to}`;
      }
    }

    if (timelineActiveCount) {
      const count = activeTimeline in timelineCounts ? timelineCounts[activeTimeline] : totalMatchingCount;
      timelineActiveCount.textContent = String(count);
    }
  }

  function updateImpactUi(impactCounts: Record<string, number>) {
    impactOptionBtns.forEach((btn) => {
      const val = btn.getAttribute('data-impact');
      if (val === activeImpact) {
        btn.classList.add('active');
        const label = btn.querySelector('.option-label')?.textContent || '';
        if (impactActiveLabel) impactActiveLabel.textContent = label;
      } else {
        btn.classList.remove('active');
      }

      if (val && impactCounts[val] !== undefined) {
        const count = impactCounts[val];
        const badge = btn.querySelector('.option-badge');
        if (badge) badge.textContent = String(count);
        if (count === 0) btn.classList.add('is-zero-facet');
        else btn.classList.remove('is-zero-facet');
      }
    });

    if (impactActiveCount) {
      const count = impactCounts[activeImpact] !== undefined ? impactCounts[activeImpact] : impactCounts['all'];
      impactActiveCount.textContent = String(count);
    }
  }

  function computeFacetedCounts(matchedIds: Set<string> | null) {
    const rangeActive = getDateRangeForTimeline(activeTimeline);
    const range30 = getDateRangeForTimeline('30d');
    const range60 = getDateRangeForTimeline('60d');
    const range90 = getDateRangeForTimeline('90d');

    const impactCounts: Record<string, number> = { all: 0, 'high-impact': 0, breaking: 0 };
    const timelineCounts: Record<string, number> = { '30d': 0, '60d': 0, '90d': 0, all: 0 };

    cards.forEach((card) => {
      const slug = card.getAttribute('data-slug') || '';
      const cardBreaking = card.getAttribute('data-breaking') === 'true';
      const cardImpact = card.getAttribute('data-impact') || '';
      const cardDate = card.getAttribute('data-date') || '';

      const matchesSearch = matchedIds !== null ? matchedIds.has(slug) : true;
      if (!matchesSearch) return;

      // 1. Impact Facets (given currently active timeline + search):
      const inActiveTimeline = cardDate >= rangeActive.minDate && cardDate <= rangeActive.maxDate;
      if (inActiveTimeline) {
        impactCounts['all']++;
        if (cardImpact === 'high') impactCounts['high-impact']++;
        if (cardBreaking) impactCounts['breaking']++;
      }

      // 2. Timeline Facets (given currently active impact + search):
      let matchesActiveImpact = true;
      if (activeImpact === 'breaking') matchesActiveImpact = cardBreaking;
      else if (activeImpact === 'high-impact') matchesActiveImpact = cardImpact === 'high';

      if (matchesActiveImpact) {
        if (cardDate >= range30.minDate && cardDate <= range30.maxDate) timelineCounts['30d']++;
        if (cardDate >= range60.minDate && cardDate <= range60.maxDate) timelineCounts['60d']++;
        if (cardDate >= range90.minDate && cardDate <= range90.maxDate) timelineCounts['90d']++;
        timelineCounts['all']++;
      }
    });

    return { impactCounts, timelineCounts };
  }

  function updateUrlState() {
    const params = new URLSearchParams();
    if (activeTimeline !== '30d') params.set('timeline', activeTimeline);
    if (activeImpact !== 'all') params.set('impact', activeImpact);
    if (searchQuery.trim()) params.set('q', searchQuery.trim());
    const queryString = params.toString();
    const newUrl = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
    history.replaceState(null, '', newUrl);
  }

  function applyFilters() {
    let matchedIds: Set<string> | null = null;
    const isSearching = searchQuery.trim().length > 0;

    if (isSearching) {
      const searchResults = miniSearch.search(searchQuery.trim(), {
        fuzzy: 0.25,
        prefix: true,
      });
      matchedIds = new Set(searchResults.map((r) => r.id));
    }

    const { minDate, maxDate } = getDateRangeForTimeline(activeTimeline);
    let totalMatchingCount = 0;

    // Reset keyboard selection on filter/search change
    focusedCardIndex = -1;
    cards.forEach((c) => c.classList.remove('keyboard-focused'));

    cards.forEach((card) => {
      const slug = card.getAttribute('data-slug') || '';
      const cardBreaking = card.getAttribute('data-breaking') === 'true';
      const cardImpact = card.getAttribute('data-impact');
      const cardDate = card.getAttribute('data-date') || '';

      // Date Range Match
      const matchesDate = cardDate >= minDate && cardDate <= maxDate;

      // Impact Match
      let matchesImpact = true;
      if (activeImpact === 'breaking') {
        matchesImpact = cardBreaking;
      } else if (activeImpact === 'high-impact') {
        matchesImpact = cardImpact === 'high';
      }

      // MiniSearch Match
      let matchesSearch = true;
      if (matchedIds !== null) {
        matchesSearch = matchedIds.has(slug);
      }

      if (matchesDate && matchesImpact && matchesSearch) {
        card.style.display = 'block';
        totalMatchingCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Update month section visibility
    monthSections.forEach((section) => {
      const sectionCards = section.querySelectorAll('.change-card') as NodeListOf<HTMLElement>;
      let sectionVisibleCount = 0;
      sectionCards.forEach((c) => {
        if (c.style.display !== 'none') sectionVisibleCount++;
      });

      section.style.display = sectionVisibleCount > 0 ? 'flex' : 'none';
    });

    // Update results indicator
    if (feedResultsCount) {
      feedResultsCount.textContent = `${totalMatchingCount} update${totalMatchingCount === 1 ? '' : 's'}`;
    }

    if (noResults) {
      noResults.style.display = totalMatchingCount === 0 ? 'block' : 'none';
    }

    const { impactCounts, timelineCounts } = computeFacetedCounts(matchedIds);
    updateTimelineUi(timelineCounts, totalMatchingCount);
    updateImpactUi(impactCounts);
    updateUrlState();
  }

  // Initial Filter Application
  applyFilters();

  // Dropdown Toggles & Click Outside handling
  function closeAllDropdowns() {
    timelineDropdownWrapper?.classList.remove('is-open');
    timelineDropdownBtn?.setAttribute('aria-expanded', 'false');
    impactDropdownWrapper?.classList.remove('is-open');
    impactDropdownBtn?.setAttribute('aria-expanded', 'false');
  }

  timelineDropdownBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = timelineDropdownWrapper?.classList.contains('is-open');
    closeAllDropdowns();
    if (!isOpen && timelineDropdownWrapper) {
      timelineDropdownWrapper.classList.add('is-open');
      timelineDropdownBtn.setAttribute('aria-expanded', 'true');
    }
  });

  impactDropdownBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isOpen = impactDropdownWrapper?.classList.contains('is-open');
    closeAllDropdowns();
    if (!isOpen && impactDropdownWrapper) {
      impactDropdownWrapper.classList.add('is-open');
      impactDropdownBtn.setAttribute('aria-expanded', 'true');
    }
  });

  // Prevent closing when clicking inside menu boxes
  document.getElementById('timelineDropdownMenu')?.addEventListener('click', (e) => {
    e.stopPropagation();
  });
  document.getElementById('impactDropdownMenu')?.addEventListener('click', (e) => {
    e.stopPropagation();
  });

  window.addEventListener('click', () => {
    closeAllDropdowns();
  });

  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      closeAllDropdowns();
    }
  });

  // Timeline Preset Click Handlers
  timelinePresetBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const preset = btn.getAttribute('data-timeline-preset');
      if (preset) {
        activeTimeline = preset;
        closeAllDropdowns();
        applyFilters();
      }
    });
  });

  // Custom Date Range Apply Button
  applyCustomDateBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const fromVal = customDateFrom?.value;
    const toVal = customDateTo?.value;
    if (fromVal && toVal) {
      activeTimeline = `${fromVal}:${toVal}`;
      closeAllDropdowns();
      applyFilters();
    }
  });

  // Impact Option Click Handlers
  impactOptionBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const val = btn.getAttribute('data-impact');
      if (val) {
        activeImpact = val;
        closeAllDropdowns();
        applyFilters();
      }
    });
  });

  // Global search input handler
  if (searchInput) {
    searchInput.addEventListener('input', (e: Event) => {
      searchQuery = (e.target as HTMLInputElement).value;
      applyFilters();
    });
  }

  // Clear / Reset All Filters
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      activeTimeline = '30d';
      activeImpact = 'all';
      if (customDateFrom) customDateFrom.value = defaultMinDate.toISOString().slice(0, 10);
      if (customDateTo) customDateTo.value = latestDateStr;
      closeAllDropdowns();
      applyFilters();
    });
  }

  // Share View Link handler
  function getShareableUrl(): string {
    const origin = window.location.origin;
    const params = new URLSearchParams();
    if (activeTimeline !== '30d') params.set('timeline', activeTimeline);
    if (activeImpact !== 'all') params.set('impact', activeImpact);
    if (searchQuery.trim()) params.set('q', searchQuery.trim());
    const qs = params.toString();
    return `${origin}/${qs ? `?${qs}` : ''}`;
  }

  if (shareViewBtn) {
    shareViewBtn.addEventListener('click', async () => {
      try {
        const shareUrl = getShareableUrl();
        await navigator.clipboard.writeText(shareUrl);
        if (shareViewText) shareViewText.textContent = 'Link Copied!';
        shareViewBtn.classList.add('copied');
        setTimeout(() => {
          if (shareViewText) shareViewText.textContent = 'Share View';
          shareViewBtn.classList.remove('copied');
        }, 2200);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  }

  // Alerts Modal & Subscription Management
  heroSubscribeBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open_alerts_modal'));
  });

  feedAlertsBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open_alerts_modal'));
  });

  function setSubscribedState(isSubscribed: boolean) {
    if (isSubscribed) {
      localStorage.setItem('gcr_alerts_subscribed', 'true');
      if (heroBanner) heroBanner.style.display = 'none';
      if (feedAlertsBtn) {
        feedAlertsBtn.classList.add('is-subscribed');
        if (feedAlertsText) feedAlertsText.textContent = 'Alerts Active';
      }
    } else {
      localStorage.removeItem('gcr_alerts_subscribed');
      if (heroBanner) heroBanner.style.display = '';
      if (feedAlertsBtn) {
        feedAlertsBtn.classList.remove('is-subscribed');
        if (feedAlertsText) feedAlertsText.textContent = 'Get Alerts';
      }
    }
  }

  onAuthChange(async (user: any) => {
    if (user) {
      try {
        const prefs = await getUserAlertPreferences(user);
        const isSubscribed = Boolean(prefs?.breakingAlerts || prefs?.weeklyDigest);
        setSubscribedState(isSubscribed);
      } catch (err) {
        console.warn('Could not read user alert preferences', err);
      }
    } else {
      setSubscribedState(false);
    }
  });

  window.addEventListener('radar_alert_prefs_update', (e: any) => {
    const isSubscribed = Boolean(e.detail?.breakingAlerts || e.detail?.weeklyDigest);
    setSubscribedState(isSubscribed);
  });

  // Keyboard ergonomics: 'j' (next update), 'k' (previous update), 'Enter' (open permalink)
  function getVisibleCards(): HTMLElement[] {
    const allCards = Array.from(document.querySelectorAll<HTMLElement>('.change-card'));
    return allCards.filter((card) => {
      if (card.style.display === 'none') return false;
      const section = card.closest<HTMLElement>('.month-section');
      if (section && section.style.display === 'none') return false;
      return true;
    });
  }

  function updateCardFocus(targetCards: HTMLElement[], newIndex: number) {
    if (!targetCards.length) return;
    targetCards.forEach((c) => c.classList.remove('keyboard-focused'));
    focusedCardIndex = Math.max(0, Math.min(newIndex, targetCards.length - 1));
    const targetCard = targetCards[focusedCardIndex];
    if (targetCard) {
      targetCard.classList.add('keyboard-focused');
      targetCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  window.addEventListener('keydown', (e: KeyboardEvent) => {
    const active = document.activeElement;
    if (
      active?.tagName === 'INPUT' ||
      active?.tagName === 'TEXTAREA' ||
      active?.tagName === 'SELECT' ||
      (active as HTMLElement)?.isContentEditable
    ) {
      return;
    }

    const shareModal = document.getElementById('globalShareModalBackdrop');
    if (shareModal && shareModal.style.display === 'flex') return;
    const alertsModal = document.getElementById('alertsModalBackdrop');
    if (alertsModal && alertsModal.style.display === 'flex') return;

    if (e.key === 'j' || e.key === 'J') {
      const visibleCards = getVisibleCards();
      if (!visibleCards.length) return;
      e.preventDefault();
      updateCardFocus(visibleCards, focusedCardIndex + 1);
    } else if (e.key === 'k' || e.key === 'K') {
      const visibleCards = getVisibleCards();
      if (!visibleCards.length) return;
      e.preventDefault();
      updateCardFocus(visibleCards, focusedCardIndex <= 0 ? 0 : focusedCardIndex - 1);
    } else if (e.key === 'Enter') {
      const visibleCards = getVisibleCards();
      if (focusedCardIndex >= 0 && focusedCardIndex < visibleCards.length) {
        const focusedCard = visibleCards[focusedCardIndex];
        const titleLink = focusedCard.querySelector<HTMLAnchorElement>('a.title-link');
        if (titleLink && titleLink.href) {
          e.preventDefault();
          window.location.href = titleLink.href;
        }
      }
    }
  });
</script>

