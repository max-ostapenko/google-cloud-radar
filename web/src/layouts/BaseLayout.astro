---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import AlertsModal from "../components/AlertsModal.astro";
import ShareScoopModal from "../components/ShareScoopModal.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  activeServiceSlug?: string;
  activeCategory?: string;
  ogType?: string;
  ogImage?: string;
  image?: string;
  schemaData?: Record<string, any>;
  showSidebar?: boolean;
  noindex?: boolean;
  robots?: string;
  canonicalUrl?: string;
  prevUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description = "Live pre-release intelligence for Google Cloud Platform. Real-time API changes, breaking changes, and method deprecations diffed from the Discovery Service.",
  activeServiceSlug = "",
  activeCategory = "",
  ogType = "website",
  schemaData,
  showSidebar = true,
  noindex = false,
  robots,
  canonicalUrl,
  prevUrl,
  nextUrl,
} = Astro.props;

const ogImage = Astro.props.ogImage || Astro.props.image || "/og-image.png";

const rawPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalURL = new URL(
  rawPath,
  Astro.site || "https://google-cloud-radar.com",
);

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Google Cloud Radar",
  url: canonicalURL.origin,
  description: description,
  author: {
    "@type": "Organization",
    name: "Google Cloud Radar",
    url: "https://github.com/max-ostapenko/google-cloud-radar",
  },
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: "https://google-cloud-radar.com/?q={search_term_string}",
    },
    "query-input": "required name=search_term_string",
  },
};

const jsonLd = schemaData
  ? JSON.stringify(schemaData)
  : JSON.stringify(defaultSchema);

const posthogKey = (import.meta.env.PUBLIC_POSTHOG_KEY || process.env.PUBLIC_POSTHOG_KEY || "phc_oYXtjEtiNUMCZTGfjJGBocuauJWYUJhxrgBJeHopjVfx").trim();
const posthogHost = (import.meta.env.PUBLIC_POSTHOG_HOST || process.env.PUBLIC_POSTHOG_HOST || "https://eu.i.posthog.com").trim();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content={robots || "noindex, nofollow"} />
    ) : (
      <link rel="canonical" href={canonicalUrl || canonicalURL} />
    )}
    {prevUrl && <link rel="prev" href={prevUrl} />}
    {nextUrl && <link rel="next" href={nextUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link
      rel="search"
      type="application/opensearchdescription+xml"
      title="Google Cloud Radar"
      href="/opensearch.xml"
    />

    <!-- Canonical Host Enforcement / Preview & Firebase default domain protection -->
    <script is:inline>
      if (typeof window !== 'undefined' && (window.location.hostname.endsWith('.web.app') || window.location.hostname.endsWith('.firebaseapp.com'))) {
        var metaRobots = document.createElement('meta');
        metaRobots.name = 'robots';
        metaRobots.content = 'noindex, nofollow';
        document.head.appendChild(metaRobots);
        if (!window.location.hostname.includes('--')) {
          window.location.replace('https://google-cloud-radar.com' + window.location.pathname + window.location.search + window.location.hash);
        }
      }
    </script>

    <!-- Feed Autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={activeServiceSlug ? `${title} — RSS Feed` : "Google Cloud Radar — RSS 2.0 Feed"}
      href={activeServiceSlug ? `/services/${activeServiceSlug}/rss.xml` : "/rss.xml"}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={activeServiceSlug ? `${title} — Atom Feed` : "Google Cloud Radar — Atom 1.0 Feed"}
      href={activeServiceSlug ? `/services/${activeServiceSlug}/atom.xml` : "/atom.xml"}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title={activeServiceSlug ? `${title} — JSON Feed` : "Google Cloud Radar — JSON Feed 1.1"}
      href={activeServiceSlug ? `/services/${activeServiceSlug}/feed.json` : "/api/feed.json"}
    />

    <!-- Google Fonts Preconnect & Async Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap"
      />
    </noscript>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Google Cloud Radar" />
    <meta property="og:image" content={new URL(ogImage, canonicalURL.origin)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(ogImage, canonicalURL.origin)}
    />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={jsonLd} />

    {posthogKey && (
      <script is:inline define:vars={{ posthogKey, posthogHost }}>
        (function () {
          var host = window.location.hostname;
          var isLocal = host === 'localhost' || host === '127.0.0.1' || host.endsWith('.local');
          var debugLocal = false;
          try {
            debugLocal = window.location.search.indexOf('posthog_debug=1') !== -1 || window.localStorage.getItem('posthog_debug') === '1';
          } catch (e) {}
          if (isLocal && !debugLocal) {
            return;
          }
          !function (t, e) {
            var o, n, p, r;
            if (!e.__SV) {
              window.posthog = e;
              e._i = [];
              e.init = function (i, s, a) {
                function g(target, name) {
                  var parts = name.split('.');
                  if (parts.length === 2) {
                    target = target[parts[0]];
                    name = parts[1];
                  }
                  target[name] = function () {
                    target.push([name].concat(Array.prototype.slice.call(arguments, 0)));
                  };
                }
                (p = t.createElement('script')).type = 'text/javascript';
                p.crossOrigin = 'anonymous';
                p.async = true;
                p.src = s.api_host.replace(/\/+$/, '').replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js';
                (r = t.getElementsByTagName('script')[0]).parentNode.insertBefore(p, r);
                var u = e;
                if (a !== undefined) {
                  u = e[a] = [];
                } else {
                  a = 'posthog';
                }
                u.people = u.people || [];
                u.toString = function (noStub) {
                  var str = 'posthog';
                  if (a !== 'posthog') str += '.' + a;
                  if (!noStub) str += ' (stub)';
                  return str;
                };
                u.people.toString = function () {
                  return u.toString(1) + '.people (stub)';
                };
                o = 'init capture register register_once unregister opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId setPersonProperties identify alias people.set people.set_once people.unset set_config get_distinct_id get_session_id'.split(' ');
                for (n = 0; n < o.length; n++) g(u, o[n]);
                e._i.push([i, s, a]);
              };
              e.__SV = 1;
            }
          }(document, window.posthog || []);
          window.posthog.init(posthogKey, {
            api_host: posthogHost,
            ui_host: 'https://eu.posthog.com',
            defaults: 'latest',
            person_profiles: 'identified_only',
          });
        })();
      </script>
    )}
  </head>
  <body>
    <Header currentPath={Astro.url.pathname} />

    <div class="app-layout">
      {
        showSidebar && (
          <Sidebar
            activeServiceSlug={activeServiceSlug}
            activeCategory={activeCategory}
          />
        )
      }
      <div id="sidebarBackdrop" class="sidebar-backdrop" aria-hidden="true"></div>
      <main class="main-container">
        <slot />
        <Footer />
      </main>
    </div>

    <AlertsModal />
    <ShareScoopModal />

    <style>
      .sidebar-backdrop {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(2px);
        z-index: 1150;
        opacity: 0;
        transition: opacity 0.25s ease;
      }

      .sidebar-backdrop.is-active {
        display: block;
        opacity: 1;
      }

      .copy-method-btn.copied {
        border-color: var(--google-green-border) !important;
        background-color: var(--google-green-subtle) !important;
      }
      .copy-method-btn.copied .method-rpc-tag {
        background-color: var(--google-green) !important;
        color: #ffffff !important;
      }
      .copy-method-btn.copied .method-name {
        color: var(--google-green) !important;
      }
    </style>

    <script is:inline>
      // Global copy-to-clipboard handler for method buttons without layout shift
      document.addEventListener("click", (e) => {
        const target = e.target.closest(".copy-method-btn");
        if (!target) return;
        const textToCopy = target.getAttribute("data-copy");
        if (textToCopy) {
          navigator.clipboard.writeText(textToCopy).then(() => {
            target.classList.add("copied");
            const tag = target.querySelector(".method-rpc-tag");
            const originalTagText = tag ? tag.textContent : "";
            if (tag) tag.textContent = "COPIED";
            setTimeout(() => {
              target.classList.remove("copied");
              if (tag) tag.textContent = originalTagText;
            }, 1500);
          });
        }
      });
    </script>
  </body>
</html>
