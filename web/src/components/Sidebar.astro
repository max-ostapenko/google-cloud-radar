---
import { getServicesList, type Ecosystem, type ServiceCategory, type ServiceInfo } from '../lib/feed';

interface Props {
  activeServiceSlug?: string;
  activeCategory?: string;
}

const { activeServiceSlug = '', activeCategory = '' } = Astro.props;

const services: ServiceInfo[] = await getServicesList();
const totalUpdates = services.reduce((a, b) => a + b.count, 0);
const totalBreaking = services.reduce((a, b) => a + b.breakingCount, 0);

// Top-Level Ecosystems configuration
interface EcosystemGroup {
  id: Ecosystem;
  label: string;
  icon: string;
  totalCount: number;
  breakingCount: number;
  subgroups?: {
    category: ServiceCategory;
    items: ServiceInfo[];
    totalCount: number;
    breakingCount: number;
  }[];
  directItems?: ServiceInfo[];
}

const cloudSubcategories: ServiceCategory[] = [
  'AI & ML',
  'Data Analytics',
  'Application Development',
  'FinOps & Billing',
];

const cloudServices = services.filter((s) => s.ecosystem === 'Google Cloud');
const cloudSubgroups = cloudSubcategories.map((category) => {
  const items = cloudServices.filter((s) => s.category === category);
  return {
    category,
    items,
    totalCount: items.reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: items.reduce((acc, curr) => acc + curr.breakingCount, 0),
  };
}).filter((g) => g.items.length > 0);

const ecosystemList: EcosystemGroup[] = [
  {
    id: 'Google Cloud',
    label: 'Google Cloud',
    icon: 'cloud',
    totalCount: cloudServices.reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: cloudServices.reduce((acc, curr) => acc + curr.breakingCount, 0),
    subgroups: cloudSubgroups,
  },
  {
    id: 'Workspace',
    label: 'Workspace',
    icon: 'briefcase',
    totalCount: services.filter((s) => s.ecosystem === 'Workspace').reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: services.filter((s) => s.ecosystem === 'Workspace').reduce((acc, curr) => acc + curr.breakingCount, 0),
    directItems: services.filter((s) => s.ecosystem === 'Workspace'),
  },
  {
    id: 'Marketing Platform',
    label: 'Marketing Platform',
    icon: 'trending-up',
    totalCount: services.filter((s) => s.ecosystem === 'Marketing Platform').reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: services.filter((s) => s.ecosystem === 'Marketing Platform').reduce((acc, curr) => acc + curr.breakingCount, 0),
    directItems: services.filter((s) => s.ecosystem === 'Marketing Platform'),
  },
  {
    id: 'Chrome',
    label: 'Chrome & Web',
    icon: 'globe',
    totalCount: services.filter((s) => s.ecosystem === 'Chrome').reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: services.filter((s) => s.ecosystem === 'Chrome').reduce((acc, curr) => acc + curr.breakingCount, 0),
    directItems: services.filter((s) => s.ecosystem === 'Chrome'),
  },
  {
    id: 'Personal',
    label: 'Personal',
    icon: 'user',
    totalCount: services.filter((s) => s.ecosystem === 'Personal').reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: 0,
    directItems: services.filter((s) => s.ecosystem === 'Personal'),
  },
  {
    id: 'Android',
    label: 'Android & Play',
    icon: 'smartphone',
    totalCount: services.filter((s) => s.ecosystem === 'Android').reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: 0,
    directItems: services.filter((s) => s.ecosystem === 'Android'),
  },
  {
    id: 'More',
    label: 'More / Core',
    icon: 'grid',
    totalCount: services.filter((s) => s.ecosystem === 'More').reduce((acc, curr) => acc + curr.count, 0),
    breakingCount: services.filter((s) => s.ecosystem === 'More').reduce((acc, curr) => acc + curr.breakingCount, 0),
    directItems: services.filter((s) => s.ecosystem === 'More'),
  },
];
---

<aside class="gcp-sidebar" id="gcpSidebar">
  <div class="sidebar-header">
    <div class="sidebar-title">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h7"/>
      </svg>
      <span>APIs & Services</span>
    </div>
    <div class="sidebar-header-right">
      <span class="total-services-badge">{services.length} Monitored</span>
      <button id="sidebarCloseBtn" class="sidebar-close-btn" aria-label="Close APIs & Services Drawer" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="sidebar-menu">
    <a href="/" class={`sidebar-item all-item ${!activeServiceSlug && !activeCategory ? 'active' : ''}`}>
      <span class="item-name">All Updates</span>
      <span class="item-count-group">
        <span class="item-count">{totalUpdates}</span>
        {totalBreaking > 0 && (
          <span class="item-breaking-pill" title={`${totalBreaking} breaking changes`}>⚠️ {totalBreaking}</span>
        )}
      </span>
    </a>

    <a href="/breaking" class={`sidebar-item breaking-item ${activeCategory === 'breaking' ? 'active' : ''}`}>
      <span class="item-name">⚠️ Breaking Changes</span>
      <span class="item-badge-breaking">{totalBreaking} Alerts</span>
    </a>

    <div class="sidebar-divider"></div>

    <!-- Sidebar Search & Quick Filter Pills -->
    <div class="sidebar-search-container">
      <div class="sidebar-search-wrapper">
        <svg class="search-input-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          id="sidebar-search-input"
          class="sidebar-search-input"
          placeholder="Search services... (/)"
          aria-label="Search sidebar services"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="sidebar-search-kbd" id="sidebar-kbd-hint">/</kbd>
        <button
          type="button"
          id="sidebar-clear-search"
          class="sidebar-clear-btn"
          aria-label="Clear sidebar search"
          style="display: none;"
        >
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="sidebar-filter-pills" role="tablist" aria-label="Category quick filters">
        <button type="button" class="sidebar-pill-btn active" data-filter="all">All</button>
        <button type="button" class="sidebar-pill-btn" data-filter="Google Cloud">GCP</button>
        <button type="button" class="sidebar-pill-btn" data-filter="AI & ML">AI & ML</button>
        <button type="button" class="sidebar-pill-btn" data-filter="Data Analytics">Data</button>
        <button type="button" class="sidebar-pill-btn" data-filter="Workspace">Workspace</button>
        <button type="button" class="sidebar-pill-btn pill-breaking" data-filter="breaking">⚠️ Breaking</button>
      </div>
    </div>

    <!-- Hierarchy: Top Level Ecosystems -->
    <div class="ecosystem-container" id="sidebarEcosystemContainer">
      {ecosystemList.map((eco) => (
        <div class="ecosystem-section" data-ecosystem={eco.id}>
          <div class="ecosystem-header">
            <div class="ecosystem-label">
              {eco.icon === 'cloud' && (
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>
                </svg>
              )}
              {eco.icon === 'briefcase' && (
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              )}
              {eco.icon === 'trending-up' && (
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                  <polyline points="17 6 23 6 23 12"/>
                </svg>
              )}
              {eco.icon === 'globe' && (
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              )}
              {eco.icon === 'user' && (
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              )}
              {eco.icon === 'smartphone' && (
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
                  <line x1="12" y1="18" x2="12.01" y2="18"/>
                </svg>
              )}
              {eco.icon === 'grid' && (
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="7" height="7"/>
                  <rect x="14" y="3" width="7" height="7"/>
                  <rect x="14" y="14" width="7" height="7"/>
                  <rect x="3" y="14" width="7" height="7"/>
                </svg>
              )}
              <span>{eco.label}</span>
            </div>
            <div class="ecosystem-badge-group">
              {eco.breakingCount > 0 && (
                <span class="badge-breaking-micro" title={`${eco.breakingCount} breaking`}>⚠️{eco.breakingCount}</span>
              )}
              <span class={`ecosystem-badge ${eco.totalCount === 0 ? 'empty-badge' : ''}`}>
                {eco.totalCount}
              </span>
            </div>
          </div>

          <!-- Second Level: Google Cloud Subcategories (Visible by Default) -->
          {eco.subgroups && (
            <div class="subgroup-container">
              {eco.subgroups.map((sub) => (
                <div class="category-group" data-category={sub.category}>
                  <div class="category-title">
                    <span>{sub.category}</span>
                    <div class="category-counts-group">
                      {sub.breakingCount > 0 && (
                        <span class="category-breaking" title={`${sub.breakingCount} breaking`}>⚠️{sub.breakingCount}</span>
                      )}
                      <span class="category-count">{sub.totalCount}</span>
                    </div>
                  </div>
                  <ul class="service-list">
                    {sub.items.map((item) => (
                      <li
                        class="sidebar-service-item"
                        data-slug={item.slug}
                        data-service={item.service}
                        data-category={item.category}
                        data-ecosystem={eco.id}
                        data-breaking={item.breakingCount > 0 ? 'true' : 'false'}
                      >
                        <a
                          href={`/services/${item.slug}`}
                          class={`service-link ${activeServiceSlug === item.slug ? 'active' : ''}`}
                          title={`${item.service} (${item.count} updates${item.breakingCount > 0 ? `, ${item.breakingCount} breaking` : ''})`}
                        >
                          <span class="service-name">{item.service}</span>
                          <span class="service-counts-group">
                            {item.breakingCount > 0 && (
                              <span class="service-breaking-inline" title={`${item.breakingCount} breaking changes`}>⚠️ {item.breakingCount}</span>
                            )}
                            <span class="service-count">{item.count}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}

          <!-- Direct Items for other ecosystems -->
          {eco.directItems && eco.directItems.length > 0 && (
            <ul class="service-list direct-list">
              {eco.directItems.map((item) => (
                <li
                  class="sidebar-service-item"
                  data-slug={item.slug}
                  data-service={item.service}
                  data-category={item.category}
                  data-ecosystem={eco.id}
                  data-breaking={item.breakingCount > 0 ? 'true' : 'false'}
                >
                  <a
                    href={`/services/${item.slug}`}
                    class={`service-link ${activeServiceSlug === item.slug ? 'active' : ''}`}
                    title={`${item.service} (${item.count} updates${item.breakingCount > 0 ? `, ${item.breakingCount} breaking` : ''})`}
                  >
                    <span class="service-name">{item.service}</span>
                    <span class="service-counts-group">
                      {item.breakingCount > 0 && (
                        <span class="service-breaking-inline" title={`${item.breakingCount} breaking changes`}>⚠️ {item.breakingCount}</span>
                      )}
                      <span class="service-count">{item.count}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {(!eco.directItems || eco.directItems.length === 0) && (!eco.subgroups || eco.subgroups.length === 0) && (
            <div class="empty-ecosystem-msg">No monitored APIs</div>
          )}
        </div>
      ))}
    </div>

    <!-- Empty Search Results State -->
    <div id="sidebar-no-results" class="sidebar-no-results" style="display: none;">
      <p class="no-results-title">No matching services</p>
      <p class="no-results-sub">Try searching another service or reset active filters.</p>
      <button type="button" id="sidebar-reset-btn" class="sidebar-reset-btn">Reset Filters</button>
    </div>
  </div>

  <div class="sidebar-footer">
    <div class="radar-status-card">
      <div class="status-indicator">
        <span class="status-pulse"></span>
        <span class="status-text">Discovery Ingestion Active</span>
      </div>
      <p class="status-desc">Tracking Google Discovery Service in real-time.</p>
    </div>
    <div class="sidebar-creator-credit">
      <a href="https://github.com/max-ostapenko/google-cloud-radar" target="_blank" rel="noopener noreferrer">GitHub Repository</a>
    </div>
  </div>
</aside>

<style>
  .gcp-sidebar {
    width: var(--sidebar-width);
    background-color: var(--bg-surface);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    height: calc(100vh - var(--header-height));
    position: sticky;
    top: var(--header-height);
    flex-shrink: 0;
    overflow-y: auto;
  }

  .sidebar-header {
    padding: 16px;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sidebar-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-secondary);
  }

  .total-services-badge {
    font-size: 11px;
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    padding: 2px 6px;
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  .sidebar-menu {
    padding: 12px 8px;
    flex: 1;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    margin-bottom: 2px;
    transition: all 0.15s ease;
  }

  .sidebar-item:hover {
    background-color: var(--bg-surface-hover);
    text-decoration: none;
  }

  .sidebar-item.active {
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    font-weight: 600;
  }

  .item-count-group {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .item-count {
    font-size: 11px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .item-breaking-pill {
    font-size: 10px;
    font-weight: 700;
    background-color: var(--google-red-subtle);
    color: var(--google-red);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .breaking-item {
    color: var(--google-red);
  }

  .breaking-item.active {
    background-color: var(--google-red-subtle);
    color: var(--google-red);
  }

  .item-badge-breaking {
    font-size: 10px;
    font-weight: 700;
    background-color: var(--google-red);
    color: #ffffff;
    padding: 1px 6px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .sidebar-divider {
    height: 1px;
    background-color: var(--border-subtle);
    margin: 12px 4px;
  }

  /* Sidebar Search & Filter Box */
  .sidebar-search-container {
    margin-bottom: 12px;
  }

  .sidebar-search-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition: all 0.15s ease;
  }

  .sidebar-search-wrapper:focus-within {
    border-color: var(--google-blue);
    box-shadow: 0 0 0 2px var(--google-blue-subtle);
    background-color: var(--bg-primary);
  }

  .sidebar-search-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    font-size: 12px;
    font-family: inherit;
    color: var(--text-primary);
    padding: 6px 26px 6px 28px;
  }

  .sidebar-search-input::placeholder {
    color: var(--text-tertiary);
  }

  .search-input-icon {
    position: absolute;
    left: 8px;
    color: var(--text-tertiary);
    pointer-events: none;
  }

  .sidebar-search-kbd {
    position: absolute;
    right: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    color: var(--text-tertiary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    padding: 0 4px;
    line-height: 1.4;
    pointer-events: none;
  }

  .sidebar-clear-btn {
    position: absolute;
    right: 6px;
    background: transparent;
    border: none;
    padding: 2px;
    color: var(--text-tertiary);
    cursor: pointer;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease;
  }

  .sidebar-clear-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface);
  }

  /* Quick Filter Pills */
  .sidebar-filter-pills {
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    padding-top: 8px;
    padding-bottom: 4px;
    scrollbar-width: none;
  }

  .sidebar-filter-pills::-webkit-scrollbar {
    display: none;
  }

  .sidebar-pill-btn {
    font-size: 11px;
    font-weight: 500;
    font-family: inherit;
    padding: 3px 8px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface-hover);
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    flex-shrink: 0;
  }

  .sidebar-pill-btn:hover {
    background-color: var(--border-subtle);
    color: var(--text-primary);
  }

  .sidebar-pill-btn.active {
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    border-color: var(--google-blue);
    font-weight: 600;
  }

  .sidebar-pill-btn.pill-breaking.active {
    background-color: var(--google-red-subtle);
    color: var(--google-red);
    border-color: var(--google-red);
  }

  /* Empty Search Results */
  .sidebar-no-results {
    padding: 20px 12px;
    text-align: center;
    background-color: var(--bg-surface-hover);
    border-radius: var(--radius-md);
    margin-top: 12px;
    border: 1px dashed var(--border-subtle);
  }

  .no-results-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 4px 0;
  }

  .no-results-sub {
    font-size: 11px;
    color: var(--text-tertiary);
    margin: 0 0 10px 0;
    line-height: 1.4;
  }

  .sidebar-reset-btn {
    font-size: 11px;
    font-weight: 600;
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    border: none;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sidebar-reset-btn:hover {
    background-color: var(--google-blue);
    color: #ffffff;
  }

  /* Ecosystem Containers */
  .ecosystem-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ecosystem-section {
    border-radius: var(--radius-sm);
  }

  .ecosystem-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    background-color: var(--bg-surface-hover);
    border-radius: var(--radius-sm);
    margin-bottom: 6px;
  }

  .ecosystem-label {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-primary);
  }

  .ecosystem-badge-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .badge-breaking-micro {
    font-size: 9px;
    font-weight: 700;
    color: var(--google-red);
    background-color: var(--google-red-subtle);
    padding: 1px 4px;
    border-radius: 3px;
    font-family: var(--font-mono);
  }

  .ecosystem-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    background-color: var(--border-subtle);
    color: var(--text-secondary);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .ecosystem-badge.empty-badge {
    opacity: 0.5;
    font-weight: 400;
  }

  .subgroup-container {
    padding-left: 6px;
    border-left: 1px dashed var(--border-subtle);
    margin-left: 6px;
  }

  .category-group {
    margin-bottom: 10px;
  }

  .category-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 10px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
  }

  .category-counts-group {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .category-breaking {
    font-size: 9px;
    color: var(--google-red);
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .category-count {
    font-family: var(--font-mono);
    font-size: 9px;
  }

  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .direct-list {
    padding-left: 6px;
    border-left: 1px dashed var(--border-subtle);
    margin-left: 6px;
  }

  .service-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    font-size: 12.5px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .service-link:hover {
    background-color: var(--bg-surface-hover);
    color: var(--text-primary);
    text-decoration: none;
  }

  .service-link.active {
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    font-weight: 600;
    border-left: 2.5px solid var(--google-blue);
  }

  .service-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .service-counts-group {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: 8px;
    flex-shrink: 0;
  }

  .service-breaking-inline {
    font-size: 10px;
    font-weight: 700;
    color: var(--google-red);
    background-color: var(--google-red-subtle);
    padding: 0 4px;
    border-radius: 3px;
    font-family: var(--font-mono);
  }

  .service-count {
    font-size: 10.5px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .empty-ecosystem-msg {
    padding: 4px 10px;
    font-size: 11px;
    color: var(--text-tertiary);
    font-style: italic;
    margin-left: 8px;
  }

  .sidebar-footer {
    padding: 14px 16px;
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .radar-status-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 10px 12px;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .status-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--google-green);
    box-shadow: 0 0 0 2px var(--google-green-subtle);
    animation: pulse 2s infinite;
  }

  .status-text {
    font-size: 11px;
    font-weight: 600;
    color: var(--google-green);
  }

  .status-desc {
    font-size: 11px;
    color: var(--text-tertiary);
    line-height: 1.4;
    margin: 0;
  }

  .sidebar-creator-credit {
    font-size: 11.5px;
    color: var(--text-tertiary);
    text-align: center;
  }

  .sidebar-creator-credit a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
  }

  .sidebar-creator-credit a:hover {
    color: var(--google-blue);
    text-decoration: underline;
  }

  .sidebar-header-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sidebar-close-btn {
    display: none;
    background: transparent;
    border: none;
    padding: 4px;
    color: var(--text-secondary);
    cursor: pointer;
    border-radius: var(--radius-sm);
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
  }

  .sidebar-close-btn:hover {
    background-color: var(--bg-surface-hover);
    color: var(--text-primary);
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 168, 83, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 4px rgba(52, 168, 83, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(52, 168, 83, 0); }
  }

  @media (max-width: 900px) {
    .gcp-sidebar {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      width: 300px;
      max-width: 85vw;
      height: 100vh;
      z-index: 1200;
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: none;
    }

    .gcp-sidebar.is-open {
      transform: translateX(0);
      box-shadow: 0 0 32px rgba(0, 0, 0, 0.5);
    }

    .sidebar-close-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  import MiniSearch from 'minisearch';

  function initSidebarDrawer() {
    const sidebar = document.getElementById('gcpSidebar');
    const toggleBtn = document.getElementById('mobileSidebarToggle');
    const closeBtn = document.getElementById('sidebarCloseBtn');
    const backdrop = document.getElementById('sidebarBackdrop');

    function openSidebar() {
      if (sidebar) sidebar.classList.add('is-open');
      if (backdrop) backdrop.classList.add('is-active');
      document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
      if (sidebar) sidebar.classList.remove('is-open');
      if (backdrop) backdrop.classList.remove('is-active');
      document.body.style.overflow = '';
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (sidebar?.classList.contains('is-open')) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    closeBtn?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });

    sidebar?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 900) {
          closeSidebar();
        }
      });
    });
  }

  function initSidebarSearch() {
    const sidebar = document.getElementById('gcpSidebar');
    if (!sidebar) return;

    const searchInput = document.getElementById('sidebar-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('sidebar-clear-search') as HTMLButtonElement | null;
    const kbdHint = document.getElementById('sidebar-kbd-hint');
    const pillBtns = sidebar.querySelectorAll('.sidebar-pill-btn') as NodeListOf<HTMLButtonElement>;
    const serviceItems = sidebar.querySelectorAll('.sidebar-service-item') as NodeListOf<HTMLElement>;
    const categoryGroups = sidebar.querySelectorAll('.category-group') as NodeListOf<HTMLElement>;
    const ecosystemSections = sidebar.querySelectorAll('.ecosystem-section') as NodeListOf<HTMLElement>;
    const noResultsEl = document.getElementById('sidebar-no-results');
    const resetBtn = document.getElementById('sidebar-reset-btn');
    const totalBadge = sidebar.querySelector('.total-services-badge');

    if (!serviceItems.length) return;

    // Build MiniSearch Index across rendered service items
    const documents: Array<{ id: string; service: string; category: string; ecosystem: string; slug: string }> = [];
    serviceItems.forEach((item) => {
      const slug = item.getAttribute('data-slug') || '';
      const service = item.getAttribute('data-service') || '';
      const category = item.getAttribute('data-category') || '';
      const ecosystem = item.getAttribute('data-ecosystem') || '';
      documents.push({
        id: slug,
        slug,
        service,
        category,
        ecosystem,
      });
    });

    const miniSearch = new MiniSearch({
      fields: ['service', 'category', 'ecosystem', 'slug'],
      storeFields: ['id'],
      searchOptions: {
        boost: { service: 3.0, slug: 2.0, category: 1.5 },
        fuzzy: 0.25,
        prefix: true,
        combineWith: 'AND',
      },
    });

    miniSearch.addAll(documents);

    let currentQuery = '';
    let activeFilter = 'all';

    // Read initial parameters from URL
    const urlParams = new URLSearchParams(window.location.search);
    const initialQ = urlParams.get('sq') || urlParams.get('sidebar_q') || urlParams.get('q') || '';
    const initialCat = urlParams.get('category') || urlParams.get('scat') || urlParams.get('filter') || '';

    if (initialQ && searchInput) {
      searchInput.value = initialQ;
      currentQuery = initialQ;
    }

    if (initialCat) {
      const normalizedCat = initialCat.toLowerCase().trim();
      pillBtns.forEach((btn) => {
        const btnFilter = (btn.getAttribute('data-filter') || '').toLowerCase();
        if (
          btnFilter === normalizedCat ||
          (btnFilter === 'google cloud' && (normalizedCat === 'cloud' || normalizedCat === 'gcp' || normalizedCat === 'google-cloud')) ||
          (btnFilter === 'ai & ml' && (normalizedCat === 'ai' || normalizedCat === 'category-ai' || normalizedCat === 'ai_ml' || normalizedCat === 'ai & ml')) ||
          (btnFilter === 'data analytics' && (normalizedCat === 'data' || normalizedCat === 'category-data' || normalizedCat === 'data_analytics' || normalizedCat === 'data analytics')) ||
          (btnFilter === 'workspace' && normalizedCat === 'workspace') ||
          (btnFilter === 'breaking' && normalizedCat === 'breaking')
        ) {
          activeFilter = btn.getAttribute('data-filter') || 'all';
        }
      });
    }

    // Update active class on pills
    pillBtns.forEach((btn) => {
      if (btn.getAttribute('data-filter') === activeFilter) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    function updateUrlState() {
      const params = new URLSearchParams(window.location.search);
      if (currentQuery.trim()) {
        params.set('sq', currentQuery.trim());
      } else {
        params.delete('sq');
        params.delete('sidebar_q');
      }

      if (activeFilter !== 'all') {
        params.set('category', activeFilter);
      } else {
        params.delete('category');
        params.delete('scat');
      }

      const queryString = params.toString();
      const newUrl = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
      history.replaceState(null, '', newUrl);
    }

    function applyFilters() {
      const trimmedQ = currentQuery.trim().toLowerCase();
      let matchingSlugs: Set<string> | null = null;

      if (trimmedQ) {
        const msResults = miniSearch.search(trimmedQ);
        matchingSlugs = new Set(msResults.map((r) => r.id));

        // Substring fallback matching for high precision
        serviceItems.forEach((item) => {
          const slug = item.getAttribute('data-slug') || '';
          const service = (item.getAttribute('data-service') || '').toLowerCase();
          const category = (item.getAttribute('data-category') || '').toLowerCase();
          const ecosystem = (item.getAttribute('data-ecosystem') || '').toLowerCase();
          if (service.includes(trimmedQ) || slug.includes(trimmedQ) || category.includes(trimmedQ) || ecosystem.includes(trimmedQ)) {
            matchingSlugs!.add(slug);
          }
        });
      }

      let totalVisibleServices = 0;

      // Filter service items
      serviceItems.forEach((item) => {
        const slug = item.getAttribute('data-slug') || '';
        const ecosystem = item.getAttribute('data-ecosystem') || '';
        const category = item.getAttribute('data-category') || '';
        const isBreaking = item.getAttribute('data-breaking') === 'true';

        const matchesSearch = matchingSlugs === null || matchingSlugs.has(slug);

        let matchesFilter = true;
        if (activeFilter === 'breaking') {
          matchesFilter = isBreaking;
        } else if (activeFilter === 'Google Cloud') {
          matchesFilter = ecosystem === 'Google Cloud';
        } else if (activeFilter === 'AI & ML') {
          matchesFilter = category === 'AI & ML';
        } else if (activeFilter === 'Data Analytics') {
          matchesFilter = category === 'Data Analytics';
        } else if (activeFilter === 'Workspace') {
          matchesFilter = ecosystem === 'Workspace' || category === 'Workspace';
        } else if (activeFilter !== 'all') {
          matchesFilter = ecosystem === activeFilter || category === activeFilter;
        }

        const isVisible = matchesSearch && matchesFilter;
        item.style.display = isVisible ? '' : 'none';
        if (isVisible) totalVisibleServices++;
      });

      // Update category-group visibility and counts
      categoryGroups.forEach((catGroup) => {
        const visibleItemsInGroup = catGroup.querySelectorAll('.sidebar-service-item:not([style*="display: none"])');
        catGroup.style.display = visibleItemsInGroup.length > 0 ? '' : 'none';

        const countSpan = catGroup.querySelector('.category-count');
        if (countSpan) {
          countSpan.textContent = String(visibleItemsInGroup.length);
        }
      });

      // Update ecosystem-section visibility and counts
      ecosystemSections.forEach((ecoSection) => {
        const visibleItemsInEco = ecoSection.querySelectorAll('.sidebar-service-item:not([style*="display: none"])');
        ecoSection.style.display = visibleItemsInEco.length > 0 ? '' : 'none';

        const badgeSpan = ecoSection.querySelector('.ecosystem-badge');
        if (badgeSpan) {
          badgeSpan.textContent = String(visibleItemsInEco.length);
        }
      });

      // Update total badge / no results state
      if (totalBadge) {
        if (currentQuery.trim() || activeFilter !== 'all') {
          totalBadge.textContent = `${totalVisibleServices} Found`;
        } else {
          totalBadge.textContent = `${serviceItems.length} Monitored`;
        }
      }

      if (noResultsEl) {
        noResultsEl.style.display = totalVisibleServices === 0 ? 'block' : 'none';
      }

      // Toggle clear button and kbd hint
      if (clearBtn) {
        clearBtn.style.display = currentQuery ? 'flex' : 'none';
      }
      if (kbdHint) {
        kbdHint.style.display = currentQuery ? 'none' : 'inline-block';
      }
    }

    // Initial filter application
    applyFilters();

    // Input listener
    searchInput?.addEventListener('input', (e) => {
      currentQuery = (e.target as HTMLInputElement).value;
      applyFilters();
      updateUrlState();
    });

    // Focus / blur hint visibility
    searchInput?.addEventListener('focus', () => {
      if (kbdHint) kbdHint.style.display = 'none';
    });
    searchInput?.addEventListener('blur', () => {
      if (kbdHint && !currentQuery) kbdHint.style.display = 'inline-block';
    });

    // Clear button listener
    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        currentQuery = '';
        searchInput.focus();
      }
      applyFilters();
      updateUrlState();
    });

    // Filter pill listeners
    pillBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetFilter = btn.getAttribute('data-filter') || 'all';
        if (activeFilter === targetFilter && targetFilter !== 'all') {
          activeFilter = 'all';
        } else {
          activeFilter = targetFilter;
        }

        pillBtns.forEach((b) => {
          if (b.getAttribute('data-filter') === activeFilter) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });

        applyFilters();
        updateUrlState();
      });
    });

    // Reset button in empty state
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      currentQuery = '';
      activeFilter = 'all';

      pillBtns.forEach((b) => {
        if (b.getAttribute('data-filter') === 'all') b.classList.add('active');
        else b.classList.remove('active');
      });

      applyFilters();
      updateUrlState();
    });

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      const activeEl = document.activeElement;
      const isEditingText = activeEl && (
        activeEl.tagName === 'INPUT' ||
        activeEl.tagName === 'TEXTAREA' ||
        activeEl.tagName === 'SELECT' ||
        (activeEl as HTMLElement).isContentEditable
      );

      if (e.key === '/' && !isEditingText) {
        e.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k' && !isEditingText) {
        e.preventDefault();
        searchInput?.focus();
        searchInput?.select();
      } else if (e.key === 'Escape' && activeEl === searchInput) {
        if (currentQuery) {
          if (searchInput) searchInput.value = '';
          currentQuery = '';
          applyFilters();
          updateUrlState();
        } else {
          searchInput?.blur();
        }
      }
    });
  }

  initSidebarDrawer();
  initSidebarSearch();

  document.addEventListener('astro:page-load', () => {
    initSidebarDrawer();
    initSidebarSearch();
  });
</script>
