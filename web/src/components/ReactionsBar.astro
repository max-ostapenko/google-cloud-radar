---
interface Props {
  slug: string;
  title: string;
  initialStats?: {
    upvotes?: number;
    impacted_users_count?: number;
    comments_count?: number;
  };
  inHero?: boolean;
}

const { slug, title, initialStats = {}, inHero = false } = Astro.props;
const defaultLikeCount = initialStats.upvotes || 0;
const defaultReleasedCount = 0;
const defaultFpCount = 0;
---

<div class={`reactions-bar-container ${inHero ? 'in-hero' : ''}`} data-slug={slug}>
  <div class="reactions-buttons">
    <button
      class="reaction-btn"
      data-type="like_change"
      title="Like this API change"
      aria-label="Like the change"
    >
      <span class="btn-icon">👍</span>
      <span class="btn-label">Like the change</span>
      <span class="count-badge" data-count-type="like_change">{defaultLikeCount}</span>
    </button>

    <button
      class="reaction-btn"
      data-type="released"
      title="Mark that this change has been confirmed in official release notes or documentation"
      aria-label="Released"
    >
      <span class="btn-icon">🚀</span>
      <span class="btn-label">Released</span>
      <span class="count-badge" data-count-type="released">{defaultReleasedCount}</span>
    </button>

    <button
      class="reaction-btn"
      data-type="false_positive_or_duplicate"
      title="Flag this change as a false-positive detection or duplicate entry"
      aria-label="False-positive or duplicate"
    >
      <span class="btn-icon">🚩</span>
      <span class="btn-label">False-positive or duplicate</span>
      <span class="count-badge" data-count-type="false_positive_or_duplicate">{defaultFpCount}</span>
    </button>
  </div>
</div>

<script>
  import {
    $reactionsStore,
    initReactionsForSlug,
    getSlugReactions,
    toggleReaction,
    autoCleanSubscribe,
  } from '../lib/store';
  import type { ReactionType } from '../lib/firebase';

  function initReactionsBar() {
    autoCleanSubscribe(() => {
      const containers = document.querySelectorAll<HTMLElement>('.reactions-bar-container');
      const unsubs: Array<() => void> = [];

      containers.forEach((container) => {
        const slug = container.dataset.slug;
        if (!slug) return;

        initReactionsForSlug(slug);

        const buttons = container.querySelectorAll<HTMLButtonElement>('.reaction-btn');

        const unsub = $reactionsStore.subscribe(() => {
          const state = getSlugReactions(slug);
          buttons.forEach((btn) => {
            const type = btn.getAttribute('data-type') as ReactionType;
            if (type) {
              const countBadge = btn.querySelector(`[data-count-type="${type}"]`);
              if (countBadge) {
                countBadge.textContent = String(state.counts[type] || 0);
              }
              if (state.userVotes[type]) {
                btn.classList.add('active');
              } else {
                btn.classList.remove('active');
              }
            }
          });
        });

        unsubs.push(unsub);

        buttons.forEach((btn) => {
          const type = btn.getAttribute('data-type') as ReactionType;
          if (!type) return;

          const handleBtnClick = async (e: MouseEvent) => {
            e.preventDefault();
            e.stopPropagation();
            await toggleReaction(slug, type);
          };

          btn.addEventListener('click', handleBtnClick);
          unsubs.push(() => btn.removeEventListener('click', handleBtnClick));
        });
      });

      return unsubs;
    });
  }

  initReactionsBar();
  document.addEventListener('astro:page-load', initReactionsBar);
</script>

<style>
  .reactions-bar-container {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin: 24px 0;
  }

  .reactions-bar-container.in-hero {
    background-color: transparent;
    border: none;
    border-top: 1px solid var(--border-subtle);
    border-radius: 0;
    padding: 18px 0 0 0;
    margin: 20px 0 0 0;
  }

  .reactions-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .reaction-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    padding: 8px 14px;
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .reaction-btn:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-strong);
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  .reaction-btn.active,
  .reaction-btn[data-type="like_change"].active {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue);
    color: var(--google-blue);
  }

  .reaction-btn[data-type="released"].active {
    background-color: var(--google-green-subtle);
    border-color: var(--google-green);
    color: var(--google-green);
  }

  .reaction-btn[data-type="false_positive_or_duplicate"].active {
    background-color: var(--google-red-subtle);
    border-color: var(--google-red);
    color: var(--google-red);
  }

  .count-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    background-color: var(--border-subtle);
    color: var(--text-primary);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-weight: 700;
  }

  .reaction-btn.active .count-badge,
  .reaction-btn[data-type="like_change"].active .count-badge {
    background-color: var(--google-blue);
    color: #ffffff;
  }

  .reaction-btn[data-type="released"].active .count-badge {
    background-color: var(--google-green);
    color: #ffffff;
  }

  .reaction-btn[data-type="false_positive_or_duplicate"].active .count-badge {
    background-color: var(--google-red);
    color: #ffffff;
  }

  @media (max-width: 600px) {
    .reactions-buttons {
      flex-direction: column;
    }
    .reaction-btn {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
