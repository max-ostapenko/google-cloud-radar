---
interface Props {
  slug: string;
  helpfulCount?: number;
  notHelpfulCount?: number;
}

const { slug, helpfulCount = 0, notHelpfulCount = 0 } = Astro.props;
---

<div class="card-reactions-group reactions-bar-container" data-slug={slug}>
  <button 
    class={`card-reaction-btn reaction-btn ${helpfulCount > 0 ? 'has-count' : ''}`}
    data-type="like_change" 
    data-slug={slug}
    title="Helpful"
    aria-label="Helpful"
    type="button"
  >
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 10v12"></path>
      <path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h3"></path>
    </svg>
    <span class="reaction-count" data-count-type="like_change" style={helpfulCount > 0 ? '' : 'display: none;'}>{helpfulCount}</span>
  </button>

  <button 
    class={`card-reaction-btn reaction-btn ${notHelpfulCount > 0 ? 'has-count' : ''}`}
    data-type="false_positive_or_duplicate" 
    data-slug={slug}
    title="Not helpful"
    aria-label="Not helpful"
    type="button"
  >
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M17 14V2"></path>
      <path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-3"></path>
    </svg>
    <span class="reaction-count" data-count-type="false_positive_or_duplicate" style={notHelpfulCount > 0 ? '' : 'display: none;'}>{notHelpfulCount}</span>
  </button>
</div>

<script>
  import {
    getFirebaseAuth,
    signInWithGoogle,
    onAuthChange,
    toggleUserReaction,
    listenToChange,
    listenToUserReactions,
    type ReactionType,
  } from '../lib/firebase';

  function updateButtons(container: HTMLElement, userVotes: Record<string, boolean>) {
    const buttons = container.querySelectorAll<HTMLButtonElement>('.reaction-btn');
    buttons.forEach((btn) => {
      const type = btn.getAttribute('data-type') as ReactionType;
      if (type) {
        const countBadge = btn.querySelector('.reaction-count') as HTMLElement;
        const count = parseInt(countBadge?.textContent || '0', 10);
        if (userVotes[type]) {
          btn.classList.add('active');
          if (countBadge) countBadge.style.display = 'inline-block';
        } else {
          btn.classList.remove('active');
          if (countBadge) countBadge.style.display = count > 0 ? 'inline-block' : 'none';
        }
      }
    });
  }

  function initReactionsBar() {
    const containers = document.querySelectorAll<HTMLElement>('.reactions-bar-container');
    if (!containers.length) return;

    containers.forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const slug = container.dataset.slug;
      if (!slug) return;

      const storageKey = `gcp_radar_reactions_${slug}`;
      let userVotes: Record<string, boolean> = {};
      try {
        userVotes = JSON.parse(localStorage.getItem(storageKey) || '{}');
      } catch {}

      updateButtons(container, userVotes);

      // Listen to live total change counts from Firestore
      listenToChange(slug, (changeData) => {
        if (changeData?.reaction_counts) {
          const buttons = container.querySelectorAll<HTMLButtonElement>('.reaction-btn');
          buttons.forEach((btn) => {
            const type = btn.getAttribute('data-type') as ReactionType;
            if (type && changeData.reaction_counts?.[type] !== undefined) {
              const countBadge = btn.querySelector('.reaction-count') as HTMLElement;
              const val = Math.max(0, changeData.reaction_counts[type]);
              if (countBadge) {
                countBadge.textContent = String(val);
                countBadge.style.display = (val > 0 || userVotes[type]) ? 'inline-block' : 'none';
              }
              if (val > 0) btn.classList.add('has-count');
              else if (!userVotes[type]) btn.classList.remove('has-count');
            }
          });
        }
      });

      const buttons = container.querySelectorAll<HTMLButtonElement>('.reaction-btn');
      buttons.forEach((btn) => {
        const type = btn.getAttribute('data-type') as ReactionType;
        if (!type) return;

        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();

          const auth = getFirebaseAuth();
          let user = auth.currentUser;
          if (!user) {
            try {
              user = await signInWithGoogle();
            } catch {
              console.log('Sign in cancelled');
              return;
            }
          }
          if (!user) return;

          const countBadge = btn.querySelector('.reaction-count') as HTMLElement;
          const currentCount = parseInt(countBadge?.textContent || '0', 10);
          const isCurrent = Boolean(userVotes[type]);

          if (isCurrent) {
            userVotes[type] = false;
            btn.classList.remove('active');
            const newCount = Math.max(0, currentCount - 1);
            if (countBadge) {
              countBadge.textContent = String(newCount);
              countBadge.style.display = newCount > 0 ? 'inline-block' : 'none';
            }
            if (newCount === 0) btn.classList.remove('has-count');
          } else {
            userVotes[type] = true;
            btn.classList.add('active');
            const newCount = currentCount + 1;
            if (countBadge) {
              countBadge.textContent = String(newCount);
              countBadge.style.display = 'inline-block';
            }
            btn.classList.add('has-count');
          }

          try {
            localStorage.setItem(storageKey, JSON.stringify(userVotes));
          } catch {}

          await toggleUserReaction(slug, user, type, isCurrent).catch((err) => {
            console.error('Failed to sync reaction to Firestore:', err);
          });
        });
      });
    });
  }

  // Register onAuthChange listener once globally across all reaction containers
  let authListenerRegistered = false;
  if (!authListenerRegistered) {
    authListenerRegistered = true;
    onAuthChange((user) => {
      const containers = document.querySelectorAll<HTMLElement>('.reactions-bar-container');
      containers.forEach((container) => {
        const slug = container.dataset.slug;
        if (!slug) return;
        if (user) {
          listenToUserReactions(slug, user.uid, (liveVotes) => {
            const storageKey = `gcp_radar_reactions_${slug}`;
            try {
              localStorage.setItem(storageKey, JSON.stringify(liveVotes));
            } catch {}
            updateButtons(container, liveVotes);
          });
        } else {
          updateButtons(container, {});
        }
      });
    });
  }

  initReactionsBar();
  document.addEventListener('astro:page-load', initReactionsBar);
</script>

<style>
  .card-reactions-group {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .card-reaction-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-tertiary);
    background-color: transparent;
    border: 1px solid transparent;
    padding: 3px 7px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .card-reaction-btn:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-subtle);
    color: var(--text-primary);
  }

  .card-reaction-btn.has-count,
  .card-reaction-btn.active {
    background-color: var(--bg-surface);
    border-color: var(--border-subtle);
    color: var(--text-secondary);
  }

  .card-reaction-btn.active,
  .card-reaction-btn[data-type="like_change"].active {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue-border);
    color: var(--google-blue);
    font-weight: 600;
  }

  .card-reaction-btn[data-type="false_positive_or_duplicate"].active {
    background-color: var(--google-red-subtle);
    border-color: var(--google-red-border);
    color: var(--google-red);
    font-weight: 600;
  }

  .reaction-icon {
    font-size: 12px;
    line-height: 1;
  }

  .reaction-count {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    background-color: var(--bg-surface-hover);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border-subtle);
  }

  .card-reaction-btn.active .reaction-count,
  .card-reaction-btn[data-type="like_change"].active .reaction-count {
    background-color: #ffffff;
    border-color: var(--google-blue-border);
    color: var(--google-blue);
  }

  .card-reaction-btn[data-type="false_positive_or_duplicate"].active .reaction-count {
    background-color: #ffffff;
    border-color: var(--google-red-border);
    color: var(--google-red);
  }
</style>
