---
interface Props {
  slug: string;
  title: string;
  service: string;
  api: string;
  summary: string;
  methods?: string[];
  isBreaking?: boolean;
  leadTimeDays?: number;
}

const {
  slug,
  title,
  service,
  api,
  summary,
  methods = [],
  isBreaking = false,
  leadTimeDays = 14,
} = Astro.props;

const permalink = `https://gcp-discovery-radar.web.app/changes/${slug}`;
const methodHighlight = methods.length > 0 ? methods[0] : api;

const twitterText = `⚡ GCP Canary Scoop: Google Cloud just rolled out updates for ${service} (${api})${isBreaking ? ' [BREAKING]' : ''} before official release notes!

"${title}"
Targeted RPC: ${methodHighlight}

Track the pre-release diff on @GCPDiscovery:
${permalink}

#GCP #GoogleCloud #DevOps #CloudEngineering #DataPlatform`;

const linkedInText = `🚀 Early Google Cloud Discovery Signal: ${service} API Update

Google Cloud has published unpublished changes to the ${service} discovery control plane before official release documentation (avg. ${leadTimeDays}-day lead time):

📌 Key Changes:
• Update: ${title}
• API: ${api}
• Impact: ${isBreaking ? '⚠️ Breaking Incompatibility' : '✨ New Feature / RPC Extensions'}
${methods.length > 0 ? `• Key Method: ${methods.slice(0, 3).join(', ')}` : ''}

Summary:
${summary}

${methods.length > 0 ? `• Key Method: ${methods.slice(0, 3).join(', ')}` : ''}

Summary:
${summary}

Inspect the full schema diff and crowd-sourced impact signals on Google Cloud Radar:
${permalink}

#GoogleCloud #GCP #CloudArchitecture #SoftwareEngineering #DevOps #FinOps`;

const slackText = `*⚡ Google Cloud Radar Alert: ${service} (${api})* ${isBreaking ? ':warning: *[BREAKING]*' : ''}
*${title}*
>${summary}
${methods.length > 0 ? `*Targeted RPCs:* \`${methods.slice(0, 2).join('`, `')}\`\n` : ''}> *Radar Permalink:* <${permalink}|Inspect Schema Diff & Methods>`;

const redditTitle = `[Google Cloud Radar Signal] ${service}: ${title}${isBreaking ? ' [Breaking Change]' : ''}`;
const redditBody = `Google has updated the control plane for **${service}** (\`${api}\`) ahead of official release notes:

**Summary:**
${summary}

${methods.length > 0 ? `**Methods Updated:**\n${methods.map((m) => `- \`${m}\``).join('\n')}\n` : ''}
Tracked live on Google Cloud Radar:
${permalink}`;
---

<!-- Trigger Button -->
<button
  type="button"
  class="share-scoop-trigger-btn"
  data-modal-target={`share-modal-${slug}`}
  title="Share this API scoop on Twitter, LinkedIn, Slack, or Reddit"
  aria-label="Share API Scoop"
>
  <span class="btn-icon">🚀</span>
  <span>Share Scoop</span>
</button>

<!-- Modal Dialog -->
<div id={`share-modal-${slug}`} class="share-modal-backdrop" style="display: none;">
  <div class="share-modal-card" role="dialog" aria-modal="true" aria-labelledby={`modal-title-${slug}`}>
    <div class="modal-header">
      <div class="modal-title-group">
        <span class="modal-icon">🚀</span>
        <h3 id={`modal-title-${slug}`} class="modal-title">Share API Scoop</h3>
      </div>
      <button type="button" class="modal-close-btn" data-close-modal aria-label="Close modal">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="modal-tabs">
      <button type="button" class="tab-btn active" data-tab="twitter">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>Twitter / X</span>
      </button>
      <button type="button" class="tab-btn" data-tab="linkedin">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.92 0 1.66-.74 1.66-1.66 0-.91-.74-1.65-1.66-1.65-.91 0-1.65.74-1.65 1.65 0 .92.74 1.66 1.65 1.66m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
        </svg>
        <span>LinkedIn</span>
      </button>
      <button type="button" class="tab-btn" data-tab="slack">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M6 15a2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1 2-2h2v2zm1 0a2 2 0 0 1 2-2 2 2 0 0 1 2 2v5a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-5zm2-7a2 2 0 0 1-2-2 2 2 0 0 1 2-2 2 2 0 0 1 2 2v2H9zm0 1a2 2 0 0 1 2 2 2 2 0 0 1-2 2H4a2 2 0 0 1-2-2 2 2 0 0 1 2-2h5zm7 2a2 2 0 0 1 2-2 2 2 0 0 1 2 2 2 2 0 0 1-2 2h-2v-2zm-1 0a2 2 0 0 1-2 2 2 2 0 0 1-2-2V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2v5zm-2 7a2 2 0 0 1 2 2 2 2 0 0 1-2 2 2 2 0 0 1-2-2v-2h2zm0-1a2 2 0 0 1-2-2 2 2 0 0 1 2-2h5a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-5z"/>
        </svg>
        <span>Slack / Discord</span>
      </button>
      <button type="button" class="tab-btn" data-tab="reddit">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm5.8 11.2a1.8 1.8 0 0 1-2.4.2 7.6 7.6 0 0 0-6.8 0 1.8 1.8 0 0 1-2.4-.2 1.9 1.9 0 0 1 .3-2.6 1.8 1.8 0 0 1 2-.1 6.5 6.5 0 0 1 2.3-.6l1.3-4.1 3.2.7a1.3 1.3 0 0 1 1.3 1.3 1.3 1.3 0 0 1-1.3 1.3 1.3 1.3 0 0 1-1.3-1.1l-2.6-.6-1 3.4a6.6 6.6 0 0 1 2.4.6 1.8 1.8 0 0 1 2 .1 1.9 1.9 0 0 1 .3 2.6z"/>
        </svg>
        <span>Reddit</span>
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="tab-panel active" data-panel="twitter">
      <textarea class="snippet-textarea" readonly rows="7">{twitterText}</textarea>
      <div class="panel-actions">
        <span class="char-count">{twitterText.length} chars</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" data-copy-text={twitterText}>
            <span class="copy-icon">📋</span>
            <span>Copy Text</span>
          </button>
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(twitterText)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="intent-btn twitter-btn"
          >
            <span>Post on X</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="tab-panel" data-panel="linkedin">
      <textarea class="snippet-textarea" readonly rows="9">{linkedInText}</textarea>
      <div class="panel-actions">
        <span class="char-count">{linkedInText.length} chars</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" data-copy-text={linkedInText}>
            <span class="copy-icon">📋</span>
            <span>Copy Post</span>
          </button>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(permalink)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="intent-btn linkedin-btn"
          >
            <span>Share on LinkedIn</span>
          </a>
        </div>
      </div>
    </div>

    <div class="tab-panel" data-panel="slack">
      <textarea class="snippet-textarea" readonly rows="6">{slackText}</textarea>
      <div class="panel-actions">
        <span class="char-count">Slack Markdown</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" data-copy-text={slackText}>
            <span class="copy-icon">📋</span>
            <span>Copy Slack Markdown</span>
          </button>
        </div>
      </div>
    </div>

    <div class="tab-panel" data-panel="reddit">
      <div class="reddit-title-box">
        <label>Post Title:</label>
        <input type="text" readonly value={redditTitle} class="snippet-input" />
      </div>
      <label class="textarea-label">Post Body:</label>
      <textarea class="snippet-textarea" readonly rows="6">{redditBody}</textarea>
      <div class="panel-actions">
        <span class="char-count">r/googlecloud formatted</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" data-copy-text={`${redditTitle}\n\n${redditBody}`}>
            <span class="copy-icon">📋</span>
            <span>Copy All</span>
          </button>
          <a
            href={`https://www.reddit.com/r/googlecloud/submit?title=${encodeURIComponent(redditTitle)}&text=${encodeURIComponent(redditBody)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="intent-btn reddit-btn"
          >
            <span>Submit to r/googlecloud</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initShareScoop() {
    // Open Modal
    document.querySelectorAll('.share-scoop-trigger-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-modal-target');
        if (targetId) {
          const modal = document.getElementById(targetId);
          if (modal) modal.style.display = 'flex';
        }
      });
    });

    // Close Modal
    document.querySelectorAll('.share-modal-backdrop').forEach((backdrop) => {
      backdrop.addEventListener('click', (e) => {
        if (e.target === backdrop) backdrop.style.display = 'none';
      });

      backdrop.querySelectorAll('[data-close-modal]').forEach((closeBtn) => {
        closeBtn.addEventListener('click', () => {
          (backdrop as HTMLElement).style.display = 'none';
        });
      });
    });

    // Tab switching
    document.querySelectorAll('.modal-tabs').forEach((tabBar) => {
      const modal = tabBar.closest('.share-modal-card');
      if (!modal) return;

      tabBar.querySelectorAll('.tab-btn').forEach((tabBtn) => {
        tabBtn.addEventListener('click', () => {
          const tabName = tabBtn.getAttribute('data-tab');
          tabBar.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
          tabBtn.classList.add('active');

          modal.querySelectorAll('.tab-panel').forEach((p) => {
            p.classList.remove('active');
            if (p.getAttribute('data-panel') === tabName) {
              p.classList.add('active');
            }
          });
        });
      });
    });

    // Copy to clipboard buttons
    document.querySelectorAll('.copy-btn').forEach((copyBtn) => {
      copyBtn.addEventListener('click', async () => {
        const text = copyBtn.getAttribute('data-copy-text');
        if (text) {
          try {
            await navigator.clipboard.writeText(text);
            const originalHtml = copyBtn.innerHTML;
            copyBtn.innerHTML = '<span>✅ Copied!</span>';
            copyBtn.classList.add('copied');
            setTimeout(() => {
              copyBtn.innerHTML = originalHtml;
              copyBtn.classList.remove('copied');
            }, 2000);
          } catch (err) {
            console.error('Clipboard copy failed:', err);
          }
        }
      });
    });
  }

  initShareScoop();
  document.addEventListener('astro:page-load', initShareScoop);
</script>

<style>
  .share-scoop-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, rgba(66, 133, 244, 0.15), rgba(168, 85, 247, 0.15));
    border: 1px solid var(--google-blue);
    color: var(--text-primary);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .share-scoop-trigger-btn:hover {
    background: linear-gradient(135deg, rgba(66, 133, 244, 0.25), rgba(168, 85, 247, 0.25));
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(66, 133, 244, 0.25);
  }

  .share-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 16px;
  }

  .share-modal-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    width: 100%;
    max-width: 620px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .modal-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .modal-close-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
  }

  .modal-close-btn:hover {
    color: var(--text-primary);
  }

  .modal-tabs {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 8px;
    overflow-x: auto;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .tab-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface-hover);
  }

  .tab-btn.active {
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
  }

  .tab-panel {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .tab-panel.active {
    display: flex;
  }

  .snippet-textarea {
    width: 100%;
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 12px;
    font-family: inherit;
    font-size: 13px;
    color: var(--text-primary);
    line-height: 1.5;
    resize: none;
    box-sizing: border-box;
  }

  .snippet-input {
    width: 100%;
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    font-size: 13px;
    color: var(--text-primary);
    box-sizing: border-box;
    margin-top: 4px;
  }

  .reddit-title-box label,
  .textarea-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .panel-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }

  .char-count {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--text-tertiary);
  }

  .action-buttons {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .copy-btn:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-strong);
  }

  .copy-btn.copied {
    background-color: var(--google-green-subtle);
    color: var(--google-green);
    border-color: var(--google-green);
  }

  .intent-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    color: #ffffff;
    transition: opacity 0.15s ease;
  }

  .intent-btn:hover {
    opacity: 0.9;
    text-decoration: none;
  }

  .twitter-btn {
    background-color: #000000;
  }

  .linkedin-btn {
    background-color: #0a66c2;
  }

  .reddit-btn {
    background-color: #ff4500;
  }
</style>
