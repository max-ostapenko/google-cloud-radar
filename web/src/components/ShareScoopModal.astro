---
// Global Singleton Share Scoop Modal
---

<!-- Modal Dialog Backdrop (Global Viewport Centered) -->
<div id="globalShareModalBackdrop" class="share-modal-backdrop" style="display: none;" aria-hidden="true">
  <div class="share-modal-card" role="dialog" aria-modal="true" aria-labelledby="globalShareModalTitle">
    <div class="modal-header">
      <div class="modal-title-group">
        <svg class="modal-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <h3 id="globalShareModalTitle" class="modal-title">Share API Update</h3>
      </div>
      <button type="button" class="modal-close-btn" id="globalShareModalCloseBtn" aria-label="Close modal">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="modal-tabs">
      <button type="button" class="tab-btn active" data-tab="twitter">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>Twitter / X</span>
      </button>
      <button type="button" class="tab-btn" data-tab="linkedin">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c.92 0 1.66-.74 1.66-1.66 0-.91-.74-1.65-1.66-1.65-.91 0-1.65.74-1.65 1.65 0 .92.74 1.66 1.65 1.65m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
        </svg>
        <span>LinkedIn</span>
      </button>
      <button type="button" class="tab-btn" data-tab="slack">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M6 15a2 2 0 0 1-2 2 2 2 0 0 1-2-2 2 2 0 0 1 2-2h2v2zm1 0a2 2 0 0 1 2-2 2 2 0 0 1 2 2v5a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-5zm2-7a2 2 0 0 1-2-2 2 2 0 0 1 2-2 2 2 0 0 1 2 2v2H9zm0 1a2 2 0 0 1 2 2 2 2 0 0 1-2 2H4a2 2 0 0 1-2-2 2 2 0 0 1 2-2h5zm7 2a2 2 0 0 1 2-2 2 2 0 0 1 2 2 2 2 0 0 1-2 2h-2v-2zm-1 0a2 2 0 0 1-2 2 2 2 0 0 1-2-2V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2v5zm-2 7a2 2 0 0 1 2 2 2 2 0 0 1-2 2 2 2 0 0 1-2-2v-2h2zm0-1a2 2 0 0 1-2-2 2 2 0 0 1 2-2h5a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-5z"/>
        </svg>
        <span>Slack / Discord</span>
      </button>
      <button type="button" class="tab-btn" data-tab="reddit">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
          <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm5.8 11.2a1.8 1.8 0 0 1-2.4.2 7.6 7.6 0 0 0-6.8 0 1.8 1.8 0 0 1-2.4-.2 1.9 1.9 0 0 1 .3-2.6 1.8 1.8 0 0 1 2-.1 6.5 6.5 0 0 1 2.3-.6l1.3-4.1 3.2.7a1.3 1.3 0 0 1 1.3 1.3 1.3 1.3 0 0 1-1.3 1.3 1.3 1.3 0 0 1-1.3-1.1l-2.6-.6-1 3.4a6.6 6.6 0 0 1 2.4.6 1.8 1.8 0 0 1 2 .1 1.9 1.9 0 0 1 .3 2.6z"/>
        </svg>
        <span>Reddit</span>
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="tab-panel active" data-panel="twitter">
      <textarea id="shareTwitterTextarea" class="snippet-textarea" readonly rows="7"></textarea>
      <div class="panel-actions">
        <span id="shareTwitterCount" class="char-count">0 chars</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" id="shareTwitterCopyBtn">
            <span class="copy-icon">📋</span>
            <span>Copy Text</span>
          </button>
          <a
            id="shareTwitterIntentBtn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="intent-btn twitter-btn"
          >
            <span>Post on X</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="tab-panel" data-panel="linkedin">
      <textarea id="shareLinkedInTextarea" class="snippet-textarea" readonly rows="9"></textarea>
      <div class="panel-actions">
        <span id="shareLinkedInCount" class="char-count">0 chars</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" id="shareLinkedInCopyBtn">
            <span class="copy-icon">📋</span>
            <span>Copy Post</span>
          </button>
          <a
            id="shareLinkedInIntentBtn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="intent-btn linkedin-btn"
          >
            <span>Share on LinkedIn</span>
          </a>
        </div>
      </div>
    </div>

    <div class="tab-panel" data-panel="slack">
      <textarea id="shareSlackTextarea" class="snippet-textarea" readonly rows="6"></textarea>
      <div class="panel-actions">
        <span class="char-count">Slack Markdown</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" id="shareSlackCopyBtn">
            <span class="copy-icon">📋</span>
            <span>Copy Slack Markdown</span>
          </button>
        </div>
      </div>
    </div>

    <div class="tab-panel" data-panel="reddit">
      <div class="reddit-title-box">
        <label>Post Title:</label>
        <input type="text" id="shareRedditTitleInput" readonly class="snippet-input" />
      </div>
      <label class="textarea-label">Post Body:</label>
      <textarea id="shareRedditBodyTextarea" class="snippet-textarea" readonly rows="6"></textarea>
      <div class="panel-actions">
        <span class="char-count">r/googlecloud formatted</span>
        <div class="action-buttons">
          <button type="button" class="copy-btn" id="shareRedditCopyBtn">
            <span class="copy-icon">📋</span>
            <span>Copy All</span>
          </button>
          <a
            id="shareRedditIntentBtn"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="intent-btn reddit-btn"
          >
            <span>Submit to r/googlecloud</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  interface SharePayload {
    slug: string;
    title: string;
    service: string;
    api: string;
    summary: string;
    methods?: string[];
    isBreaking?: boolean;
    leadTimeDays?: number;
  }

  function initGlobalShareModal() {
    const backdrop = document.getElementById('globalShareModalBackdrop');
    const closeBtn = document.getElementById('globalShareModalCloseBtn');
    if (!backdrop) return;

    const twitterArea = document.getElementById('shareTwitterTextarea') as HTMLTextAreaElement;
    const twitterCount = document.getElementById('shareTwitterCount');
    const twitterIntent = document.getElementById('shareTwitterIntentBtn') as HTMLAnchorElement;

    const linkedInArea = document.getElementById('shareLinkedInTextarea') as HTMLTextAreaElement;
    const linkedInCount = document.getElementById('shareLinkedInCount');
    const linkedInIntent = document.getElementById('shareLinkedInIntentBtn') as HTMLAnchorElement;

    const slackArea = document.getElementById('shareSlackTextarea') as HTMLTextAreaElement;
    const redditTitle = document.getElementById('shareRedditTitleInput') as HTMLInputElement;
    const redditBody = document.getElementById('shareRedditBodyTextarea') as HTMLTextAreaElement;
    const redditIntent = document.getElementById('shareRedditIntentBtn') as HTMLAnchorElement;

    function openModal(data: SharePayload) {
      const permalink = `https://google-cloud-radar.com/changes/${data.slug}`;
      const methods = data.methods || [];
      const methodHighlight = methods.length > 0 ? methods[0] : data.api;

      const twitterText = `⚡ Google Cloud API Radar: Updates detected for ${data.service} (${data.api})${data.isBreaking ? ' [BREAKING]' : ''} ahead of official release notes!\n\n"${data.title}"\nTargeted Method: ${methodHighlight}\n\nTrack the pre-release diff on Google Cloud Radar:\n${permalink}\n\n#GCP #GoogleCloud #DevOps #CloudArchitecture`;

      const linkedInText = `Google Cloud API Update Signal: ${data.service}\n\nUnreleased changes detected in ${data.service} Google Discovery APIs before official release documentation:\n\n📌 Key Details:\n• Update: ${data.title}\n• API: ${data.api}\n• Impact: ${data.isBreaking ? '⚠️ Breaking Change' : '✨ New Feature / Method Extensions'}\n${methods.length > 0 ? `• Key Methods: ${methods.slice(0, 3).join(', ')}\n` : ''}\nSummary:\n${data.summary}\n\nInspect the full schema diff and crowd-sourced impact signals on Google Cloud Radar:\n${permalink}\n\n#GoogleCloud #GCP #CloudArchitecture #SoftwareEngineering #DevOps`;

      const slackText = `*Google Cloud API Update: ${data.service} (${data.api})* ${data.isBreaking ? ':warning: *[BREAKING]*' : ''}\n*${data.title}*\n>${data.summary}\n${methods.length > 0 ? `*Targeted Methods:* \`${methods.slice(0, 2).join('`, `')}\`\n` : ''}> *Radar Permalink:* <${permalink}|Inspect Schema Diff & Methods>`;

      const rTitle = `[Google Cloud Radar] ${data.service}: ${data.title}${data.isBreaking ? ' [Breaking Change]' : ''}`;
      const rBody = `New API changes detected for **${data.service}** (\`${data.api}\`) ahead of official release notes:\n\n**Summary:**\n${data.summary}\n\n${methods.length > 0 ? `**Methods Updated:**\n${methods.map((m) => `- \`${m}\``).join('\n')}\n` : ''}Tracked live on Google Cloud Radar:\n${permalink}`;

      if (twitterArea) twitterArea.value = twitterText;
      if (twitterCount) twitterCount.textContent = `${twitterText.length} chars`;
      if (twitterIntent) twitterIntent.href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(twitterText)}`;

      if (linkedInArea) linkedInArea.value = linkedInText;
      if (linkedInCount) linkedInCount.textContent = `${linkedInText.length} chars`;
      if (linkedInIntent) linkedInIntent.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(permalink)}`;

      if (slackArea) slackArea.value = slackText;
      if (redditTitle) redditTitle.value = rTitle;
      if (redditBody) redditBody.value = rBody;
      if (redditIntent) redditIntent.href = `https://www.reddit.com/r/googlecloud/submit?title=${encodeURIComponent(rTitle)}&text=${encodeURIComponent(rBody)}`;

      backdrop.style.display = 'flex';
      backdrop.setAttribute('aria-hidden', 'false');
    }

    function closeModal() {
      backdrop.style.display = 'none';
      backdrop.setAttribute('aria-hidden', 'true');
    }

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.style.display === 'flex') {
        closeModal();
      }
    });

    // Listen to global open event
    window.addEventListener('open_share_modal', (e: any) => {
      if (e.detail) openModal(e.detail);
    });

    // Intercept clicks on any share trigger button across the document
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.card-share-trigger-btn') as HTMLElement;
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();

      const slug = btn.getAttribute('data-share-slug') || '';
      const title = btn.getAttribute('data-share-title') || '';
      const service = btn.getAttribute('data-share-service') || '';
      const api = btn.getAttribute('data-share-api') || '';
      const summary = btn.getAttribute('data-share-summary') || '';
      let methods: string[] = [];
      try {
        methods = JSON.parse(btn.getAttribute('data-share-methods') || '[]');
      } catch {}
      const isBreaking = btn.getAttribute('data-share-breaking') === 'true';

      openModal({ slug, title, service, api, summary, methods, isBreaking });
    });

    // Tabs
    const tabs = backdrop.querySelectorAll('.tab-btn');
    const panels = backdrop.querySelectorAll('.tab-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab.getAttribute('data-tab');
        tabs.forEach((t) => t.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));

        tab.classList.add('active');
        const activePanel = backdrop.querySelector(`[data-panel="${targetTab}"]`);
        if (activePanel) activePanel.classList.add('active');
      });
    });

    // Copy Handlers
    const setupCopyBtn = (btnId: string, getText: () => string) => {
      const btn = document.getElementById(btnId);
      btn?.addEventListener('click', async () => {
        const text = getText();
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const orig = btn.innerHTML;
          btn.innerHTML = '<span>✅ Copied!</span>';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.innerHTML = orig;
            btn.classList.remove('copied');
          }, 1800);
        } catch (err) {
          console.error('Failed to copy', err);
        }
      });
    };

    setupCopyBtn('shareTwitterCopyBtn', () => twitterArea?.value || '');
    setupCopyBtn('shareLinkedInCopyBtn', () => linkedInArea?.value || '');
    setupCopyBtn('shareSlackCopyBtn', () => slackArea?.value || '');
    setupCopyBtn('shareRedditCopyBtn', () => `${redditTitle?.value || ''}\n\n${redditBody?.value || ''}`);
  }

  initGlobalShareModal();
  document.addEventListener('astro:page-load', initGlobalShareModal);
</script>

<style>
  .share-scoop-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .share-scoop-trigger-btn:hover {
    background-color: var(--bg-surface-hover);
    color: var(--google-blue);
    border-color: var(--google-blue-border);
  }

  .btn-icon {
    flex-shrink: 0;
  }

  .share-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 16px;
  }

  .share-modal-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    width: 100%;
    max-width: 620px;
    max-height: 90vh;
    overflow-y: auto;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
  }

  .modal-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .modal-icon {
    color: var(--google-blue);
  }

  .modal-close-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .modal-close-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface-hover);
  }

  .modal-tabs {
    display: flex;
    border-bottom: 1px solid var(--border-subtle);
    gap: 8px;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .tab-btn:hover {
    color: var(--text-primary);
  }

  .tab-btn.active {
    color: var(--google-blue);
    border-bottom-color: var(--google-blue);
  }

  .tab-panel {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .tab-panel.active {
    display: flex;
  }

  .snippet-textarea {
    width: 100%;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.5;
    resize: vertical;
  }

  .snippet-input {
    width: 100%;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 13px;
  }

  .reddit-title-box {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .reddit-title-box label, .textarea-label {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .panel-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .char-count {
    font-size: 12px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .action-buttons {
    display: flex;
    gap: 8px;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .copy-btn:hover {
    background-color: var(--border-subtle);
  }

  .copy-btn.copied {
    background-color: var(--google-green-subtle);
    color: var(--google-green);
    border-color: var(--google-green);
  }

  .intent-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    padding: 6px 14px;
    border-radius: var(--radius-md);
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .intent-btn:hover {
    opacity: 0.9;
  }

  .twitter-btn {
    background-color: #000000;
  }

  .linkedin-btn {
    background-color: #0a66c2;
  }

  .reddit-btn {
    background-color: #ff4500;
  }

  @media (max-width: 520px) {
    .share-modal-card {
      padding: 16px;
      gap: 14px;
    }

    .modal-tabs {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      gap: 4px;
    }

    .tab-btn {
      padding: 6px 10px;
      font-size: 12px;
      white-space: nowrap;
    }

    .panel-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .action-buttons {
      flex-direction: column;
      gap: 8px;
    }

    .copy-btn, .intent-btn {
      width: 100%;
      justify-content: center;
      padding: 8px 14px;
    }
  }
</style>
