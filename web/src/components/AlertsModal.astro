---
import { getServicesList } from '../lib/feed';

const services = await getServicesList();
// Sort popular services to top
const priorityServices = ['vertex-ai', 'bigquery', 'dataform', 'dataplex', 'looker', 'bigquery-reservation', 'data-catalog'];
const sortedServices = [...services].sort((a, b) => {
  const aPri = priorityServices.indexOf(a.slug);
  const bPri = priorityServices.indexOf(b.slug);
  if (aPri !== -1 && bPri !== -1) return aPri - bPri;
  if (aPri !== -1) return -1;
  if (bPri !== -1) return 1;
  return (a.service || '').localeCompare(b.service || '');
});
---

<div id="alertsModalBackdrop" class="alerts-modal-backdrop" style="display: none;" aria-hidden="true">
  <div class="alerts-modal" role="dialog" aria-modal="true" aria-labelledby="alertsModalTitle">
    <!-- Header -->
    <div class="alerts-modal-header">
      <div class="header-title-group">
        <div class="alerts-icon-badge">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
        </div>
        <div>
          <h2 id="alertsModalTitle" class="modal-title">Email Alert Preferences</h2>
          <span class="modal-subtitle">Stay notified of breaking changes and schema evolutions</span>
        </div>
      </div>
      <button id="closeAlertsModalBtn" class="close-modal-btn" type="button" aria-label="Close modal">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- State 1: Unauthenticated View (Google Sign-In CTA) -->
    <div id="alertsAuthLoggedOut" class="alerts-logged-out-state">
      <div class="benefits-card">
        <div class="benefit-row">
          <span class="benefit-icon">⚡</span>
          <div>
            <strong>Instant Breaking Alerts</strong>
            <p>Email notification within 1 hour of any removed method or breaking schema evolution.</p>
          </div>
        </div>
        <div class="benefit-row">
          <span class="benefit-icon">📬</span>
          <div>
            <strong>Weekly Monday Digest</strong>
            <p>Curated summary of new APIs, beta promotions, and high-impact updates.</p>
          </div>
        </div>
        <div class="benefit-row">
          <span class="benefit-icon">🔒</span>
          <div>
            <strong>Zero Spam Guarantee</strong>
            <p>1-click unsubscribe anytime. Only verified Google accounts.</p>
          </div>
        </div>
      </div>

      <button id="alertsGoogleSignInBtn" class="google-auth-btn" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Sign in with Google to Enable Alerts</span>
      </button>
    </div>

    <!-- State 2: Authenticated View (Preferences Manager) -->
    <div id="alertsAuthLoggedIn" class="alerts-logged-in-state" style="display: none;">
      <!-- User Profile Header -->
      <div class="user-profile-badge">
        <img id="alertsUserAvatar" class="alerts-avatar" src="" alt="User" />
        <div class="user-meta">
          <strong id="alertsUserName">Google Cloud Engineer</strong>
          <span class="user-email-row">
            <span id="alertsUserEmail">user@example.com</span>
            <span class="verified-badge">✓ Verified</span>
          </span>
        </div>
      </div>

      <!-- Alert Toggles -->
      <div class="pref-options-group">
        <label class="pref-toggle-card">
          <div class="pref-card-info">
            <div class="pref-title-row">
              <span class="pref-icon">⚠️</span>
              <strong>Instant Breaking Alerts</strong>
              <span class="recommended-pill">Recommended</span>
            </div>
            <p>Send an immediate email alert when a breaking change or schema removal is detected.</p>
          </div>
          <input type="checkbox" id="prefBreakingAlerts" class="toggle-checkbox" checked />
        </label>

        <label class="pref-toggle-card">
          <div class="pref-card-info">
            <div class="pref-title-row">
              <span class="pref-icon">📬</span>
              <strong>Monday Weekly Digest</strong>
            </div>
            <p>A concise Monday morning roundup of all new APIs, methods, and schema diffs.</p>
          </div>
          <input type="checkbox" id="prefWeeklyDigest" class="toggle-checkbox" checked />
        </label>
      </div>

      <!-- Scope Selector -->
      <div class="scope-section">
        <label class="scope-header-label">Alert Scope:</label>
        <div class="scope-radios">
          <label class="scope-radio-option">
            <input type="radio" name="alertScope" value="all" id="scopeAllServices" checked />
            <span>All Monitored Google Cloud APIs ({services.length} Services)</span>
          </label>
          <label class="scope-radio-option">
            <input type="radio" name="alertScope" value="custom" id="scopeCustomServices" />
            <span>Only Watched APIs</span>
          </label>
        </div>

        <!-- Custom Watched Services List -->
        <div id="customServicesList" class="custom-services-grid" style="display: none;">
          {sortedServices.map((service) => (
            <label class="service-checkbox-item">
              <input type="checkbox" class="service-pick-checkbox" value={service.slug} />
              <span class="service-pick-name">{service.service}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Actions -->
      <div class="modal-footer-actions">
        <button id="saveAlertPrefsBtn" class="save-prefs-btn" type="button">
          <span id="savePrefsBtnText">Save Preferences</span>
        </button>
        <button id="turnOffAlertsBtn" class="unsubscribe-btn" type="button">
          Turn off all alerts
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    signInWithGoogle,
    onAuthChange,
    getUserAlertPreferences,
    saveUserAlertPreferences,
    type UserAlertPreferences,
  } from '../lib/firebase';

  function initAlertsModal() {
    const backdrop = document.getElementById('alertsModalBackdrop');
    const closeBtn = document.getElementById('closeAlertsModalBtn');
    const loggedOutSection = document.getElementById('alertsAuthLoggedOut');
    const loggedInSection = document.getElementById('alertsAuthLoggedIn');
    const googleSignInBtn = document.getElementById('alertsGoogleSignInBtn');

    const userAvatar = document.getElementById('alertsUserAvatar') as HTMLImageElement;
    const userName = document.getElementById('alertsUserName');
    const userEmail = document.getElementById('alertsUserEmail');

    const prefBreaking = document.getElementById('prefBreakingAlerts') as HTMLInputElement;
    const prefWeekly = document.getElementById('prefWeeklyDigest') as HTMLInputElement;
    const scopeAll = document.getElementById('scopeAllServices') as HTMLInputElement;
    const scopeCustom = document.getElementById('scopeCustomServices') as HTMLInputElement;
    const customServicesGrid = document.getElementById('customServicesList');
    const serviceCheckboxes = document.querySelectorAll('.service-pick-checkbox') as NodeListOf<HTMLInputElement>;

    const saveBtn = document.getElementById('saveAlertPrefsBtn');
    const saveBtnText = document.getElementById('savePrefsBtnText');
    const turnOffBtn = document.getElementById('turnOffAlertsBtn');

    let currentUser: any = null;

    function openModal() {
      if (backdrop) {
        backdrop.style.display = 'flex';
        backdrop.setAttribute('aria-hidden', 'false');
      }
    }

    function closeModal() {
      if (backdrop) {
        backdrop.style.display = 'none';
        backdrop.setAttribute('aria-hidden', 'true');
      }
    }

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    // Listen to global open trigger
    window.addEventListener('open_alerts_modal', openModal);

    // Auto-open modal if deep-linked via email (?action=alerts or ?modal=alerts)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('action') === 'alerts' || urlParams.get('modal') === 'alerts') {
      openModal();
    }

    // Toggle custom services list visibility
    scopeAll?.addEventListener('change', () => {
      if (customServicesGrid) customServicesGrid.style.display = 'none';
    });
    scopeCustom?.addEventListener('change', () => {
      if (customServicesGrid) customServicesGrid.style.display = 'grid';
    });

    async function syncUserPrefs(user: any) {
      currentUser = user;
      if (!user) {
        if (loggedOutSection) loggedOutSection.style.display = 'block';
        if (loggedInSection) loggedInSection.style.display = 'none';
        return;
      }

      if (loggedOutSection) loggedOutSection.style.display = 'none';
      if (loggedInSection) loggedInSection.style.display = 'block';

      if (userAvatar) userAvatar.src = user.photoURL || 'https://www.gstatic.com/images/branding/product/2x/avatar_square_blue_512dp.png';
      if (userName) userName.textContent = user.displayName || 'Google Cloud Engineer';
      if (userEmail) userEmail.textContent = user.email || '';

      const prefs: UserAlertPreferences = await getUserAlertPreferences(user);
      if (prefBreaking) prefBreaking.checked = prefs.breakingAlerts;
      if (prefWeekly) prefWeekly.checked = prefs.weeklyDigest;

      if (prefs.allServices) {
        if (scopeAll) scopeAll.checked = true;
        if (customServicesGrid) customServicesGrid.style.display = 'none';
      } else {
        if (scopeCustom) scopeCustom.checked = true;
        if (customServicesGrid) customServicesGrid.style.display = 'grid';
      }

      const watchedSet = new Set(prefs.watchedServices || []);
      serviceCheckboxes.forEach((cb) => {
        cb.checked = watchedSet.has(cb.value);
      });
    }

    onAuthChange((user) => {
      syncUserPrefs(user);
    });

    googleSignInBtn?.addEventListener('click', async () => {
      try {
        const user = await signInWithGoogle();
        if (user) {
          await syncUserPrefs(user);
          // Auto-save default alert subscription on first login
          await saveUserAlertPreferences(user, {
            breakingAlerts: true,
            weeklyDigest: true,
            allServices: true,
          });
        }
      } catch (err) {
        console.error('Failed to sign in', err);
      }
    });

    saveBtn?.addEventListener('click', async () => {
      if (!currentUser) return;
      const watched: string[] = [];
      serviceCheckboxes.forEach((cb) => {
        if (cb.checked) watched.push(cb.value);
      });

      const updatedPrefs = {
        breakingAlerts: prefBreaking?.checked ?? true,
        weeklyDigest: prefWeekly?.checked ?? true,
        allServices: scopeAll?.checked ?? true,
        watchedServices: watched,
      };

      if (saveBtnText) saveBtnText.textContent = 'Saving...';
      try {
        await saveUserAlertPreferences(currentUser, updatedPrefs);
        if (saveBtnText) saveBtnText.textContent = 'Preferences Saved! ✓';
        setTimeout(() => {
          if (saveBtnText) saveBtnText.textContent = 'Save Preferences';
          closeModal();
        }, 1200);
      } catch (err) {
        console.error('Save failed', err);
        if (saveBtnText) saveBtnText.textContent = 'Save Failed. Retry';
      }
    });

    turnOffBtn?.addEventListener('click', async () => {
      if (!currentUser) return;
      if (prefBreaking) prefBreaking.checked = false;
      if (prefWeekly) prefWeekly.checked = false;
      await saveUserAlertPreferences(currentUser, {
        breakingAlerts: false,
        weeklyDigest: false,
      });
      if (saveBtnText) saveBtnText.textContent = 'Alerts Disabled ✓';
      setTimeout(() => {
        if (saveBtnText) saveBtnText.textContent = 'Save Preferences';
        closeModal();
      }, 1000);
    });
  }

  initAlertsModal();
  document.addEventListener('astro:page-load', initAlertsModal);
</script>

<style>
  .alerts-modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1200;
    padding: 16px;
  }

  .alerts-modal {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 520px;
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .alerts-modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 16px;
  }

  .header-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .alerts-icon-badge {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    border: 1px solid var(--google-blue-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .modal-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 2px 0;
  }

  .modal-subtitle {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .close-modal-btn {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .close-modal-btn:hover {
    color: var(--text-primary);
  }

  /* Logged Out View */
  .alerts-logged-out-state {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .benefits-card {
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .benefit-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .benefit-icon {
    font-size: 18px;
    line-height: 1;
    margin-top: 2px;
  }

  .benefit-row strong {
    font-size: 13.5px;
    color: var(--text-primary);
    display: block;
    margin-bottom: 2px;
  }

  .benefit-row p {
    font-size: 12.5px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }

  .google-auth-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    background-color: #ffffff;
    color: #3c4043;
    border: 1px solid #dadce0;
    border-radius: var(--radius-md);
    padding: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .google-auth-btn:hover {
    background-color: #f8f9fa;
    box-shadow: 0 1px 3px rgba(60, 64, 67, 0.3);
  }

  /* Logged In View */
  .alerts-logged-in-state {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .user-profile-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 10px 14px;
  }

  .alerts-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid var(--google-blue);
    object-fit: cover;
  }

  .user-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .user-meta strong {
    font-size: 13.5px;
    color: var(--text-primary);
  }

  .user-email-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-tertiary);
  }

  .verified-badge {
    font-size: 10px;
    font-weight: 700;
    color: var(--google-green);
    background-color: rgba(52, 168, 83, 0.12);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .pref-options-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pref-toggle-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    cursor: pointer;
    gap: 14px;
    transition: border-color 0.15s ease;
  }

  .pref-toggle-card:hover {
    border-color: var(--border-strong);
  }

  .pref-card-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pref-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pref-title-row strong {
    font-size: 13.5px;
    color: var(--text-primary);
  }

  .recommended-pill {
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    border: 1px solid var(--google-blue-border);
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.4px;
  }

  .pref-card-info p {
    font-size: 12px;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.35;
  }

  .toggle-checkbox {
    width: 18px;
    height: 18px;
    accent-color: var(--google-blue);
    cursor: pointer;
    flex-shrink: 0;
  }

  /* Scope */
  .scope-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 14px;
  }

  .scope-header-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-tertiary);
  }

  .scope-radios {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .scope-radio-option {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-primary);
    cursor: pointer;
  }

  .scope-radio-option input {
    accent-color: var(--google-blue);
    cursor: pointer;
  }

  .custom-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 6px;
    max-height: 140px;
    overflow-y: auto;
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px;
    margin-top: 4px;
  }

  .service-checkbox-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--text-secondary);
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .service-checkbox-item input {
    accent-color: var(--google-blue);
  }

  .service-pick-name {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Footer Actions */
  .modal-footer-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 10px;
    border-top: 1px solid var(--border-subtle);
  }

  .save-prefs-btn {
    width: 100%;
    background-color: var(--google-blue);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-md);
    padding: 10px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .save-prefs-btn:hover {
    background-color: #1557b0;
  }

  .unsubscribe-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    font-size: 11.5px;
    cursor: pointer;
    text-align: center;
    padding: 4px;
    transition: color 0.15s ease;
  }

  .unsubscribe-btn:hover {
    color: var(--google-red);
    text-decoration: underline;
  }
</style>
