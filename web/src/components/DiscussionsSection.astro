---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<section class="discussions-section" data-slug={slug} id="comments">
  <div class="discussions-header">
    <div class="discussions-title-group">
      <h2 class="discussions-title">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>Developer Discussion</span>
      </h2>
      <span class="comments-count" id="commentsCount">0 comments</span>
    </div>
    <span class="discussions-desc">Share feedback, workarounds, or implementation notes regarding this API change.</span>
  </div>

  <!-- Sign In Prompt / Comment Box -->
  <div class="comment-box-card">
    <div class="logged-out-state" id="authLoggedOut">
      <div class="auth-prompt-content">
        <div class="auth-icon-circle">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        </div>
        <div class="auth-prompt-text">
          <strong>Join the Discussion</strong>
          <span>Sign in with your Google account to post comments and coordinate with GCP engineers.</span>
        </div>
      </div>
      <button class="google-signin-btn" id="discussionSignInBtn" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Sign in with Google</span>
      </button>
    </div>

    <div class="logged-in-state" id="authLoggedIn" style="display: none;">
      <div class="comment-author-bar">
        <img class="user-avatar" id="currentUserAvatar" src="" alt="User avatar" />
        <span class="user-name" id="currentUserName">Google User</span>
      </div>
      <form id="commentForm" class="comment-form">
        <textarea
          id="commentInput"
          class="comment-textarea"
          placeholder="Add a comment or share how your team is handling this change..."
          rows="3"
          required
        ></textarea>
        <div class="form-bottom">
          <span class="form-hint">Markdown supported • Be respectful and constructive</span>
          <button type="submit" class="submit-comment-btn" id="submitCommentBtn">Post Comment</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Comments List -->
  <div class="comments-list" id="commentsList">
    <div class="no-comments-state" id="noCommentsMsg">
      <span>No discussions yet. Be the first GCP engineer to leave a comment!</span>
    </div>
  </div>
</section>

<script>
  import { getFirebaseAuth, signInWithGoogle, onAuthChange } from '../lib/firebase';

  function initDiscussions() {
    const section = document.querySelector('.discussions-section') as HTMLElement;
    if (!section) return;

    const slug = section.dataset.slug;
    if (!slug) return;

    const authLoggedOut = document.getElementById('authLoggedOut');
    const authLoggedIn = document.getElementById('authLoggedIn');
    const signInBtn = document.getElementById('discussionSignInBtn');
    const userAvatar = document.getElementById('currentUserAvatar') as HTMLImageElement;
    const userName = document.getElementById('currentUserName');
    const commentForm = document.getElementById('commentForm');
    const commentInput = document.getElementById('commentInput') as HTMLTextAreaElement;
    const commentsList = document.getElementById('commentsList');
    const commentsCount = document.getElementById('commentsCount');
    const noCommentsMsg = document.getElementById('noCommentsMsg');

    let currentUser: any = null;
    const storageKey = `gcp_radar_comments_${slug}`;

    // Load comments from localStorage
    function loadComments() {
      let comments = [];
      try {
        comments = JSON.parse(localStorage.getItem(storageKey) || '[]');
      } catch {}

      if (commentsCount) {
        commentsCount.textContent = `${comments.length} comment${comments.length === 1 ? '' : 's'}`;
      }

      if (noCommentsMsg) {
        noCommentsMsg.style.display = comments.length === 0 ? 'block' : 'none';
      }

      // Render comments
      const commentCards = comments.map((c: any) => `
        <div class="comment-card" id="comment-${c.id}">
          <div class="comment-top">
            <div class="comment-author-info">
              <div class="comment-avatar-circle">
                ${c.authorPhoto ? `<img src="${c.authorPhoto}" alt="${c.authorName}" class="author-img"/>` : c.authorName.charAt(0).toUpperCase()}
              </div>
              <div class="author-details">
                <span class="author-display-name">${c.authorName}</span>
                <time class="comment-time">${new Date(c.createdAt).toLocaleDateString()} ${new Date(c.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</time>
              </div>
            </div>
            ${currentUser && currentUser.uid === c.authorId ? `
              <button class="delete-comment-btn" data-comment-id="${c.id}" title="Delete comment">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            ` : ''}
          </div>
          <div class="comment-body">${c.content.replace(/\n/g, '<br/>')}</div>
        </div>
      `).join('');

      if (commentsList) {
        commentsList.innerHTML = comments.length > 0 ? commentCards : '<div class="no-comments-state">No discussions yet. Be the first GCP engineer to leave a comment!</div>';

        // Attach delete listeners
        commentsList.querySelectorAll('.delete-comment-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const commentId = btn.getAttribute('data-comment-id');
            deleteComment(commentId);
          });
        });
      }
    }

    function addComment(text: string) {
      if (!currentUser || !text.trim()) return;

      let comments = [];
      try {
        comments = JSON.parse(localStorage.getItem(storageKey) || '[]');
      } catch {}

      const newComment = {
        id: `c_${Date.now()}`,
        authorId: currentUser.uid,
        authorName: currentUser.displayName || 'Google Engineer',
        authorPhoto: currentUser.photoURL || '',
        content: text.trim(),
        createdAt: new Date().toISOString(),
      };

      comments.unshift(newComment);
      localStorage.setItem(storageKey, JSON.stringify(comments));
      loadComments();
    }

    function deleteComment(commentId: string | null) {
      if (!commentId) return;
      let comments = [];
      try {
        comments = JSON.parse(localStorage.getItem(storageKey) || '[]');
      } catch {}
      comments = comments.filter((c: any) => c.id !== commentId);
      localStorage.setItem(storageKey, JSON.stringify(comments));
      loadComments();
    }

    signInBtn?.addEventListener('click', async () => {
      try {
        await signInWithGoogle();
      } catch (err) {
        console.error('Sign in failed:', err);
      }
    });

    commentForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (commentInput.value.trim()) {
        addComment(commentInput.value);
        commentInput.value = '';
      }
    });

    onAuthChange((user) => {
      currentUser = user;
      if (user) {
        if (authLoggedOut) authLoggedOut.style.display = 'none';
        if (authLoggedIn) authLoggedIn.style.display = 'block';
        if (userAvatar) userAvatar.src = user.photoURL || 'https://www.gstatic.com/images/branding/product/2x/avatar_square_blue_512dp.png';
        if (userName) userName.textContent = user.displayName || user.email || 'Google User';
      } else {
        if (authLoggedOut) authLoggedOut.style.display = 'flex';
        if (authLoggedIn) authLoggedIn.style.display = 'none';
      }
      loadComments();
    });

    loadComments();
  }

  initDiscussions();
  document.addEventListener('astro:page-load', initDiscussions);
</script>

<style>
  .discussions-section {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--border-subtle);
  }

  .discussions-header {
    margin-bottom: 20px;
  }

  .discussions-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
  }

  .discussions-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .comments-count {
    font-size: 12px;
    font-family: var(--font-mono);
    color: var(--google-blue);
    background-color: var(--google-blue-subtle);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  .discussions-desc {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .comment-box-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 24px;
  }

  .logged-out-state {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .auth-prompt-content {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .auth-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .auth-prompt-text strong {
    display: block;
    font-size: 14px;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .auth-prompt-text span {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .google-signin-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background-color: #ffffff;
    color: #3c4043;
    border: 1px solid #dadce0;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 1px 2px rgba(60,64,67,0.1);
  }

  .google-signin-btn:hover {
    background-color: #f8f9fa;
    border-color: #bdc1c6;
    box-shadow: 0 1px 3px rgba(60,64,67,0.2);
  }

  .comment-author-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
  }

  .user-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .comment-textarea {
    width: 100%;
    background-color: var(--bg-page);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 12px;
    font-family: inherit;
    font-size: 14px;
    color: var(--text-primary);
    resize: vertical;
    outline: none;
    transition: border-color 0.15s ease;
    box-sizing: border-box;
  }

  .comment-textarea:focus {
    border-color: var(--google-blue);
    background-color: var(--bg-surface);
  }

  .form-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    flex-wrap: wrap;
    gap: 8px;
  }

  .form-hint {
    font-size: 12px;
    color: var(--text-tertiary);
  }

  .submit-comment-btn {
    background-color: var(--google-blue);
    color: #ffffff;
    border: none;
    padding: 8px 18px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .submit-comment-btn:hover {
    background-color: var(--google-blue-hover);
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .no-comments-state {
    text-align: center;
    padding: 32px 16px;
    color: var(--text-tertiary);
    font-size: 13px;
    background-color: var(--bg-surface);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .comment-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px;
  }

  .comment-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .comment-author-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .comment-avatar-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    overflow: hidden;
  }

  .author-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-display-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .comment-time {
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .delete-comment-btn {
    background: none;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 4px;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .delete-comment-btn:hover {
    color: var(--google-red);
  }

  .comment-body {
    font-size: 14px;
    color: var(--text-primary);
    line-height: 1.5;
  }
</style>
