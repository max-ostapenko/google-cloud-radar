---
import type { FeedEntry } from '../lib/feed';

interface Props {
  entry: FeedEntry;
}

const { entry } = Astro.props;

// Date formatting
const formattedDate = new Date(entry.date + 'T00:00:00Z').toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
// Reactions & Community Signals (progressive disclosure: counts hidden when 0)
const likeChangeCount = entry.reaction_counts?.like_change ?? 0;
const releasedCount = entry.reaction_counts?.released ?? 0;
const fpCount = entry.reaction_counts?.false_positive_or_duplicate ?? 0;
---

<article 
  class={`change-card ${entry.breaking ? 'is-breaking' : ''}`}
  data-slug={entry.slug}
  data-service={entry.service.toLowerCase()}
  data-api={entry.api.toLowerCase()}
  data-category={entry.category.toLowerCase()}
  data-breaking={entry.breaking ? 'true' : 'false'}
  data-impact={entry.impact}
  data-score={entry.interesting_score}
  data-text={`${entry.title} ${entry.summary} ${entry.api} ${entry.service} ${entry.tags.join(' ')}`.toLowerCase()}
>
  <div class="card-top">
    <div class="card-meta-left">
      <a href={`/services/${entry.service.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="service-pill" title={`View all ${entry.service} updates`}>
        <span class="service-icon-dot"></span>
        <span class="service-name">{entry.service}</span>
      </a>
      <span class="api-code" title="Discovery API Identifier">`{entry.api}`</span>
      <span class="meta-separator">•</span>
      <time datetime={entry.date} class="entry-date">{formattedDate}</time>
    </div>

    <div class="card-meta-right">
      {entry.status === 'released' && (
        <span class="badge badge-released" title={`Confirmed in official release notes${entry.lead_time_days ? ` (Caught ${entry.lead_time_days} days earlier in Canary)` : ''}`}>
          <span class="status-dot-green"></span> Released {entry.lead_time_days ? `(${entry.lead_time_days}d lead)` : ''}
        </span>
      )}

      {entry.breaking ? (
        <span class="badge badge-breaking" title="This update contains breaking API changes">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
            <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
          </svg>
          Breaking
        </span>
      ) : entry.impact === 'high' ? (
        <span class="badge badge-impact-high" title="High impact API change">
          High Impact
        </span>
      ) : entry.impact === 'medium' ? (
        <span class="badge badge-impact-medium" title="Medium impact API change">
          Medium Impact
        </span>
      ) : null}
    </div>
  </div>

  <h3 class="card-title">
    <a href={`/changes/${entry.slug}`} class="title-link">
      {entry.title}
    </a>
  </h3>

  {entry.summary && (
    <p class="card-summary">{entry.summary}</p>
  )}

  {entry.extractedMethods && entry.extractedMethods.length > 0 && (
    <div class="methods-section">
      <span class="methods-label">Methods / Resources:</span>
      <div class="methods-list">
        {entry.extractedMethods.map((method) => (
          <div class="method-chip" title="Click to copy method">
            <span class="method-rpc-tag">RPC</span>
            <code class="method-name">{method}</code>
            <button class="copy-method-btn" data-copy={method} aria-label="Copy method identifier" title="Copy method">
              <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
  )}

  {entry.tags && entry.tags.length > 0 && (
    <div class="card-tags">
      {entry.tags.map((tag) => (
        <span class="tag-chip">#{tag}</span>
      ))}
    </div>
  )}

  <div class="card-social-bar" data-slug={entry.slug}>
    <div class="card-reactions-group">
      <button 
        class={`card-reaction-btn ${likeChangeCount > 0 ? 'has-count' : ''}`}
        data-type="like_change" 
        data-slug={entry.slug}
        title="Like the change"
        type="button"
      >
        <span class="reaction-icon">👍</span>
        <span class="reaction-label">Like</span>
        <span class="reaction-count" data-count-type="like_change" style={likeChangeCount > 0 ? '' : 'display: none;'}>{likeChangeCount}</span>
      </button>

      <button 
        class={`card-reaction-btn ${releasedCount > 0 ? 'has-count' : ''}`}
        data-type="released" 
        data-slug={entry.slug}
        title="Mark as Released in official notes/docs"
        type="button"
      >
        <span class="reaction-icon">🚀</span>
        <span class="reaction-label">Released</span>
        <span class="reaction-count" data-count-type="released" style={releasedCount > 0 ? '' : 'display: none;'}>{releasedCount}</span>
      </button>

      <button 
        class={`card-reaction-btn ${fpCount > 0 ? 'has-count' : ''}`}
        data-type="false_positive_or_duplicate" 
        data-slug={entry.slug}
        title="Flag as false-positive or duplicate"
        type="button"
      >
        <span class="reaction-icon">🚩</span>
        <span class="reaction-label">Noise / FP</span>
        <span class="reaction-count" data-count-type="false_positive_or_duplicate" style={fpCount > 0 ? '' : 'display: none;'}>{fpCount}</span>
      </button>
    </div>

    <div class="card-actions-right">
      <a href={`/changes/${entry.slug}#discussion`} class="card-discussion-link" title="View discussion and comments">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span class="discussion-label">Comments</span>
        <span class="discussion-count" data-slug={entry.slug}>{entry.comments_count || 0}</span>
      </a>

      <button
        type="button"
        class="card-share-trigger-btn"
        data-share-slug={entry.slug}
        data-share-title={entry.title}
        data-share-service={entry.service}
        data-share-api={entry.api}
        data-share-summary={entry.summary}
        data-share-methods={JSON.stringify(entry.extractedMethods || [])}
        data-share-breaking={entry.breaking ? 'true' : 'false'}
        title="Share this API update on Twitter/X, LinkedIn, Slack, or Reddit"
        aria-label="Share API Update"
      >
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
          <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
        </svg>
        <span>Share</span>
      </button>

      <a href={`/changes/${entry.slug}`} class="details-cta">
        <span>View Diff</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .change-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 16px;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .change-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .change-card.is-breaking {
    border-color: var(--google-red-border);
  }

  .change-card.is-breaking:hover {
    border-color: var(--google-red);
    box-shadow: 0 1px 3px 0 rgba(217, 48, 37, 0.2), 0 4px 12px 2px rgba(217, 48, 37, 0.1);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  .card-meta-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .service-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--google-blue-border);
    text-decoration: none;
  }

  .service-pill:hover {
    background-color: var(--google-blue);
    color: #ffffff;
    text-decoration: none;
  }

  .service-icon-dot {
    width: 6px;
    height: 6px;
    background-color: currentColor;
    border-radius: 50%;
  }

  .api-code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    background-color: var(--bg-surface-hover);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .meta-separator {
    color: var(--text-tertiary);
    font-size: 10px;
  }

  .entry-date {
    font-size: 12px;
    color: var(--text-tertiary);
  }

  .card-meta-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .card-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 8px;
  }

  .title-link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--google-blue);
    text-decoration: underline;
  }

  .card-summary {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 14px;
  }

  .methods-section {
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .methods-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .methods-list {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .method-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 12px;
  }

  .method-rpc-tag {
    font-size: 9px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-purple);
    background-color: var(--google-purple-subtle);
    padding: 1px 4px;
    border-radius: 2px;
  }

  .method-name {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .copy-method-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-tertiary);
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
  }

  .copy-method-btn:hover {
    color: var(--google-blue);
    background-color: var(--bg-surface-hover);
  }

  .card-tags {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .tag-chip {
    font-size: 11px;
    color: var(--text-tertiary);
    background-color: var(--bg-surface-hover);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .card-social-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 12px;
  }

  .card-reactions-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .card-reaction-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11.5px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-tertiary);
    background-color: transparent;
    border: 1px solid transparent;
    padding: 3px 7px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .card-reaction-btn:hover {
    background-color: var(--bg-surface-hover);
    border-color: var(--border-subtle);
    color: var(--text-primary);
  }

  .card-reaction-btn.has-count,
  .card-reaction-btn.active {
    background-color: var(--bg-surface);
    border-color: var(--border-subtle);
    color: var(--text-secondary);
  }

  .card-reaction-btn.active,
  .card-reaction-btn[data-type="like_change"].active {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue-border);
    color: var(--google-blue);
    font-weight: 600;
  }

  .card-reaction-btn[data-type="released"].active {
    background-color: var(--google-green-subtle);
    border-color: var(--google-green-border);
    color: var(--google-green);
    font-weight: 600;
  }

  .card-reaction-btn[data-type="false_positive_or_duplicate"].active {
    background-color: var(--google-red-subtle);
    border-color: var(--google-red-border);
    color: var(--google-red);
    font-weight: 600;
  }

  .reaction-icon {
    font-size: 12px;
    line-height: 1;
  }

  .reaction-label {
    font-size: 11px;
  }

  .reaction-count {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    background-color: var(--bg-surface-hover);
    padding: 1px 5px;
    border-radius: 3px;
    border: 1px solid var(--border-subtle);
  }

  .card-reaction-btn.active .reaction-count,
  .card-reaction-btn[data-type="like_change"].active .reaction-count {
    background-color: #ffffff;
    border-color: var(--google-blue-border);
    color: var(--google-blue);
  }

  .card-reaction-btn[data-type="released"].active .reaction-count {
    background-color: #ffffff;
    border-color: var(--google-green-border);
    color: var(--google-green);
  }

  .card-reaction-btn[data-type="false_positive_or_duplicate"].active .reaction-count {
    background-color: #ffffff;
    border-color: var(--google-red-border);
    color: var(--google-red);
  }

  .card-actions-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .card-share-trigger-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .card-share-trigger-btn:hover {
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    border-color: var(--google-blue-border);
  }

  .card-discussion-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .card-discussion-link:hover {
    background-color: var(--bg-surface-hover);
    color: var(--text-primary);
    border-color: var(--border-strong);
    text-decoration: none;
  }

  .discussion-count {
    font-size: 11px;
    font-family: var(--font-mono);
    background-color: var(--border-subtle);
    color: var(--text-primary);
    padding: 1px 6px;
    border-radius: 10px;
    font-weight: 700;
  }

  .details-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--google-blue);
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .details-cta:hover {
    gap: 10px;
    text-decoration: none;
  }
</style>

<script>
  import {
    $reactionsStore,
    $commentCounts,
    initReactionsForSlug,
    initCommentsForSlug,
    getSlugReactions,
    toggleReaction,
    autoCleanSubscribe,
  } from '../lib/store';
  import type { ReactionType } from '../lib/firebase';

  function initCardReactions() {
    autoCleanSubscribe(() => {
      const cards = document.querySelectorAll<HTMLElement>('.change-card');
      const unsubs: Array<() => void> = [];

      cards.forEach((card) => {
        const slug = card.getAttribute('data-slug');
        if (!slug) return;

        initReactionsForSlug(slug);
        initCommentsForSlug(slug);

        const buttons = card.querySelectorAll<HTMLButtonElement>('.card-reaction-btn');
        const commentBadge = card.querySelector<HTMLElement>(`.discussion-count[data-slug="${slug}"]`);

        // Subscribe to reactions store
        const unsubReactions = $reactionsStore.subscribe(() => {
          const state = getSlugReactions(slug);
          buttons.forEach((btn) => {
            const type = btn.getAttribute('data-type') as ReactionType;
            if (type) {
              const countBadge = btn.querySelector('.reaction-count') as HTMLElement;
              const val = state.counts[type] || 0;
              if (countBadge) {
                countBadge.textContent = String(val);
                countBadge.style.display = (val > 0 || state.userVotes[type]) ? 'inline-block' : 'none';
              }
              if (state.userVotes[type]) {
                btn.classList.add('active');
                btn.classList.add('has-count');
              } else {
                btn.classList.remove('active');
                if (val > 0) btn.classList.add('has-count');
                else btn.classList.remove('has-count');
              }
            }
          });
        });

        unsubs.push(unsubReactions);

        // Subscribe to comment counts
        const unsubComments = $commentCounts.subscribe((counts) => {
          const count = counts[slug] ?? 0;
          if (commentBadge) {
            commentBadge.textContent = String(count);
          }
        });

        unsubs.push(unsubComments);

        // Button click handlers
        buttons.forEach((btn) => {
          const type = btn.getAttribute('data-type') as ReactionType;
          if (!type) return;

          const handleBtnClick = async (e: MouseEvent) => {
            e.preventDefault();
            e.stopPropagation();
            await toggleReaction(slug, type);
          };

          btn.addEventListener('click', handleBtnClick);
          unsubs.push(() => btn.removeEventListener('click', handleBtnClick));
        });
      });

      return unsubs;
    });
  }

  initCardReactions();
  document.addEventListener('astro:page-load', initCardReactions);
</script>
