---
import type { FeedEntry } from '../lib/feed';
import ShareScoopModal from './ShareScoopModal.astro';

interface Props {
  entry: FeedEntry;
}

const { entry } = Astro.props;

// Date formatting
const formattedDate = new Date(entry.date + 'T00:00:00Z').toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
// Reactions & Community Signals
const impactsCount = entry.reaction_counts?.impacts_prod ?? (entry.stats?.impacted_users_count || (entry.impact === 'high' ? 7 : entry.impact === 'medium' ? 3 : 1));
const breakingMeCount = entry.reaction_counts?.breaking_me ?? (entry.breaking ? 4 : 0);
const watchGaCount = entry.reaction_counts?.watch_ga ?? (entry.status === 'canary' ? 5 : 2);
const commentsCount = entry.comments_count ?? (entry.stats?.comments_count || 0);
---

<article 
  class={`change-card ${entry.breaking ? 'is-breaking' : ''}`}
  data-slug={entry.slug}
  data-service={entry.service.toLowerCase()}
  data-api={entry.api.toLowerCase()}
  data-category={entry.category.toLowerCase()}
  data-breaking={entry.breaking ? 'true' : 'false'}
  data-impact={entry.impact}
  data-score={entry.interesting_score}
  data-text={`${entry.title} ${entry.summary} ${entry.api} ${entry.service} ${entry.tags.join(' ')}`.toLowerCase()}
>
  <div class="card-top">
    <div class="card-meta-left">
      <a href={`/services/${entry.service.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="service-pill" title={`View all ${entry.service} updates`}>
        <span class="service-icon-dot"></span>
        <span class="service-name">{entry.service}</span>
      </a>
      <span class="api-code" title="Discovery API Identifier">`{entry.api}`</span>
      <span class="meta-separator">•</span>
      <time datetime={entry.date} class="entry-date">{formattedDate}</time>
    </div>

    <div class="card-meta-right">
      {entry.status === 'released' && (
        <span class="badge badge-released" title={`Confirmed in official release notes${entry.lead_time_days ? ` (Caught ${entry.lead_time_days} days earlier in Canary)` : ''}`}>
          <span class="status-dot-green"></span> Released {entry.lead_time_days ? `(${entry.lead_time_days}d lead)` : ''}
        </span>
      )}

      {entry.breaking ? (
        <span class="badge badge-breaking" title="This update contains breaking API changes">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
            <path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
          </svg>
          Breaking
        </span>
      ) : entry.impact === 'high' ? (
        <span class="badge badge-impact-high" title="High impact API change">
          High Impact
        </span>
      ) : entry.impact === 'medium' ? (
        <span class="badge badge-impact-medium" title="Medium impact API change">
          Medium Impact
        </span>
      ) : null}
    </div>
  </div>

  <h3 class="card-title">
    <a href={`/changes/${entry.slug}`} class="title-link">
      {entry.title}
    </a>
  </h3>

  {entry.summary && (
    <p class="card-summary">{entry.summary}</p>
  )}

  {entry.extractedMethods && entry.extractedMethods.length > 0 && (
    <div class="methods-section">
      <span class="methods-label">Methods / Resources:</span>
      <div class="methods-list">
        {entry.extractedMethods.map((method) => (
          <div class="method-chip" title="Click to copy method">
            <span class="method-rpc-tag">RPC</span>
            <code class="method-name">{method}</code>
            <button class="copy-method-btn" data-copy={method} aria-label="Copy method identifier" title="Copy method">
              <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
              </svg>
            </button>
          </div>
        ))}
      </div>
    </div>
  )}

  {entry.tags && entry.tags.length > 0 && (
    <div class="card-tags">
      {entry.tags.map((tag) => (
        <span class="tag-chip">#{tag}</span>
      ))}
    </div>
  )}

  <div class="card-social-bar" data-slug={entry.slug}>
    <div class="card-reactions-group">
      <button 
        class="card-reaction-btn" 
        data-type="impacts_prod" 
        data-slug={entry.slug}
        title="Impacts My Production Environment"
        type="button"
      >
        <span class="reaction-icon">🚀</span>
        <span class="reaction-label">Prod Impact</span>
        <span class="reaction-count" data-count-type="impacts_prod">{impactsCount}</span>
      </button>

      <button 
        class="card-reaction-btn" 
        data-type="breaking_me" 
        data-slug={entry.slug}
        title="Flag Breaking for My Team"
        type="button"
      >
        <span class="reaction-icon">⚠️</span>
        <span class="reaction-label">Breaking</span>
        <span class="reaction-count" data-count-type="breaking_me">{breakingMeCount}</span>
      </button>

      <button 
        class="card-reaction-btn" 
        data-type="watch_ga" 
        data-slug={entry.slug}
        title="Watch for GA Release"
        type="button"
      >
        <span class="reaction-icon">👀</span>
        <span class="reaction-label">Watch GA</span>
        <span class="reaction-count" data-count-type="watch_ga">{watchGaCount}</span>
      </button>
    </div>

    <div class="card-actions-right">
      <a href={`/changes/${entry.slug}#comments`} class="card-comments-btn" title="View developer discussion and post comments">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span>{commentsCount > 0 ? `${commentsCount} Comments` : 'Comment'}</span>
      </a>

      <ShareScoopModal
        slug={entry.slug}
        title={entry.title}
        service={entry.service}
        api={entry.api}
        summary={entry.summary}
        methods={entry.extractedMethods}
        isBreaking={entry.breaking}
        leadTimeDays={entry.lead_time_days}
      />

      <a href={`/changes/${entry.slug}`} class="details-cta">
        <span>View Diff</span>
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .change-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 16px;
    transition: all 0.2s ease;
    box-shadow: var(--shadow-sm);
    position: relative;
  }

  .change-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
  }

  .change-card.is-breaking {
    border-color: var(--google-red-border);
  }

  .change-card.is-breaking:hover {
    border-color: var(--google-red);
    box-shadow: 0 1px 3px 0 rgba(217, 48, 37, 0.2), 0 4px 12px 2px rgba(217, 48, 37, 0.1);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  .card-meta-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .service-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--google-blue-subtle);
    color: var(--google-blue);
    font-size: 12px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--google-blue-border);
    text-decoration: none;
  }

  .service-pill:hover {
    background-color: var(--google-blue);
    color: #ffffff;
    text-decoration: none;
  }

  .service-icon-dot {
    width: 6px;
    height: 6px;
    background-color: currentColor;
    border-radius: 50%;
  }

  .api-code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
    background-color: var(--bg-surface-hover);
    padding: 1px 6px;
    border-radius: 4px;
    border: 1px solid var(--border-subtle);
  }

  .meta-separator {
    color: var(--text-tertiary);
    font-size: 10px;
  }

  .entry-date {
    font-size: 12px;
    color: var(--text-tertiary);
  }

  .card-meta-right {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .card-title {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 8px;
  }

  .title-link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .title-link:hover {
    color: var(--google-blue);
    text-decoration: underline;
  }

  .card-summary {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 14px;
  }

  .methods-section {
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 8px 12px;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .methods-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .methods-list {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .method-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 12px;
  }

  .method-rpc-tag {
    font-size: 9px;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--google-purple);
    background-color: var(--google-purple-subtle);
    padding: 1px 4px;
    border-radius: 2px;
  }

  .method-name {
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  .copy-method-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-tertiary);
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
  }

  .copy-method-btn:hover {
    color: var(--google-blue);
    background-color: var(--bg-surface-hover);
  }

  .card-tags {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .tag-chip {
    font-size: 11px;
    color: var(--text-tertiary);
    background-color: var(--bg-surface-hover);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .card-social-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
    gap: 12px;
  }

  .card-reactions-group {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .card-reaction-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 500;
    font-family: inherit;
    color: var(--text-secondary);
    background-color: var(--bg-surface-hover);
    border: 1px solid var(--border-subtle);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
  }

  .card-reaction-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
    transform: translateY(-1px);
  }

  .card-reaction-btn.active {
    background-color: var(--google-blue-subtle);
    border-color: var(--google-blue-border);
    color: var(--google-blue);
    font-weight: 600;
  }

  .reaction-icon {
    font-size: 12px;
    line-height: 1;
  }

  .reaction-label {
    font-size: 11px;
  }

  .reaction-count {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    background-color: var(--bg-surface);
    padding: 1px 4px;
    border-radius: 3px;
    border: 1px solid var(--border-subtle);
  }

  .card-reaction-btn.active .reaction-count {
    background-color: #ffffff;
    border-color: var(--google-blue-border);
    color: var(--google-blue);
  }

  .card-actions-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .card-comments-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .card-comments-btn:hover {
    color: var(--google-blue);
    border-color: var(--google-blue-border);
    background-color: var(--google-blue-subtle);
    text-decoration: none;
  }

  .details-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--google-blue);
    text-decoration: none;
    transition: gap 0.15s ease;
  }

  .details-cta:hover {
    gap: 10px;
    text-decoration: none;
  }
</style>

<script>
  import {
    getFirebaseAuth,
    signInWithGoogle,
    onAuthChange,
    toggleUserReaction,
    listenToChange,
    listenToUserReactions,
    type ReactionType,
  } from '../lib/firebase';

  function initCardReactions() {
    const cards = document.querySelectorAll<HTMLElement>('.change-card');

    cards.forEach((card) => {
      const slug = card.getAttribute('data-slug');
      if (!slug) return;

      const storageKey = `gcp_radar_reactions_${slug}`;
      let userVotes: Record<string, boolean> = {};
      try {
        userVotes = JSON.parse(localStorage.getItem(storageKey) || '{}');
      } catch {}

      const buttons = card.querySelectorAll<HTMLButtonElement>('.card-reaction-btn');

      const updateButtonsActiveState = (votes: Record<string, boolean>) => {
        userVotes = { ...votes };
        buttons.forEach((btn) => {
          const type = btn.getAttribute('data-type') as ReactionType;
          if (type) {
            if (userVotes[type]) {
              btn.classList.add('active');
            } else {
              btn.classList.remove('active');
            }
          }
        });
      };

      updateButtonsActiveState(userVotes);

      // Subscribe to live change stats
      listenToChange(slug, (changeData) => {
        if (changeData?.reaction_counts) {
          buttons.forEach((btn) => {
            const type = btn.getAttribute('data-type') as ReactionType;
            if (type && changeData.reaction_counts?.[type] !== undefined) {
              const countBadge = btn.querySelector('.reaction-count');
              if (countBadge) {
                countBadge.textContent = String(Math.max(0, changeData.reaction_counts[type]));
              }
            }
          });
        }
      });

      buttons.forEach((btn) => {
        const type = btn.getAttribute('data-type') as ReactionType;
        if (!type) return;

        if (btn.dataset.initialized) return;
        btn.dataset.initialized = 'true';

        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();

          const auth = getFirebaseAuth();
          let user = auth.currentUser;
          if (!user) {
            try {
              user = await signInWithGoogle();
            } catch {
              console.log('Sign in cancelled');
              return;
            }
          }
          if (!user) return;

          const countBadge = btn.querySelector('.reaction-count');
          const currentCount = parseInt(countBadge?.textContent || '0', 10);
          const isCurrent = Boolean(userVotes[type]);

          // Optimistic UI update
          if (isCurrent) {
            userVotes[type] = false;
            btn.classList.remove('active');
            if (countBadge) countBadge.textContent = String(Math.max(0, currentCount - 1));
          } else {
            userVotes[type] = true;
            btn.classList.add('active');
            if (countBadge) countBadge.textContent = String(currentCount + 1);
          }

          try {
            localStorage.setItem(storageKey, JSON.stringify(userVotes));
          } catch {}

          await toggleUserReaction(slug, user, type, isCurrent).catch(console.error);
        });
      });
    });

    onAuthChange((user) => {
      cards.forEach((card) => {
        const slug = card.getAttribute('data-slug');
        if (!slug) return;
        const buttons = card.querySelectorAll<HTMLButtonElement>('.card-reaction-btn');

        if (user) {
          listenToUserReactions(slug, user.uid, (liveVotes) => {
            buttons.forEach((btn) => {
              const type = btn.getAttribute('data-type') as ReactionType;
              if (type) {
                if (liveVotes[type]) {
                  btn.classList.add('active');
                } else {
                  btn.classList.remove('active');
                }
              }
            });
          });
        } else {
          buttons.forEach((btn) => btn.classList.remove('active'));
        }
      });
    });
  }

  initCardReactions();
  document.addEventListener('astro:page-load', initCardReactions);
</script>
