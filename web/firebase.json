{
  "hosting": {
    "site": "gcp-cloud-radar",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/breaking",
        "destination": "/?impact=breaking",
        "type": 302
      },
      {
        "source": "/services/looker",
        "destination": "/services/looker-core",
        "type": 301
      },
      {
        "source": "/services/biglake-lakehouse-api*",
        "destination": "/services/biglake",
        "type": 301
      },
      {
        "source": "/services/application-integration-connectors",
        "destination": "/services/integration-connectors",
        "type": 301
      },
      {
        "source": "/services/application-integration-connectors/feed.json",
        "destination": "/services/integration-connectors/feed.json",
        "type": 301
      },
      {
        "source": "/services/google-drive",
        "destination": "/services/google-drive-api",
        "type": 301
      },
      {
        "source": "/services/google-drive/feed.json",
        "destination": "/services/google-drive-api/feed.json",
        "type": 301
      },
      {
        "source": "/services/admin-sdk-directory*",
        "destination": "/services/admin-sdk",
        "type": 301
      },
      {
        "source": "/services/youtube",
        "destination": "/services/youtube-data-api",
        "type": 301
      },
      {
        "source": "/services/vertex-ai-search-and-conversation*",
        "destination": "/services/vertex-ai-agent-builder",
        "type": 301
      },
      {
        "source": "/services/discovery-engine*",
        "destination": "/services/vertex-ai-agent-builder",
        "type": 301
      },
      {
        "source": "/services/google-play-android-developer-api*",
        "destination": "/services/android-publisher",
        "type": 301
      },
      {
        "source": "/services/photos-library*",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/changes/2026-08-30-aiplatform-v1*",
        "destination": "/services/vertex-ai",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(json|xml|txt)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=600"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
