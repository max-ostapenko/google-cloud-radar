rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // GCP API Changes: Public read-only; writes restricted to Admin SDK / backend pipeline
    match /changes/{changeId} {
      allow read: if true;
      allow write: if false; // Writes only permitted via Admin SDK
    }

    // Services Metadata: Public read-only
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    // Community Discussions / Comments
    match /discussions/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Community Impact Votes
    match /votes/{voteId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
