rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model & Security Schema
    // ===============================================================
    //
    // Collection: changes/{changeId}
    //   - reaction_counts: map of int (allowed keys: impacts_prod, breaking_me, watch_ga; delta <= 1)
    //   - comments_count: int (delta <= 1)
    //   - All core metadata fields (service_id, change_date, etc.) are immutable to clients.
    //
    // Subcollection: changes/{changeId}/reactions/{userId}
    //   - user_id: string (must match request.auth.uid)
    //   - impacts_prod, breaking_me, watch_ga: bool
    //   - updated_at: timestamp (enforced serverTimestamp and 1s cooldown)
    //
    // Subcollection: changes/{changeId}/comments/{commentId}
    //   - change_id: string (must match path)
    //   - author_id: string (must match request.auth.uid)
    //   - author_name: string (1-80 chars)
    //   - author_photo: optional string (<= 500 chars)
    //   - content: string (1-1000 chars)
    //   - created_at: timestamp (enforced serverTimestamp)
    //   - Immutable once posted; can only be deleted by author.
    //
    // Collection: users/{userId}
    //   - uid, email, displayName, photoURL, breakingAlerts, weeklyDigest, allServices, watchedServices
    //   - Private to document owner; strict payload size limits.
    //
    // Collection: services/{serviceId}
    //   - Public read-only; client writes forbidden.
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function absDiffAtMostOne(a, b) {
      let diff = a - b;
      return diff == 1 || diff == -1 || diff == 0;
    }

    function getCount(countsMap, key) {
      return (countsMap != null && (key in countsMap) && countsMap[key] is int) ? countsMap[key] : 0;
    }

    function singleReactionDelta(prev, curr, key) {
      let p = getCount(prev, key);
      let c = getCount(curr, key);
      return (c - p == 1 || c - p == -1) ? 1 : (c == p ? 0 : 99);
    }

    function isValidReactionCountsUpdate() {
      let prev = resource.data.reaction_counts;
      let curr = request.resource.data.reaction_counts;
      return curr is map &&
        curr.keys().hasOnly(['impacts_prod', 'breaking_me', 'watch_ga']) &&
        (!('impacts_prod' in curr) || (curr.impacts_prod is int && curr.impacts_prod >= 0)) &&
        (!('breaking_me' in curr) || (curr.breaking_me is int && curr.breaking_me >= 0)) &&
        (!('watch_ga' in curr) || (curr.watch_ga is int && curr.watch_ga >= 0)) &&
        // Exactly one reaction counter may change by at most 1 per request
        (singleReactionDelta(prev, curr, 'impacts_prod') +
         singleReactionDelta(prev, curr, 'breaking_me') +
         singleReactionDelta(prev, curr, 'watch_ga') <= 1);
    }

    function isValidCommentsCountUpdate() {
      let prevCount = ('comments_count' in resource.data && resource.data.comments_count is int) ? resource.data.comments_count : 0;
      let currCount = request.resource.data.comments_count;
      return currCount is int && currCount >= 0 && absDiffAtMostOne(currCount, prevCount);
    }

    function isValidReactionData() {
      let data = request.resource.data;
      return data.keys().hasOnly(['user_id', 'impacts_prod', 'breaking_me', 'watch_ga', 'updated_at']) &&
        data.user_id == request.auth.uid &&
        (!('impacts_prod' in data) || data.impacts_prod is bool) &&
        (!('breaking_me' in data) || data.breaking_me is bool) &&
        (!('watch_ga' in data) || data.watch_ga is bool) &&
        (!('updated_at' in data) || data.updated_at == request.time);
    }

    function isReactionRateLimited() {
      // 1 second cooldown per user per change to prevent bot click-flooding
      return !('updated_at' in resource.data) ||
        resource.data.updated_at == null ||
        request.time >= resource.data.updated_at + duration.value(1, 's');
    }

    function isValidCommentCreate(changeId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['change_id', 'author_id', 'author_name', 'author_photo', 'content', 'created_at']) &&
        data.author_id == request.auth.uid &&
        data.change_id == changeId &&
        data.content is string &&
        data.content.size() >= 1 &&
        data.content.size() <= 1000 &&
        data.author_name is string &&
        data.author_name.size() >= 1 &&
        data.author_name.size() <= 80 &&
        (!('author_photo' in data) || (data.author_photo is string && data.author_photo.size() <= 500)) &&
        data.created_at == request.time;
    }

    function isValidUserPreferences() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL',
          'breakingAlerts', 'weeklyDigest', 'allServices',
          'watchedServices', 'updated_at'
        ]) &&
        data.uid == request.auth.uid &&
        ('email' in request.auth.token) &&
        data.email == request.auth.token.email &&
        data.email is string &&
        data.email.size() <= 120 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('breakingAlerts' in data) || data.breakingAlerts is bool) &&
        (!('weeklyDigest' in data) || data.weeklyDigest is bool) &&
        (!('allServices' in data) || data.allServices is bool) &&
        (!('watchedServices' in data) || (data.watchedServices is list && data.watchedServices.size() <= 100)) &&
        (!('updated_at' in data) || data.updated_at == request.time);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Google Cloud Radar Changes: Public read-only; client updates strictly bounded
    match /changes/{changeId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction_counts', 'comments_count']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reaction_counts']) || isValidReactionCountsUpdate()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['comments_count']) || isValidCommentsCountUpdate());

      // Subcollection: Community Discussions / Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidCommentCreate(changeId);
        allow update: if false; // Immutable once posted to prevent payload inflation
        allow delete: if isAuthenticated() && resource.data.author_id == request.auth.uid;
      }

      // Subcollection: User Impact Reactions
      match /reactions/{userId} {
        allow read: if true;
        allow create: if isOwner(userId) && isValidReactionData();
        allow update: if isOwner(userId) && isValidReactionData() && isReactionRateLimited();
        allow delete: if isOwner(userId);
      }
    }

    // Service Hubs Metadata: Public read-only
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    // User Profiles and Alert Preferences (Strictly Private)
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserPreferences();
    }

    // Legacy Top-Level Collections (Decommissioned / Blocked)
    match /discussions/{commentId} {
      allow read, write: if false;
    }

    match /votes/{voteId} {
      allow read, write: if false;
    }
  }
}
