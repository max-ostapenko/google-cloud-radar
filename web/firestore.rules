rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Google Cloud Radar Changes: Public read-only; writes restricted to Admin SDK / backend pipeline
    // Authenticated users can only update aggregated reaction_counts
    match /changes/{changeId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.auth != null && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reaction_counts']);

      // Subcollection: Community Discussions / Comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && 
          request.resource.data.author_id == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 2000;
        allow update, delete: if request.auth != null && resource.data.author_id == request.auth.uid;
      }

      // Subcollection: User Impact Reactions
      match /reactions/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Service Hubs Metadata: Public read-only
    match /services/{serviceId} {
      allow read: if true;
      allow write: if false;
    }

    // Legacy Top-Level Collections (Backward Compatibility)
    match /discussions/{commentId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.author_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.author_id == request.auth.uid;
    }

    match /votes/{voteId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}
