{
  "id": "2026-10-08-dataplex-v1",
  "date": "2026-10-08",
  "api": "dataplex.v1",
  "service": "Dataplex",
  "title": "Dataplex removes Unstructured Data Profiling",
  "summary": "Dataplex has removed all API surface related to unstructured data profiling and graph profiling. This includes schema properties for data discovery, data scans, and detailed graph profile configurations. Developers using these experimental features must update their integrations.",
  "details": "The `GoogleCloudDataplexV1DataDiscoverySpecStorageConfig` schema no longer supports `unstructuredDataOptions`. The `GoogleCloudDataplexV1DataScan` and `GoogleCloudDataplexV1DataScanJob` schemas have removed `unstructuredDataProfileResult` and `unstructuredDataProfileSpec` properties, and the `UNSTRUCTURED_DATA_PROFILE` enum value has been removed from their `type` fields. Furthermore, all related schemas for `GoogleCloudDataplexV1GraphProfile`, `GoogleCloudDataplexV1GraphProfileEdgeType`, `GoogleCloudDataplexV1GraphProfileField`, and `GoogleCloudDataplexV1GraphProfileNodeType`, along with their nested properties, have been entirely removed. This indicates a complete retraction of the unstructured data profiling and graph profiling capabilities from the API. Any existing code or configurations relying on these features will break and must be updated.",
  "impact": "high",
  "breaking": true,
  "interesting_score": 9,
  "tags": [
    "breaking change",
    "data profiling",
    "AI/ML"
  ],
  "extracted_methods": [],
